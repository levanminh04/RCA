    if t_req + a.doi_t != t_m1: raise SystemExit('t của request (+ doi_t) khác t trong method-input')
    them['span_phu'] = bs.span_phu(jsonl([goc / 'cases' / a.id / 'raw-traces.jsonl']), t_m1)
