            tm = dem / f'moc.json.tam{a.ban.replace("/", "_")}'
            tm.write_bytes((json.dumps(moc, ensure_ascii=False) + '\n').encode('utf-8')); tm.replace(dem / 'moc.json')
        moc = dict(moc, tu_bo_dem=False)
