    tap = set(tap)
    if len(tap) == 1:
        return danh_gia.phan_bo_hang(blocks, next(iter(tap)))
    pos, i = 0, 0
    while i < len(blocks):
        j = i
        while j + 1 < len(blocks) and blocks[j + 1]['key'] == blocks[i]['key']:
            j += 1
        sg = blocks[i:j + 1]
        thanh_vien = [e for b in sg for g in b['groups'] for e in g]
        m = len(tap.intersection(thanh_vien))
        if m:
            if len(sg) != 1 or len(sg[0]['groups']) != 1:
                # Khối cùng khóa nhiều nhóm (TORAI) không xuất hiện ở M1; không đoán, báo lỗi để xử lý riêng.
                raise danh_gia.LoiBanGhi('tập chấp nhận rơi vào siêu khối nhiều nhóm: chưa hỗ trợ')
            g = len(thanh_vien)
            mau = comb(g, m)
            return {pos + q: Fraction(comb(g - q, m - 1), mau) for q in range(1, g - m + 2)}
        pos += len(thanh_vien)
        i = j + 1
    return {}


def cham_ca_loi(rec, tap):
    """Một ca có tiêm lỗi → {'p1','p3','hang_ky_vong','hang_cat','nhom_hang_1','status','trong_tra_ve'}."""
    ok = rec.get('status') == 'OK'
    dist = phan_bo_hang_tap(danh_gia.khoi_tu_ban_ghi(rec), tap) if ok else {}
    if not dist:
        return {'status': rec.get('status'), 'trong_tra_ve': False, 'p1': 0.0, 'p3': 0.0,
                'hang_ky_vong': None, 'hang_cat': float(CAT_HANG), 'nhom_hang_1': nhom_hang_1(rec) if ok else []}
    p1 = sum(p for r, p in dist.items() if r <= 1)
    p3 = sum(p for r, p in dist.items() if r <= 3)
    ev = sum(p * r for r, p in dist.items())
    ev_cat = sum(p * min(r, CAT_HANG) for r, p in dist.items())
    return {'status': 'OK', 'trong_tra_ve': True, 'p1': float(p1), 'p3': float(p3), 'hang_ky_vong': float(ev),
            'hang_cat': float(ev_cat), 'nhom_hang_1': nhom_hang_1(rec),
            'phan_bo': {str(r): str(p) for r, p in sorted(dist.items())}}


def nhom_hang_1(rec):
    blocks = danh_gia.khoi_tu_ban_ghi(rec)
    return [e for g in blocks[0]['groups'] for e in g] if blocks else []


def cham_ca_khong_loi(rec):
    """K đếm thô: mọi kết luận khác NO_INTRINSIC_ANOMALY (kể cả lỗi chạy) tính 1."""
    v = rec.get('verdict') if rec.get('status') == 'OK' else f"STATUS:{rec.get('status')}"
    return {'verdict': v, 'k': int(v != 'NO_INTRINSIC_ANOMALY')}


def tong_hop(ca_loi):
    """ca_loi: {ma: cham_ca_loi}. Trả AC@1, AC@3, tổng hạng kỳ vọng cắt 6."""
    v = list(ca_loi.values())
    return {'n': len(v), 'AC@1': sum(x['p1'] for x in v), 'AC@3': sum(x['p3'] for x in v),
            'tong_hang_cat': sum(x['hang_cat'] for x in v)}


def so_sanh(x, y, eps=1e-9):
    """Tiêu chí mục 3: trả 'tot_len' | 'xau_di' | 'bang' của bản x so với y theo thứ tự AC@1, AC@3, tổng hạng (nhỏ hơn tốt)."""
    for k, dau in (('AC@1', 1), ('AC@3', 1), ('tong_hang_cat', -1)):
        d = (x[k] - y[k]) * dau
        if abs(d) >= eps:
            return 'tot_len' if d > 0 else 'xau_di'
    return 'bang'


def khong_xau_di(x, y, eps=1e-9):
    return x['AC@1'] >= y['AC@1'] - eps and x['AC@3'] >= y['AC@3'] - eps


def tut_qua_2_bac(ca_x, ca_y):
    """Danh sách ca có hạng kỳ vọng của x tụt quá 2 bậc so với y (tiêu chí mục 3, điều kiện chung).

    Dùng hạng kỳ vọng không cắt; ca trượt (không có trong trả về / lỗi chạy) = vô cùng. Trượt ở cả hai bản: không tính tụt.
    """
    inf = float('inf')
    hx = {m: (v['hang_ky_vong'] if v['hang_ky_vong'] is not None else inf) for m, v in ca_x.items()}
    hy = {m: (v['hang_ky_vong'] if v['hang_ky_vong'] is not None else inf) for m, v in ca_y.items()}
    return [m for m in ca_x if hx[m] != hy[m] and (hx[m] - hy[m] > 2 + 1e-9)]


def chieu_canh_ve_nut(rec):
    """Tiêu chí mục 2 "Bản có đầu ra cạnh": một cạnh ở hạng k cho hai đầu nút hạng k nếu chúng chưa có hạng tốt hơn.
    Hạng nút ban đầu = vị trí đầu nhóm hòa trong `entity_ranking` (1-based). Trả bản ghi mới chỉ thay `entity_ranking`
    (nhóm theo hạng sau chiếu; khóa = −hạng) để chấm như bản không cạnh. Không có `canh_xep_hang`: trả nguyên bản ghi."""
    canh = ((rec.get('extra') or {}).get('m1_ft') or {}).get('canh_xep_hang')
    if rec.get('status') != 'OK' or not canh:
        return rec
    hang, vt = {}, 0
    blocks = danh_gia.khoi_tu_ban_ghi(rec)
    for b in blocks:
        tv = [e for g in b['groups'] for e in g]
        for e in tv:
            hang[e] = vt + 1
        vt += len(tv)
    for c in canh:
        if not c.get('co'):
            continue
        for e in (c['nguon'], c['dich']):
            if c['hang'] < hang.get(e, float('inf')):
                hang[e] = c['hang']
    thu_tu = sorted(hang, key=lambda e: (hang[e], e))
    nhom, er = {}, []
    for e in thu_tu:
        g = nhom.setdefault(hang[e], len(nhom))
        er.append({'entity': e, 'key': [-float(hang[e])], 'tie_group': g})
    out = dict(rec); out['entity_ranking'] = er; out.pop('blocks', None)
    return out


def cham_canh(rec, canh_dung):
    """Bảng cạnh: hạng kỳ vọng (dưới hoán vị đều trong nhóm hòa) của đúng cạnh có hướng và loại.
    canh_dung = (nguon, dich, loai). Bản không có đầu ra cạnh: 'UNSUPPORTED'."""
    canh = ((rec.get('extra') or {}).get('m1_ft') or {}).get('canh_xep_hang')
    if canh is None:
        return {'trang_thai': 'UNSUPPORTED'}
    a, b, loai = canh_dung
    idx = [i for i, c in enumerate(canh) if (c['nguon'], c['dich'], c['loai']) == (a, b, loai)]
    if not idx:
        return {'trang_thai': 'VANG', 'top3': 0.0, 'hang_ky_vong': None}
    c = canh[idx[0]]
    cung = [x for x in canh if x['tie_group'] == c['tie_group']]
    lo = min(x['hang'] for x in cung); g = len(cung)
    hk = lo + (g - 1) / 2
    top3 = sum(1 for q in range(1, g + 1) if lo + q - 1 <= 3) / g
    return {'trang_thai': 'OK', 'hang_ky_vong': hk, 'top3': top3, 'co': c['co'], 'diem': c['diem']}
"""Tiền xử lý span (SPEC T-043 B1.2, B2 E1, E2; đặc tả v1 §3, §7.1–7.2; dinh-chinh-cai-dat.md CĐ1).

- Khóa (traceID, spanID). Bỏ bản lặp y hệt và đếm; khóa trùng mà nội dung khác thì cả ca ERROR.
- Quan hệ cha–con dựng trên toàn miền; span gốc có parent rỗng; parent không resolve là span mồ côi.
- Con cắt về [s0, s1) của cha; con nằm hẳn ngoài cha bị bỏ khỏi phép tính của cha; con vượt biên quá τ được đếm.
- E1-U: u = d − |hợp con đã cắt|. E1-CP: u = d − |hợp con trên đường găng CRISP đã cắt| (CĐ1).
- Span bọc (dạng chặt): đúng một con, con ở thực thể khác, cha của span bọc resolve và cùng thực thể. g(w) = u_U(w).
- Đặc trưng tính trên quan hệ toàn miền, rồi mới chia N/A theo end (A khi end >= t).
Mọi thời gian cùng một đơn vị (đối số `t`, `tau` cùng đơn vị với start/duration).
"""

COT = ('traceID', 'spanID', 'parentSpanID', 'owner', 'operation', 'start_us', 'duration_us')


def _rong(x):
    return x is None or x == ''


def tien_xu_ly(rows):
    """Bỏ lặp, phát hiện khóa trùng khác nội dung, đếm span gốc và mồ côi."""
    seen = {}
    bo_lap = 0
    for r in rows:
        k = (r['traceID'], r['spanID'])
        v = tuple(r.get(c) for c in COT)
        if k in seen:
            if seen[k] == v:
                bo_lap += 1
                continue
            return {'bo_lap': bo_lap, 'loi': 'ERROR', 'con_lai': None, 'mo_coi': None, 'goc': None, 'spans': None,
                    'ly_do': f'khóa trùng khác nội dung: {k}'}
        seen[k] = v
    spans = {k: dict(zip(COT, v)) for k, v in seen.items()}
    goc = sum(1 for s in spans.values() if _rong(s['parentSpanID']))
    mo_coi = sum(1 for s in spans.values()
                 if not _rong(s['parentSpanID']) and (s['traceID'], s['parentSpanID']) not in spans)
    return {'bo_lap': bo_lap, 'loi': None, 'con_lai': len(spans), 'mo_coi': mo_coi, 'goc': goc, 'spans': spans}


def _hop(ds):
    ds = sorted((a, b) for a, b in ds if b > a)
    out = []
    for a, b in ds:
        if out and a <= out[-1][1]:
            out[-1] = (out[-1][0], max(out[-1][1], b))
        else:
            out.append((a, b))
    return out


def _dai(ds):
    return sum(b - a for a, b in _hop(ds))


def cat_con(cha, con, nguong_vuot):
    """Cắt con về [s0, s1); bỏ con có độ dài sau cắt <= 0; đếm con vượt biên cha quá nguong_vuot ở một đầu bất kỳ."""
    s0, s1 = cha
    cat, vuot = [], 0
    for a, b in con:
        if (s0 - a) > nguong_vuot or (b - s1) > nguong_vuot:
            vuot += 1
        x, y = max(a, s0), min(b, s1)
        if y > x:
            cat.append((x, y))
    return cat, vuot


def doc_quyen_U(cha, con):
    cat, _ = cat_con(cha, con, float('inf'))
    return (cha[1] - cha[0]) - _dai(cat)


def _happens_before(c, d, khac, tau):
    """CRISP §5.2 (thẻ đọc): c_end − τ < d_start và không con nào khác bắt đầu hay kết thúc trong vùng chồng lấn."""
    if c[0] > d[0] or not (c[1] - tau < d[0]):  # con bắt đầu trong khoảng của nút đang xét: bỏ qua (CRISP)
        return False
    if c[1] <= d[0]:
        return True
    lo, hi = d[0], c[1]
    return not any(lo < x < hi for e in khac for x in e)


def duong_gang(cha, con, tau):
    """Đường găng CRISP trên các con đã cắt: LFC, rồi lùi dần theo happensBefore, mỗi bước chọn con kết thúc muộn nhất.
    Quy tắc M1 (CĐ1; Minh duyệt 30/10/2026, dinh-chinh-cai-dat.md C5): τ = 1 ms; khi kiểm vùng chồng lấn xét mọi con
    khác của cùng cha, kể cả con đã chọn vào đường găng; biên mở (đầu mút trùng mút vùng không tính); phá hòa PII-04."""
    cat, _ = cat_con(cha, con, float('inf'))
    if not cat:
        return []
    tat_ca = sorted(cat, key=lambda x: (x[1], x[0]))
    con_lai = list(range(len(tat_ca)))  # chỉ số trong tat_ca; hai con trùng khoảng vẫn là hai con khác nhau
    k = con_lai.pop()  # kết thúc muộn nhất; hòa thì bắt đầu muộn hơn
    duong = [tat_ca[k]]
    while True:
        ung = []
        for j in con_lai:
            khac = [e for i, e in enumerate(tat_ca) if i not in (j, k)]  # gồm cả con đã chọn
            if _happens_before(tat_ca[j], tat_ca[k], khac, tau):
                ung.append((tat_ca[j][1], tat_ca[j][0], j))
        if not ung:
            break
        k = max(ung)[2]
        con_lai.remove(k)
        duong.append(tat_ca[k])
    return duong


def doc_quyen_CP(cha, con, tau):
    return (cha[1] - cha[0]) - _dai(duong_gang(cha, con, tau))


def chuan_bi(rows, t, tau, mien=None, tinh_CP=True):
    """Chuẩn bị span cho mọi thành phần. rows: dict theo COT; mien: (lo, hi) lọc span vào miền nếu có
    (start >= lo và end < hi). tinh_CP: tính u_CP (đường găng E1-CP); False thì u_CP = None, vì chỉ E1 = CP đọc nó
    và đường găng tốn bậc ba theo số con (T-045 ĐC3). Trả {'loi', 'spans': {khóa: span}, 'chan_doan'}."""
    if mien is not None:
        lo, hi = mien
        rows = [r for r in rows if r['start_us'] >= lo and r['start_us'] + r['duration_us'] < hi]
    tx = tien_xu_ly(rows)
    if tx['loi']:
        return {'loi': tx['loi'], 'ly_do': tx.get('ly_do'), 'spans': {}, 'chan_doan': tx}
    spans = {}
    for k, s in tx['spans'].items():
        st, d = s['start_us'], s['duration_us']
        cha = None if _rong(s['parentSpanID']) else (s['traceID'], s['parentSpanID'])
        spans[k] = {'khoa': k, 'chu': s['owner'], 'op': s['operation'], 'start': st, 'end': st + d, 'd': d,
                    'cha': cha if cha in tx['spans'] else None, 'mo_coi': cha is not None and cha not in tx['spans'],
                    'con': [], 'phia': 'A' if st + d >= t else 'N'}
    for k, s in spans.items():
        if s['cha'] is not None:
            spans[s['cha']]['con'].append(k)
    vuot = 0
    for k, s in spans.items():
        s['con'].sort()
        khoang = [(spans[c]['start'], spans[c]['end']) for c in s['con']]
        cat, v = cat_con((s['start'], s['end']), khoang, tau)
        vuot += v
        s['u'] = s['d'] - _dai(cat)
        s['u_CP'] = doc_quyen_CP((s['start'], s['end']), khoang, tau) if tinh_CP else None
    for k, s in spans.items():
        boc = (len(s['con']) == 1 and spans[s['con'][0]]['chu'] != s['chu']
               and s['cha'] is not None and spans[s['cha']]['chu'] == s['chu'])
        s['boc'] = boc
        s['g'] = s['u'] if boc else None
    cd = {'bo_lap': tx['bo_lap'], 'mo_coi': tx['mo_coi'], 'goc': tx['goc'], 'con_vuot_bien_cha': vuot,
          'so_span': len(spans), 'span_boc': sum(1 for s in spans.values() if s['boc'])}
    return {'loi': None, 'spans': spans, 'chan_doan': cd}


def mau_thao_tac(prep, E1):
    """Mẫu theo thao tác (chủ, tên). E1 tắt: thời lượng cả span, giữ span bọc (D21). E1 = U/CP: thời gian độc quyền,
    bỏ span bọc. Mỗi phía giữ cả mốc end của mẫu (cho E9)."""
    out = {}
    for s in sorted(prep['spans'].values(), key=lambda x: (x['end'], x['khoa'])):
        if E1 != 'tat' and s['boc']:
            continue
        v = s['d'] if E1 == 'tat' else (s['u'] if E1 == 'U' else s['u_CP'])
        m = out.setdefault((s['chu'], s['op']), {'N': [], 'A': [], 'moc_N': [], 'moc_A': []})
        m[s['phia']].append(v)
        m['moc_' + s['phia']].append(s['end'])
    return out


def mau_canh(prep):
    """Mẫu g(w) theo cạnh a → b, qua span bọc w của a có con ở b; chia N/A theo end của w."""
    out = {}
    for s in sorted(prep['spans'].values(), key=lambda x: (x['end'], x['khoa'])):
        if not s['boc']:
            continue
        b = prep['spans'][s['con'][0]]['chu']
        m = out.setdefault((s['chu'], b), {'N': [], 'A': [], 'moc_N': [], 'moc_A': []})
        m[s['phia']].append(s['g'])
        m['moc_' + s['phia']].append(s['end'])
    return out


def canh_goi(prep):
    """Cạnh gọi quan sát được: (chủ của span cha, chủ của span con), khác chủ, trong miền (N ∪ A)."""
    out = set()
    for s in prep['spans'].values():
        if s['cha'] is not None:
            a = prep['spans'][s['cha']]['chu']
            if a != s['chu']:
                out.add((a, s['chu']))
    return out


def dem_thao_tac(prep):
    """E3b: số span theo thao tác (chủ, tên) ở N và A, gồm cả span bọc (đặc tả v1 §7.4)."""
    out = {}
    for s in prep['spans'].values():
        n = out.setdefault((s['chu'], s['op']), [0, 0])
        n[0 if s['phia'] == 'N' else 1] += 1
    return {k: tuple(v) for k, v in out.items()}
# -*- coding: utf-8 -*-
"""Chạy M1-FT một bản trên một ca (trên exp-obs, user rca, venv P7 — WHY-81). Hai lần, kiểm trùng SHA.

  python -B chay_ca.py --id <mã mờ> --cau-hinh <file.json> --ban <mã biến thể> --ra <thư mục> [--goc /opt/flash-ticket-rca]
Đọc: <goc>/outputs/<id>/method-input.json (đầu vào P7 đã ghim) và, khi cấu hình cần, <goc>/cases/<id>/raw-traces.jsonl
+ request.json (chỉ lấy t). Ghi: <ra>/<id>/method-output-{1,2}.json, summary.json. Không đọc sổ tiêm lỗi/nhãn.
"""
import argparse, hashlib, json, sys, time
from pathlib import Path
sys.dont_write_bytecode = True
_SRC = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(_SRC))
from m1 import hop_dong  # noqa: E402
from m1.adapter_flashticket import jsonl  # noqa: E402
from m1_ft import chay as ft, bo_sung as bs  # noqa: E402

ap = argparse.ArgumentParser()
ap.add_argument('--id', required=True); ap.add_argument('--cau-hinh', required=True); ap.add_argument('--ban', required=True)
ap.add_argument('--ra', required=True); ap.add_argument('--goc', default='/opt/flash-ticket-rca')
ap.add_argument('--bo-sung', default='/opt/rca-m1ft/bo-sung/{id}/prometheus-bo-sung.json', help='gói metric bổ sung của ca')
a = ap.parse_args()
if not a.id.isalnum(): raise SystemExit('mã ca phải là mã mờ')
goc = Path(a.goc)
cau_hinh = json.loads(Path(a.cau_hinh).read_text(encoding='utf-8'))
inputs = json.loads((goc / 'outputs' / a.id / 'method-input.json').read_text(encoding='utf-8'))
if hop_dong.vi_pham_truong_cam(inputs): raise SystemExit('trường cấm trong đầu vào')
can = ft.can_bo_sung(cau_hinh); them = {}
t0 = time.monotonic()
if 'span_phu' in can:
    t_req = json.loads((goc / 'cases' / a.id / 'request.json').read_text(encoding='utf-8'))['t']
    if t_req != inputs[5]: raise SystemExit('t của request khác t trong method-input')
    them['span_phu'] = bs.span_phu(jsonl([goc / 'cases' / a.id / 'raw-traces.jsonl']), t_req)
    if hop_dong.vi_pham_truong_cam([them]): raise SystemExit('trường cấm trong bo_sung')
if 'bundles' in can:
    them['bundles'] = json.loads((goc / 'cases' / a.id / 'prometheus.json').read_text(encoding='utf-8'))
    if hop_dong.vi_pham_truong_cam([them['bundles']]): raise SystemExit('trường cấm trong bundles')
if 'bundles_bo_sung' in can:
    goi = json.loads(Path(a.bo_sung.format(id=a.id)).read_text(encoding='utf-8'))
    if goi.get('t') != inputs[5]: raise SystemExit('t của gói bổ sung khác t của ca')
    them['bundles_bo_sung'] = goi['bundles']
t_bs = time.monotonic() - t0
out = Path(a.ra) / a.id; out.mkdir(parents=True, exist_ok=False)
sh, giay = [], []
for n in (1, 2):
    t1 = time.monotonic(); rec = ft.chay(inputs, cau_hinh, ban=a.ban, bo_sung=them); giay.append(round(time.monotonic() - t1, 2))
    enc = ft.canonical(rec) + '\n'; (out / f'method-output-{n}.json').write_text(enc, encoding='utf-8')
    sh.append(hashlib.sha256(enc.encode()).hexdigest())
tom = {'id': a.id, 'ban': a.ban, 'status': rec.get('status'), 'verdict': rec.get('verdict'),
       'nhom_hang_1': [r['entity'] for r in rec.get('entity_ranking', []) if r['tie_group'] == 0],
       'output_sha256': sh, 'trung_sha': sh[0] == sh[1], 'giay_chay': giay, 'giay_bo_sung': round(t_bs, 2),
       'cau_hinh_sha256': ft.sha_cau_hinh(cau_hinh), 'ma_nguon_sha256': ft.sha_ma_nguon(),
       'chu_thich': (rec.get('extra') or {}).get('m1_ft', {}).get('chu_thich')}
(out / 'summary.json').write_text(json.dumps(tom, ensure_ascii=False, indent=1) + '\n', encoding='utf-8')
