"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content src/m1_ft/doi_moc.py -Encoding utf8; Get-Content src/m1_ft/thanh_phan/h8_adapter.py -Encoding utf8; Get-Content src/m1_ft/thanh_phan/h8_log.py -Encoding utf8; Get-Content src/m1_ft/thanh_phan/dc_bo_quan_he.py -Encoding utf8' in D:\RCA-flashticket
 succeeded in 305ms:
# -*- coding: utf-8 -*-
"""Kiểm độ nhạy mốc (T-064 SPEC bước 6, §7): dựng lại 7 tham số M1 từ gói ca với mốc dời t' = t + d.

Vì sao dựng lại thay vì chỉ đổi `inputs[5]`: `method-input.json` của P7 chỉ chứa span/log trong [t−300, t+300) của t
gốc; đổi riêng `inputs[5]` thì cửa sổ [t'−300, t'+300) của M1 hụt |d| giây ở một đầu. Gói ca (`cases/<id>/`, bộ đóng
gói ghim T-058 `stage-m1.py`) chứa dữ liệu thô [t−600, t+600) → dựng lại bằng **đúng** đường của runner ghim
(`run-m1.py`): `m1.adapter_flashticket.adapt(..., t')`, tham số = cấu hình khóa P7 + `params_ca` của adapter, cùng
các phép kiểm trường cấm và rò giá trị. Với d = 0, đường này phải cho `method-input.json` trùng byte bản đã lưu
(phép kiểm `--dung-lai-dau-vao --doi-t 0`).

Không đọc sổ tiêm lỗi hay nhãn. Mốc dời chỉ là t + d (d do người chạy khai, không suy từ nhãn).
"""
import copy
import hashlib
import json
import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parents[1]
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))
from m1 import chuoi, hop_dong  # noqa: E402
from m1.adapter_flashticket import adapt, jsonl  # noqa: E402

NS = 10 ** 9
CAM_CHUOI = ['/var/lib/flash-ticket-ledger', 'so-tiem-loi.jsonl', 'fault_service', 'injected_service',
             'injection_start', 'scenario_name']  # như danh sách `forbidden` của run-m1.py ghim


def _canonical(x):
    return json.dumps(x, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)


def dung_dau_vao(case_dir, ma_ca, t_moi, cau_hinh_p7, bien_doi=None):
    """→ (inputs, chan_doan). `case_dir` = <goc>/cases/<id>; `cau_hinh_p7` = dict cấu hình khóa (m1-p7-config.json).
    Ném SystemExit khi hash gói lệch, cửa sổ M1 vượt khỏi gói, hoặc có trường/giá trị cấm."""
    case = Path(case_dir)
    man = json.loads((case / 'manifest.json').read_text(encoding='utf-8'))
    for ten, mong in man['files'].items():
        p = case / ten
        if p.parent.resolve() != case.resolve():
            raise SystemExit('đầu vào ngoài danh sách của gói ca')
        if hashlib.sha256(p.read_bytes()).hexdigest() != mong['sha256']:
            raise SystemExit('hash gói ca lệch: ' + ten)
    lo_goi, hi_goi = man['pack_window_seconds']
    if not (lo_goi <= t_moi - 300 and t_moi + 300 <= hi_goi):
        raise SystemExit(f'cửa sổ M1 [t\'−300, t\'+300] vượt gói ca {man["pack_window_seconds"]}')
    inventory = json.loads((case / 'inventory.json').read_text(encoding='utf-8'))
    bundles = json.loads((case / 'prometheus.json').read_text(encoding='utf-8'))
    if bien_doi is not None:  # H8-adapter: biến đổi gói metric ghim trước adapter (vd. nối chuỗi container)
        bundles = bien_doi(bundles, inventory)
    conv = adapt(jsonl([case / 'raw-traces.jsonl']), jsonl([case / 'raw-logs.jsonl']), bundles, inventory, t_moi)
    params = copy.deepcopy(cau_hinh_p7)
    if set(params) & set(conv['params_ca']):
        raise SystemExit('adapter ghi đè tham số khóa')
    params.update(conv['params_ca'])
    chuoi._kiem_params(params)
    inputs = [conv['spans'], conv['metrics'], conv['logs'], conv['inventory'], conv['aliases'], t_moi, params]
    cam = [ma_ca, str(case), str(case.parent)] + CAM_CHUOI
    if hop_dong.vi_pham_truong_cam(inputs):
        raise SystemExit('trường cấm trong đầu vào dựng lại')
    if hop_dong.vi_pham_gia_tri(params, conv['aliases'], inventory, cam):
        raise SystemExit('giá trị cấm trong đầu vào dựng lại')
    ser = _canonical(inputs)
    if any(c in ser for c in cam):
        raise SystemExit('mã ca/đường dẫn lọt vào giá trị đầu vào')
    cov = params['coverage']
    lo, hi = (t_moi - 300) * NS, (t_moi + 300) * NS

    def _phu(c):  # nguồn có phủ trọn cửa sổ M1 không (theo khoảng thời gian adapter ghi)
        k = c.get('khoang') or []
        return bool(k) and min(a for a, _ in k) <= lo and max(b for _, b in k) + (c.get('r_ns') or 0) >= hi

    chan_doan = {'input_sha256': hashlib.sha256((ser + '\n').encode()).hexdigest(),
                 'goi_ca_cua_so': man['pack_window_seconds'], 't_moi': t_moi,
                 'nguon_khong_phu_tron': sorted(k for k, c in cov.items() if not _phu(c)),
                 'adapter': {'so_span': len(conv['spans']), 'so_log': len(conv['logs']),
                             'so_hang_metric': len(conv['metrics']),
                             'parent_missing_in_window': conv['chan_doan_adapter']['trace']['parent_missing_in_window'],
                             'unmapped_series': len(conv['chan_doan_adapter']['metric']['unmapped_series'])}}
    return inputs, chan_doan, ser
# -*- coding: utf-8 -*-
"""H8-adapter — nối chuỗi metric của container được tạo lại trong cửa sổ (T-064 H8; phiên C, 14/11/2026).

Vấn đề P7 (đã kiểm, `results/T-064/phien-c/h8-adapter/dem-chuoi-trung.json`): `m1.adapter_flashticket.normalize_metrics`
ném `Multiple runtime series map to one logical metric without a declared aggregation` khi một metric logic
(kênh, thực thể) có hơn một định danh chuỗi. Metric gốc theo container (`cpu`, `mem`) mang nhãn `container_id`; khi
container bị tạo lại (triển khai lại, `--force-recreate`) trong [t−600, t+600], chuỗi cũ và mới cùng về một thực thể → cả ca
ERROR, M1 không cho kết quả. Ca thật: `thuong01` (11/11, triển khai giữa cửa sổ).

Nút, cạnh, phép tính (luật 18): thành phần không thêm nút hay cạnh; nó chỉ đổi bước đầu vào metric (trước adapter ghim).
Nơi đặt: Prometheus `exp-obs`, chuỗi `container_cpu_utilization_ratio`/`container_memory_usage_total_bytes` từ Collector.

Nguyên lý gộp (ghi trước khi chấm, không theo đáp án): một thành phần logic chạy **một** container tại một thời điểm
(Compose FlashTicket một bản sao mỗi service). Các chuỗi chỉ khác nhau ở nhãn định danh runtime (`NHAN_RUNTIME`) và **không
chồng lấn trong mốc mẫu gốc** (mẫu cuối của chuỗi trước < mẫu đầu của chuỗi sau, theo `native_timestamps`) là cùng một
chuỗi bị đổi định danh → nối theo thời gian. Mỗi mốc đánh giá có nhiều điểm (do lookback ~5 phút của PromQL lặp mẫu cũ
của container đã dừng) thì giữ điểm có mốc mẫu gốc mới nhất — đúng cách Prometheus chọn mẫu khi chỉ có một chuỗi. Điểm bị
bỏ luôn là bản lặp của một mẫu gốc đã có ở mốc khác (kiểm `mat_mau == 0`, ghi chẩn đoán).
Không gộp (giữ hành vi P7: adapter ném lỗi) khi: chồng lấn trong mốc mẫu gốc (hai container chạy song song — cần phép
gộp khai báo như tổng/trung bình, không đoán); khác nhãn ngoài `NHAN_RUNTIME`; kênh không có mốc mẫu gốc (chuỗi dẫn xuất).
Điều kiện thất bại: container mới khởi động có mức CPU/bộ nhớ khác hẳn (JVM khởi động) → bước nhảy ngay sau mốc tạo lại
có thể gắn cờ thành phần; đây là thông tin thật (thành phần vừa tạo lại), không phải lỗi gộp, nhưng có thể không phải gốc.
Đối chứng: bản cha không có thành phần (trên ca không có tình huống này, đầu vào phải trùng byte).
"""
from m1_ft.chay import ThanhPhan, dang_ky

NHAN_RUNTIME = frozenset({'container_id', 'container_name', 'service_instance_id'})


def _k(labels):
    return tuple(sorted((k, v) for k, v in labels.items() if k != '__name__'))


def noi_chuoi(bundles, inventory, owner_of):
    """→ (bundles mới, chẩn đoán). `owner_of(labels, inventory)` = `m1.adapter_flashticket._owner` (ánh xạ ghim).
    Không sửa đối tượng đầu vào. Bundle không có nhóm cần nối được trả nguyên đối tượng."""
    cd = {'nhom_noi': [], 'nhom_khong_noi': [], 'diem_lap_bo': 0, 'mat_mau': 0}
    out = []
    for b in bundles:
        if not b.get('native') or not b.get('result'):
            out.append(b); continue
        nat = {_k(x['metric']): x['values'] for x in (b.get('native_timestamps') or [])}
        nhom = {}
        for it in b['result']:
            o = owner_of(it['metric'], inventory)
            if o is not None:
                nhom.setdefault(o, []).append(it)
        thay = {}
        for o, its in sorted(nhom.items()):
            if len({_k(x['metric']) for x in its}) <= 1:
                continue
            chung = set.intersection(*[set(_k(x['metric'])) for x in its])
            khac = {k for x in its for k, _ in set(_k(x['metric'])) - chung}
            muc = {'kenh': b['channel'], 'thuc_the': o, 'so_chuoi': len(its)}
            if not khac <= NHAN_RUNTIME:
                cd['nhom_khong_noi'].append(dict(muc, ly_do='khac_nhan_ngoai_runtime', nhan=sorted(khac))); continue
            # mốc mẫu gốc của từng chuỗi
            kh = []
            for x in its:
                n = nat.get(_k(x['metric']))
                if n is None:
                    break
                ts = sorted({float(v) for _, v in n})
                kh.append((ts[0], ts[-1], x, n))
            if len(kh) != len(its):
                cd['nhom_khong_noi'].append(dict(muc, ly_do='thieu_moc_mau_goc')); continue
            kh.sort(key=lambda z: (z[0], z[1]))
            if any(kh[i][1] >= kh[i + 1][0] for i in range(len(kh) - 1)):
                cd['nhom_khong_noi'].append(dict(muc, ly_do='chong_lan_moc_mau_goc',
                                                 khoang=[[a, z] for a, z, _, _ in kh])); continue
            # nối: mỗi mốc đánh giá giữ điểm có mốc mẫu gốc mới nhất
            chon = {}  # eval -> (native_ts, value, native_raw)
            tat_ca_mau = set()
            for _, _, x, n in kh:
                nmap = {str(e): v for e, v in n}
                for e, v in x['values']:
                    nr = nmap.get(str(e))
                    if nr is None:
                        raise ValueError('H8-adapter: thiếu mốc mẫu gốc cho một điểm')  # adapter ghim cũng từ chối
                    tat_ca_mau.add((float(nr), v))
                    cu = chon.get(str(e))
                    if cu is None or float(nr) > cu[0]:
                        if cu is not None:
                            cd['diem_lap_bo'] += 1
                        chon[str(e)] = (float(nr), v, nr, e)
                    else:
                        cd['diem_lap_bo'] += 1
            giu = {(z[0], z[1]) for z in chon.values()}
            cd['mat_mau'] += len(tat_ca_mau - giu)
            nhan = {k: v for k, v in kh[-1][2]['metric'].items() if k not in khac}
            dsx = sorted(chon.values(), key=lambda z: float(z[3]))
            thay[o] = ({'metric': nhan, 'values': [[z[3], z[1]] for z in dsx]},
                       {'metric': nhan, 'values': [[z[3], z[2]] for z in dsx]})
            cd['nhom_noi'].append(dict(muc, nhan_bo=sorted(khac), khoang=[[a, z] for a, z, _, _ in kh]))
        if not thay:
            out.append(b); continue
        res, natv = [], []
        da = set()
        for it in b['result']:
            o = owner_of(it['metric'], inventory)
            if o in thay:
                if o not in da:
                    res.append(thay[o][0]); da.add(o)
                continue
            res.append(it)
        for x in b.get('native_timestamps') or []:
            o = owner_of(x['metric'], inventory)
            if o in thay:
                continue
            natv.append(x)
        natv += [thay[o][1] for o in sorted(thay)]
        out.append(dict(b, result=res, native_timestamps=natv))
    return out, cd


@dang_ky
class NoiChuoiContainer(ThanhPhan):
    ma = 'H8-adapter'

    def __init__(self, tham_so):
        super().__init__(tham_so)
        self.cd = {'goi_ghim': None, 'duong_ong': None}

    def bien_doi_goi_ghim(self, bundles, inventory, nhan='goi_ghim'):
        """Áp lên danh sách bundle metric TRƯỚC adapter ghim (dựng đầu vào, và đường ống metric của M1-FT)."""
        from m1 import adapter_flashticket as ad
        moi, cd = noi_chuoi(bundles, list(inventory), ad._owner)
        self.cd[nhan] = cd
        return moi

    def ra(self, rec, inputs, ctx):
        rec.setdefault('extra', {}).setdefault('m1_ft', {}).setdefault('chu_thich', {})[self.ma] = {
            'goi_ghim': self.cd['goi_ghim'], 'duong_ong': self.cd['duong_ong'], 'nhan_runtime': sorted(NHAN_RUNTIME)}
        return rec
# -*- coding: utf-8 -*-
"""H8-log — kênh log nghiệp vụ theo trường kết cục của hợp đồng B16 (T-064 H8; phiên C, 14/11/2026).

Dữ liệu (đã đếm, `results/T-064/phien-c/h8-log/dem-log-nghiep-vu.json`): log JSON của api-gateway, booking, payment,
ticket (và event-service khi lỗi) mang `outcome` ∈ {SUCCESS, REJECTED, RETRY, FAILED, UNKNOWN} (B16 §log, dòng 56) và
`reasonCode`. Nơi đặt: log ứng dụng (Collector filelog → Loki → gói ca `raw-logs.jsonl`), đọc bằng `bo_sung.log_phu`.
Nút: thực thể sở hữu bản ghi (service.name, cùng ánh xạ với adapter ghim). Không thêm cạnh; lan truyền theo lớp kênh của
M1 (E1/E5 dùng lớp như các kênh cùng loại).

Ngữ nghĩa kết cục (B16, không theo đáp án): SUCCESS hoàn tất; REJECTED bị từ chối theo luật nghiệp vụ (xác thực, giới
hạn tốc độ) — quyết định đúng của hệ thống, không phải hỏng hóc; RETRY lỗi tạm thời sẽ thử lại; FAILED thất bại cuối;
UNKNOWN kết cục không xác định. "Kết cục lỗi" = FAILED ∪ UNKNOWN. RETRY không tính lỗi (tương tự WARN: tự phục hồi).

H8-log-kq (phép tính trên kênh `log_loi` sẵn có của P7): dòng log có `outcome` được phân loại lỗi/không lỗi theo kết cục
thay vì severity (severity_raw → 'ERROR' nếu kết cục lỗi, 'INFO' nếu không); dòng không có `outcome` giữ nguyên. Cùng đơn
vị, cùng E4 đếm, cùng cổng D1, cùng lớp `lan_nguoc`. Lý do: trường kết cục là trường hợp đồng; severity do người viết
code chọn. Điều kiện thất bại: dịch vụ ghi FAILED cho lỗi của bên khác (triệu chứng phía gọi) — như `log_loi` của P7.

H8-log-chuoi (hai kênh metric mới, qua đường metric chung, cùng E4 phân vị + G3 như kênh metric khác):
- `log-kq-loi` (lớp "lỗi"): mỗi ô 15 s, số bản ghi kết cục lỗi / số bản ghi có outcome (ô trống → 0, như H7b).
- `log-kq-ok` (lớp "lưu lượng"): số bản ghi SUCCESS mỗi giây trong ô 15 s. Phủ cả việc xử lý bất đồng bộ (RabbitMQ: saga
  thanh toán, phát vé) mà kênh `workload` HTTP của P7 không thấy.
Ô 15 s đóng dấu ở **đầu ô** [a, a + 15) nên ô chứa mốc t thuộc A, không trộn N/A. Lưới bắt đầu tại t − 300.
Điều kiện thất bại: dịch vụ chỉ ghi log khi lỗi (event-service) → N không có bản ghi, mọi ô N = 0; tải thay đổi làm
`log-kq-ok` đổi theo tải (như workload, H7 không áp cho kênh này).
Đối chứng: bản cha không có thành phần. Không dùng nhãn, tên ca, mốc tiêm ngoài t.
"""
from m1_ft.chay import ThanhPhan, dang_ky

KQ_LOI = frozenset({'FAILED', 'UNKNOWN'})
KQ_HOP_LE = frozenset({'SUCCESS', 'REJECTED', 'RETRY', 'FAILED', 'UNKNOWN'})
NS = 10 ** 9


@dang_ky
class LogKetCuc(ThanhPhan):
    ma = 'H8-log-kq'

    def __init__(self, tham_so):
        super().__init__(tham_so)
        self.bo_sung = None
        self.cd = {}

    def can_bo_sung(self):
        return ('log_phu',)

    def vao(self, inputs):
        spans, metrics, logs, inventory, aliases, t, params = inputs
        cho = {}
        for r in self.bo_sung['log_phu']:
            k = (r['timestamp'], r['entity'], r['message'], r['severity_raw'])
            cho.setdefault(k, []).append(r['outcome'])
        for v in cho.values():
            v.sort(key=lambda o: (o is None, str(o)))
        moi, doi = [], {'len_loi': 0, 'xuong_khong_loi': 0, 'giu': 0, 'co_outcome': 0, 'outcome_la': 0}
        theo_tt = {}
        loi = set(params['ho_so_nguon']['quy_tac_log']['loi'])
        for r in logs:
            k = (r['timestamp'], r['entity'], r['message'], r['severity_raw'])
            ds = cho.get(k)
            if not ds:
                raise ValueError('H8-log-kq: dòng log đầu vào không ghép được với log thô')
            o = ds.pop(0)
            if o is None or o not in KQ_HOP_LE:
                doi['giu'] += 1; doi['outcome_la'] += int(o is not None)
                moi.append(r); continue
            doi['co_outcome'] += 1
            sev = 'ERROR' if o in KQ_LOI else 'INFO'
            truoc = (str(r['severity_raw']).strip().upper() if isinstance(r['severity_raw'], str) else '') in loi
            if (sev == 'ERROR') != truoc:
                c = theo_tt.setdefault(r['entity'], {'len_loi': 0, 'xuong_khong_loi': 0})
                kieu = 'len_loi' if sev == 'ERROR' else 'xuong_khong_loi'
                doi[kieu] += 1; c[kieu] += 1
            moi.append(dict(r, severity_raw=sev))
        con = sum(len(v) for v in cho.values())
        if con:
            raise ValueError(f'H8-log-kq: {con} bản ghi log thô không có dòng đầu vào tương ứng')
        self.cd = dict(doi, theo_thuc_the=theo_tt, so_dong=len(logs))
        return [spans, metrics, moi, inventory, aliases, t, params]

    def ra(self, rec, inputs, ctx):
        rec.setdefault('extra', {}).setdefault('m1_ft', {}).setdefault('chu_thich', {})[self.ma] = self.cd
        return rec


@dang_ky
class LogChuoiKetCuc(ThanhPhan):
    ma = 'H8-log-chuoi'
    BUOC = 15

    def __init__(self, tham_so):
        super().__init__(tham_so)
        self.bo_sung = None
        self.cd = {}

    def can_bo_sung(self):
        return ('log_phu', 'bundles')

    def kenh_moi(self):
        return {'log-kq-loi': 'lỗi', 'log-kq-ok': 'lưu lượng'}

    def bien_doi_bundle(self, bundles, inputs):
        t = int(inputs[5]); b0 = t - 300; so_o = 600 // self.BUOC
        dem = {}
        for r in self.bo_sung['log_phu']:
            o = r['outcome']
            if o not in KQ_HOP_LE or r['entity'] is None:
                continue
            i = (r['timestamp'] - b0 * NS) // (self.BUOC * NS)
            if not 0 <= i < so_o:
                continue
            c = dem.setdefault(r['entity'], [[0, 0, 0] for _ in range(so_o)])  # [tổng, lỗi, success]
            c[i][0] += 1; c[i][1] += int(o in KQ_LOI); c[i][2] += int(o == 'SUCCESS')
        loi, ok = [], []
        for sv in sorted(dem):
            v = dem[sv]
            moc = [str(b0 + k * self.BUOC) for k in range(so_o)]
            loi.append({'metric': {'service_name': sv},
                        'values': [[m, repr(x[1] / x[0] if x[0] else 0.0)] for m, x in zip(moc, v)]})
            ok.append({'metric': {'service_name': sv},
                       'values': [[m, repr(x[2] / self.BUOC)] for m, x in zip(moc, v)]})
        q = '(log nghiệp vụ B16, phiên C)'
        them = [{'channel': 'log-kq-loi', 'native': False, 'query': q, 'step_seconds': self.BUOC, 'result': loi,
                 'native_timestamps': None},
                {'channel': 'log-kq-ok', 'native': False, 'query': q, 'step_seconds': self.BUOC, 'result': ok,
                 'native_timestamps': None}]
        self.cd = {'thuc_the': sorted(dem), 'ban_ghi': {sv: sum(x[0] for x in v) for sv, v in sorted(dem.items())},
                   'ket_cuc_loi': {sv: sum(x[1] for x in v) for sv, v in sorted(dem.items())}}
        return [b for b in bundles if b['channel'] not in self.kenh_moi()] + them

    def ra(self, rec, inputs, ctx):
        co = [k['don_vi'] for k in (rec.get('extra') or {}).get('kenh_co', [])
              if any(k['don_vi'].endswith('_' + c) for c in self.kenh_moi())]
        rec.setdefault('extra', {}).setdefault('m1_ft', {}).setdefault('chu_thich', {})[self.ma] = dict(
            self.cd, chan_doan_metric=getattr(self, 'chan_doan_metric', None), don_vi_co_co=co)
        return rec
# -*- coding: utf-8 -*-
"""DC-bo-quan-he — đối chứng bỏ quan hệ trên cùng bản (SPEC T-064: "Quan hệ (cạnh) có tác dụng tính toán không?").

Không phải thành phần đề xuất. Chỉ ghi đè `params['bat_tat']` của P7: tắt các bước dùng đồ thị/quan hệ
(mặc định E1='tat', E2='tat', E5=False) để so cùng bản có/không quan hệ, ô theo ô. Mọi thành phần khác giữ nguyên.
Điều kiện thất bại: nếu tắt xong P7 trả ERROR/UNSUPPORTED thì ô đó ghi nguyên trạng, không thay bằng giá trị khác.
Tham số `bat_tat` cho phép ghi đè từng khóa (vd. chỉ tắt E5).
"""
from m1_ft.chay import ThanhPhan, dang_ky

MAC_DINH = {'E1': 'tat', 'E2': 'tat', 'E5': False}


@dang_ky
class BoQuanHe(ThanhPhan):
    ma = 'DC-bo-quan-he'

    def vao(self, inputs):
        p = dict(inputs[6])
        bt = dict(p['bat_tat'])
        bt.update(self.tham_so.get('bat_tat') or MAC_DINH)
        p['bat_tat'] = bt
        self.bat_tat_dung = bt
        return list(inputs[:6]) + [p]

    def ra(self, rec, inputs, ctx):
        rec.setdefault('extra', {}).setdefault('m1_ft', {})['dc_bo_quan_he'] = self.bat_tat_dung
        return rec

