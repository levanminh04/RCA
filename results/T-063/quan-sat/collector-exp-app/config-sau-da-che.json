 "processors": {
  "memory_limiter": {
   "check_interval": "1s",
   "limit_mib": 384,
   "spike_limit_mib": 64
  },
  "resource/host": {
   "attributes": [
    {
     "key": "host.id",
     "value": "exp-app",
     "action": "upsert"
    },
    {
     "key": "deployment.environment",
     "value": "exp",
     "action": "upsert"
    }
   ]
  },
  "batch": {
   "timeout": "1s",
   "send_batch_size": 1024
  },
  "filter/health": {
   "error_mode": "ignore",
   "traces": {
    "span": [
     "attributes[\"http.route\"] == \"/actuator/health\""
    ]
   }
  },
  "transform/sanitize": {
   "error_mode": "ignore",
   "trace_statements": [
    {
     "context": "span",
     "statements": [
      "delete_key(attributes, \"url.query\")",
      "replace_pattern(attributes[\"url.full\"], \"[?].*\", \"\") where attributes[\"url.full\"] != nil",
      "replace_pattern(attributes[\"http.url\"], \"[?].*\", \"\") where attributes[\"http.url\"] != nil",
      "replace_pattern(attributes[\"http.target\"], \"[?].*\", \"\") where attributes[\"http.target\"] != nil"
     ]
    }
   ]
  }
 },
 "exporters": {
  "otlp": {
   "endpoint": "10.0.0.215:4317",
   "tls": {
    "insecure": true
   },
   "retry_on_failure": {
    "enabled": true,
    "initial_interval": "1s",
    "max_interval": "30s",
    "max_elapsed_time": "0s"
   },
   "sending_queue": {
    "enabled": true,
    "queue_size": 1000,
    "storage": "file_storage"
   }
  },
  "file/traces": {
   "path": "/data/traces.jsonl",
   "rotation": {
    "max_megabytes": 100,
    "max_backups": 10
   }
  },
  "file/logs": {
   "path": "/data/logs.jsonl",
   "rotation": {
    "max_megabytes": 50,
    "max_backups": 5
   }
  }
 },
 "service": {
  "extensions": [
   "file_storage",
   "health_check"
  ],
  "telemetry": {
   "metrics": {
    "readers": [
     {
      "pull": {
       "exporter": {
        "prometheus": {
         "host": "127.0.0.1",
         "port": 8888
        }
       }
      }
     }
    ]
   }
  },
  "pipelines": {
   "traces": {
    "receivers": [
     "otlp",
     "otlp/keycloak"
    ],
    "processors": [
     "memory_limiter",
     "filter/health",
     "transform/sanitize",
     "resource/host",
     "batch"
    ],
    "exporters": [
     "otlp",
     "file/traces"
    ]
   },
   "metrics": {
    "receivers": [
     "otlp",
     "otlp/keycloak",
     "docker_stats",
     "hostmetrics",
     "postgresql",
     "mongodb",
     "redis",
     "rabbitmq",
     "prometheus/self"
    ],
    "processors": [
     "memory_limiter",
     "resource/host",
     "batch"
    ],
    "exporters": [
     "otlp"
    ]
   },
   "logs": {
    "receivers": [
     "filelog/payment-service",
     "filelog/booking-service",
     "filelog/event-service",
     "filelog/keycloak",
     "filelog/discovery-server",
     "filelog/api-gateway",
     "filelog/ticket-service",
     "filelog/user-service"
    ],
    "processors": [
     "memory_limiter",
     "resource/host",
     "batch"
    ],
    "exporters": [
     "otlp",
     "file/logs"
    ]
   }
  }
 }
}
