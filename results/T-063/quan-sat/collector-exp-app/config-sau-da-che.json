{
 "extensions": {
  "file_storage": {
   "directory": "/data/queue",
   "create_directory": true
  },
  "health_check": {
   "endpoint": "127.0.0.1:13133"
  }
 },
 "receivers": {
  "otlp": {
   "protocols": {
    "grpc": {
     "endpoint": "127.0.0.1:4317"
    },
    "http": {
     "endpoint": "127.0.0.1:4318"
    }
   }
  },
  "otlp/keycloak": {
   "protocols": {
    "http": {
     "endpoint": "10.0.0.158:4318"
    }
   }
  },
  "docker_stats": {
   "endpoint": "unix:///var/run/docker.sock",
   "collection_interval": "10s",
   "excluded_images": [
    "*pumba*",
    "*toxiproxy*",
    "*k6*",
    "otel/opentelemetry-collector-contrib*"
   ],
   "container_labels_to_metric_labels": {
    "com.docker.compose.service": "service.name"
   },
   "metrics": {
    "container.cpu.throttling_data.periods": {
     "enabled": true
    },
    "container.cpu.throttling_data.throttled_periods": {
     "enabled": true
    },
    "container.cpu.throttling_data.throttled_time": {
     "enabled": true
    },
    "container.cpu.limit": {
     "enabled": true
    },
    "container.restarts": {
     "enabled": true
    },
    "container.uptime": {
     "enabled": true
    },
    "container.pids.count": {
     "enabled": true
    }
   }
  },
  "hostmetrics": {
   "root_path": "/hostfs",
   "collection_interval": "10s",
   "scrapers": {
    "cpu": {},
    "memory": {},
    "load": {},
    "disk": {},
    "network": {},
    "filesystem": {}
   }
  },
  "postgresql": {
   "endpoint": "127.0.0.1:5432",
   "username": "otel_monitor",
   "password": "<da-che>",
   "databases": [
    "keycloak_db",
    "event_db",
    "booking_db",
    "payment_db",
    "ticket_db"
   ],
   "collection_interval": "10s",
   "tls": {
    "insecure": true
   }
  },
  "mongodb": {
   "hosts": [
    {
     "endpoint": "127.0.0.1:27017"
    }
   ],
   "username": "otel_monitor",
   "password": "<da-che>",
   "collection_interval": "10s",
   "tls": {
    "insecure": true
   }
  },
  "redis": {
   "endpoint": "127.0.0.1:6379",
   "password": "<da-che>",
   "collection_interval": "10s"
  },
  "rabbitmq": {
   "endpoint": "http://127.0.0.1:15672",
   "username": "otel_monitor",
   "password": "<da-che>",
   "collection_interval": "10s"
  },
  "prometheus/self": {
   "config": {
    "scrape_configs": [
     {
      "job_name": "local-collector",
      "scrape_interval": "10s",
      "static_configs": [
       {
        "targets": [
         "127.0.0.1:8888"
        ]
       }
      ]
     }
    ]
   }
  },
  "filelog/payment-service": {
   "include": [
    "/var/lib/docker/containers/ff01b3a98d9f6b872e16e4e7665e6fc0ca83b4e284de2667d69a721606dc2c0d/ff01b3a98d9f6b872e16e4e7665e6fc0ca83b4e284de2667d69a721606dc2c0d-json.log"
   ],
   "start_at": "beginning",
   "storage": "file_storage",
   "include_file_path": true,
   "operators": [
    {
     "type": "json_parser",
     "id": "docker",
     "parse_to": "attributes.docker",
     "timestamp": {
      "parse_from": "attributes.docker.time",
      "layout_type": "gotime",
      "layout": "2006-01-02T15:04:05.999999999Z07:00"
     }
    },
    {
     "type": "move",
     "from": "attributes.docker.log",
     "to": "body"
    },
    {
     "type": "add",
     "field": "resource[\"service.name\"]",
     "value": "payment-service"
    },
    {
     "type": "add",
     "field": "resource[\"service.instance.id\"]",
     "value": "payment-service-1"
    },
    {
     "type": "json_parser",
     "id": "spring",
     "parse_from": "body",
     "parse_to": "attributes.app",
     "if": "body matches \"^\\\\s*\\\\{\"",
     "on_error": "send"
    }
   ]
  },
