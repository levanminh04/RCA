# -*- coding: utf-8 -*-
"""T-063 bước 2 — phép thử phân xử cơ chế CPU-BOOK (chạy trên exp-app: ssh ... 'python3 -' < thu_cuong_do.py).

Giả thuyết H-cum: với quota 1 lõi (chu kỳ CFS 100 ms) và 2 luồng đốt trên máy 2 lõi, Booking chiếm cả hai lõi trong phần
đầu mỗi chu kỳ rồi bị throttle → tiến trình khác (Postgres, Event…) chờ CPU theo cụm → trễ tăng ở service không phụ thuộc
Booking, dù CPU trung bình 10 s của chúng không đổi. Dự đoán phân biệt: 1 luồng đốt (dùng ≤ 1 lõi liên tục, không chiếm
hai lõi cùng lúc) làm trễ của đường không qua Booking tăng ít hơn rõ so với 2 luồng; áp lực CPU máy (`/proc/pressure/cpu`)
tăng theo cùng chiều.
Giả thuyết khác: H-phu-thuoc (trễ lan qua lời gọi tới Booking) — đường đo ở đây (Gateway → Event → Postgres; Postgres trực
tiếp) không gọi Booking, nên nếu trễ tăng thì không do phụ thuộc gọi.

Cơ chế đốt giống hệt `~/inj.py` ô CPU-BOOK (`docker exec -d BOOK timeout N sh -c ': rcaburn; while :; do :; done'`).
Không gửi nhãn tới ứng dụng. In JSON mỗi dòng. Dọn tiến trình đốt khi kết thúc hoặc lỗi.
"""
import json, os, pathlib, socket, statistics, subprocess, sys, time, urllib.request, datetime as dt

BOOK = 'flash-ticket-booking-service-booking-service-1'
URL = 'http://10.0.0.158:8081/api/v1/events?size=1'
PHA = [('nen_1', 0, 60), ('dot_2_luong', 2, 60), ('nghi_1', 0, 25), ('dot_1_luong', 1, 60), ('nghi_2', 0, 25), ('nen_2', 0, 40)]
HZ = 10.0


def now(): return dt.datetime.now(dt.timezone.utc).isoformat()
def out(**k): print(json.dumps({'t': now(), **k}, ensure_ascii=False)); sys.stdout.flush()
def sh(*c, check=True): return subprocess.run(c, capture_output=True, text=True, check=check).stdout


def cg():
    cid = sh('docker', 'inspect', BOOK, '--format', '{{.Id}}').strip()
    b = pathlib.Path(f'/sys/fs/cgroup/system.slice/docker-{cid}.scope')
    st = dict(l.split() for l in (b / 'cpu.stat').read_text().splitlines())
    return {k: int(st.get(k, 0)) for k in ('usage_usec', 'nr_periods', 'nr_throttled', 'throttled_usec')}


def psi():
    f = pathlib.Path('/proc/pressure/cpu').read_text().split()
    return int([x for x in f if x.startswith('total=')][0].split('=')[1])  # dòng 'some' đứng trước


def stat_cpu():
    v = [int(x) for x in pathlib.Path('/proc/stat').read_text().splitlines()[0].split()[1:]]
    return sum(v), v[3] + v[4]  # tổng, idle+iowait


def pg_rtt():
    s = socket.create_connection(('127.0.0.1', 5432), timeout=3); t = time.perf_counter()
    s.sendall(b'\x00\x00\x00\x08\x04\xd2\x16\x2f'); s.recv(1); s.close(); return (time.perf_counter() - t) * 1000


def http_ms():
    t = time.perf_counter()
    try: code = urllib.request.urlopen(URL, timeout=5).status
    except urllib.error.HTTPError as e: code = e.code
    except Exception: code = -1
    return (time.perf_counter() - t) * 1000, code


def dot(n, giay):
    for _ in range(n):
        sh('docker', 'exec', '-d', BOOK, 'timeout', str(giay), 'sh', '-c', ': rcaburn; while :; do :; done')


def don():
    sh('docker', 'exec', BOOK, 'pkill', '-f', 'rcaburn', check=False)


def q(xs, p):
    xs = sorted(xs); return round(xs[min(len(xs) - 1, int(p * len(xs)))], 2) if xs else None


def main():
    don()
    out(su_kien='bat_dau', pha=PHA, url=URL)
    try:
        for ten, n, giay in PHA:
            c0, p0, (tot0, idl0) = cg(), psi(), stat_cpu()
            if n: dot(n, giay + 2)
            hs, pgs, codes = [], [], {}
            t_end = time.time() + giay; k = 0
            while time.time() < t_end:
                t_next = time.time() + 1 / HZ
                h, c = http_ms(); hs.append(h); codes[c] = codes.get(c, 0) + 1
                try: pgs.append(pg_rtt())
                except Exception: pass
                k += 1
                time.sleep(max(0, t_next - time.time()))
            if n: don()
            c1, p1, (tot1, idl1) = cg(), psi(), stat_cpu()
            ncpu = os.cpu_count()
            out(su_kien='pha', ten=ten, luong=n, giay=giay, mau=k, http_code=codes,
                http_ms={'p50': q(hs, .5), 'p90': q(hs, .9), 'p99': q(hs, .99), 'tb': round(statistics.mean(hs), 2)},
                pg_ms={'p50': q(pgs, .5), 'p90': q(pgs, .9), 'p99': q(pgs, .99), 'tb': round(statistics.mean(pgs), 2) if pgs else None},
                psi_some_ms_moi_giay=round((p1 - p0) / 1000 / giay, 1),
                may_ban_loi=round(ncpu * (1 - (idl1 - idl0) / max(1, tot1 - tot0)), 3),
                booking={'loi_cpu': round((c1['usage_usec'] - c0['usage_usec']) / 1e6 / giay, 3),
                         'ty_le_chu_ky_throttle': round((c1['nr_throttled'] - c0['nr_throttled']) / max(1, c1['nr_periods'] - c0['nr_periods']), 3),
                         'throttled_ms_moi_giay': round((c1['throttled_usec'] - c0['throttled_usec']) / 1000 / giay, 1)})
            time.sleep(2)
    finally:
        don()
        out(su_kien='ket_thuc', so_tien_trinh_dot_con_lai=sh('docker', 'exec', BOOK, 'sh', '-c', "ps -o args | grep -c '^sh -c : rcaburn' || true", check=False).strip())


main()
# -*- coding: utf-8 -*-
"""T-063 bước 2 — phân loại span gốc và span mồ côi trên gói ca T-062 (OTLP JSON `raw-traces.jsonl`).

Nhóm (B16 §3: job định kỳ là gốc hợp lệ; điểm vào HTTP là gốc hợp lệ):
  diem_vao_http      gốc SERVER có http.request.method / http.route
  job_hop_le         gốc INTERNAL của bộ lập lịch (scope spring-scheduling / quartz / tên `Lớp.phương_thức` không có http)
  consumer_goc       gốc CONSUMER (message không mang ngữ cảnh cha — Saga lẽ ra có cha từ producer)
  client_goc_db      gốc CLIENT có db.system (SQL chạy ngoài span cha: mất ngữ cảnh hoặc job không được bọc)
  client_goc_khac    gốc CLIENT khác (HTTP/redis… không có cha)
  internal_khac      gốc INTERNAL không nhận ra
  mo_coi             có parentSpanId nhưng cha không có trong cả gói (khác: cha ngoài cửa sổ phương pháp)
Đếm theo (service, nhóm, scope, kind, tên) trong cửa sổ [t−300, t+300). Không đọc nhãn.
Dùng: py -3 -B results/T-063/span-goc/phan_loai.py [mã ca ...] → results/T-063/kiem-r/krb4a3d5/phan-loai-goc.json
"""
import collections, json, sys
from pathlib import Path
sys.stdout.reconfigure(encoding='utf-8')
R = Path('D:/RCA-flashticket'); CA = R / 'results/T-063/kiem-r'
IDS = sys.argv[1:] or sorted(p.name for p in CA.iterdir() if p.is_dir() and not p.name.startswith('_'))
KIND = {1: 'INTERNAL', 2: 'SERVER', 3: 'CLIENT', 4: 'PRODUCER', 5: 'CONSUMER', 0: 'UNSPECIFIED'}
SCHED = ('spring-scheduling', 'quartz', 'scheduling', 'executor')


def av(v):
    for k in ('stringValue', 'intValue', 'boolValue', 'doubleValue'):
        if k in v: return v[k]
    return None


def attrs(lst): return {a['key']: av(a['value']) for a in (lst or [])}


def nhom(s):
    a, k, sc = s['a'], s['kind'], s['scope']
    if k == 'SERVER' and ('http.request.method' in a or 'http.route' in a or 'http.method' in a): return 'diem_vao_http'
    if k == 'CONSUMER': return 'consumer_goc'
    if k == 'CLIENT': return 'client_goc_db' if ('db.system' in a or 'db.system.name' in a) else 'client_goc_khac'
    if k == 'INTERNAL' and (any(x in sc for x in SCHED) or ('code.function' in a or 'code.function.name' in a)):
        return 'job_hop_le'
    return 'internal_khac'


tong = {}
for ca in IDS:
    t = json.loads((CA / ca / 'cases' / ca / 'request.json').read_text())['t']
    lo, hi = (t - 300) * 10 ** 9, (t + 300) * 10 ** 9
    spans = {}
    with open(CA / ca / 'cases' / ca / 'raw-traces.jsonl', encoding='utf-8') as fh:
        for line in fh:
            d = json.loads(line)
            for rs in d.get('resourceSpans', []):
                svc = attrs(rs['resource'].get('attributes')).get('service.name')
                for ss in rs.get('scopeSpans', []):
                    sc = (ss.get('scope') or {}).get('name', '')
                    for sp in ss.get('spans', []):
                        spans[sp['spanId']] = {'svc': svc, 'scope': sc, 'kind': KIND.get(sp.get('kind', 0), str(sp.get('kind'))),
                                               'name': sp.get('name'), 'parent': sp.get('parentSpanId') or None,
                                               'st': int(sp['startTimeUnixNano']), 'en': int(sp['endTimeUnixNano']),
                                               'a': attrs(sp.get('attributes'))}
    dem = collections.Counter(); vi_du = {}
    n_cua_so = 0
    for sid, s in spans.items():
        if not (s['st'] >= lo and s['en'] < hi): continue
        n_cua_so += 1
        if s['parent'] is None: g = nhom(s)
        elif s['parent'] not in spans: g = 'mo_coi'
        else: continue
        key = (s['svc'], g, s['scope'], s['kind'], s['name'])
        dem[key] += 1
        if key not in vi_du:
            a = s['a']
            vi_du[key] = {k: (str(a[k])[:160]) for k in ('thread.name', 'db.statement', 'db.query.text', 'code.function', 'code.namespace',
                                                         'code.function.name', 'messaging.destination.name', 'http.route', 'server.address') if k in a}
    theo_nhom = collections.Counter()
    for (svc, g, *_), c in dem.items(): theo_nhom[(svc, g)] += c
    tong[ca] = {'t': t, 'so_span_cua_so': n_cua_so,
                'theo_service_nhom': {f'{svc}|{g}': c for (svc, g), c in sorted(theo_nhom.items())},
                'chi_tiet': [{'service': k[0], 'nhom': k[1], 'scope': k[2], 'kind': k[3], 'ten': k[4], 'so': c, 'vi_du_thuoc_tinh': vi_du[k]}
                             for k, c in dem.most_common()]}
    print('==', ca, 'span trong cửa sổ', n_cua_so)
    for (svc, g), c in sorted(theo_nhom.items(), key=lambda x: -x[1])[:14]: print(f'   {svc:18s} {g:16s} {c}')
(R / 'results/T-063/kiem-r/krb4a3d5/phan-loai-goc.json').write_text(json.dumps(tong, ensure_ascii=False, indent=1) + '\n', encoding='utf-8')

