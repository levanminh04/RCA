    # H7 — theo route
    ('route-rate', 'sum by(service_name, http_route) (rate(http_server_request_duration_seconds_count' + R1 + '))'),
    ('route-5xx', 'sum by(service_name, http_route) (rate(http_server_request_duration_seconds_count{http_response_status_code=~"5.."}' + R1 + '))'),
    # H1 — DB/cache theo thực thể
    ('pg-backends', 'sum by(postgresql_database_name) (postgresql_backends)'),
    ('pg-ops', 'sum by(postgresql_database_name) (rate(postgresql_operations_total' + R1 + '))'),
    ('redis-cmd', 'sum (rate(redis_commands_processed_total' + R1 + '))'),
    ('redis-clients', 'sum (redis_clients_connected)'),
]


def q_range(q, s, e, step):
    u = B + 'query_range?' + urllib.parse.urlencode({'query': q, 'start': s, 'end': e, 'step': step})
    r = json.load(urllib.request.urlopen(u, timeout=60))
    if r.get('status') != 'success':
        raise RuntimeError(str(r)[:200])
    return r['data']['result']


def main():
    ap = argparse.ArgumentParser(); ap.add_argument('--t', type=int, required=True); ap.add_argument('--ra')
    ap.add_argument('--step', type=int, default=15); ap.add_argument('--khuc', type=int, default=600)
    a = ap.parse_args()
    S, E = a.t - 300, a.t + 300
    out, loi = [], []
    for ch, q in KENH:
        gop = {}
        s = S
        while s <= E:
            e = min(E, s + a.khuc - a.step)
            try:
                for x in q_range(q, s, e, a.step):
                    k = json.dumps(x['metric'], sort_keys=True)
                    g = gop.setdefault(k, {'metric': x['metric'], 'values': []})
                    g['values'] += x['values']
            except Exception as ex:
                loi.append({'channel': ch, 'start': s, 'error': repr(ex)[:200]}); time.sleep(5)
            s = e + a.step
            time.sleep(0.3)
        res = []
        for g in gop.values():
            seen, vals = set(), []
            for t0, v in sorted(g['values'], key=lambda z: float(z[0])):
                if t0 not in seen:
                    seen.add(t0); vals.append([t0, v])
            res.append({'metric': g['metric'], 'values': vals})
        out.append({'channel': ch, 'native': False, 'query': q, 'step_seconds': a.step, 'result': res, 'native_timestamps': None})
    doc = {'phien_ban': 'T063-bo-sung-3', 't': a.t, 'cua_so': [S, E], 'loi_khuc': loi, 'bundles': out}
    txt = json.dumps(doc, ensure_ascii=False, separators=(',', ':')) + '\n'
    if a.ra:
        open(a.ra, 'w', encoding='utf-8').write(txt)
    else:
        sys.stdout.write(txt)
    sys.stderr.write(json.dumps({'kenh': len(out), 'chuoi': sum(len(b['result']) for b in out), 'loi_khuc': len(loi)}) + '\n')


main()
#!/usr/bin/env python3
"""T-063 — bộ tiêm lỗi bản 2 trên exp-app (dựa trên ~/inj.py của T-062, sha256 bc711063…, giữ nguyên cách tiêm của ô cũ).

Dùng:  python3 inj2.py start <O> [--seconds N] | stop <O> | probe <O> | cleanup | ensure
In một dòng JSON mỗi lệnh. Không gửi nhãn tới ứng dụng. Đầu dò **không gọi HTTP của app** (T-063 span-goc, THIET-KE-BO-CHAY-2 #1).
Ô (danh mục: results/T-063/o-dev-bo-sung.md; thay SLOW-BOOK: WHY-83):
  EVENT-DB-LAT, REDIS-BOOK, NET-GW-BOOK  toxic latency (như T-062)
  HTTP5-EVENT, HTTP5-EVENT-FLASH          hook http.error của Event, target = sự kiện tải mới (FLASH: bộ chạy tăng tải ×3)
  CPU-BOOK-1, CPU-BOOK-2                  1 / 2 luồng đốt trong cgroup Booking (CPU-BOOK-2 = CPU-BOOK T-062)
  POOL-EVENT                              hook pool.hold = 4 connection của Event (pool max 5)
  PAUSE-PAYMENT                           docker pause payment-service
  CONSUMER-BOOK-SLOW                      toxic latency trên proxy AMQP booking-amqp (cần proxy + RABBITMQ_PORT của Booking)
  FLASH-HEALTHY, BINH-THUONG              không can thiệp
"""
import json, os, signal, socket, subprocess, sys, time, uuid, datetime as dt, urllib.request, pathlib

A = pathlib.Path('/opt/flash-ticket-app')
STATE = pathlib.Path('/home/ubuntu/t063/inj'); STATE.mkdir(parents=True, exist_ok=True)
TOXI = 'http://127.0.0.1:8474'
EVENT_ID = '3e7c1df9-ada4-4081-94a1-548b80a5da86'   # sự kiện tải mua vé (results/T-062/tai-2/BAN-GIAO-1-giao-dich.md)
BOOK = 'flash-ticket-booking-service-booking-service-1'
PAY = 'flash-ticket-payment-service-payment-service-1'
AMQP_PROXY = {'name': 'booking-amqp', 'listen': '127.0.0.1:15673', 'upstream': '127.0.0.1:5672', 'enabled': True}

CELLS = {
    'EVENT-DB-LAT': dict(kind='toxic', proxy='event-jdbc', latency=30),
    'REDIS-BOOK': dict(kind='toxic', proxy='booking-redis', latency=200),
    'NET-GW-BOOK': dict(kind='toxic', proxy='gateway-booking-http', latency=300),
    # bản 2 (D2 d2b-2a7f481a): latency 200 ms không giới hạn thông lượng → không tồn queue; đổi sang bandwidth (KB/s)
    'CONSUMER-BOOK-SLOW': dict(kind='toxic', proxy='booking-amqp', toxic='bandwidth', rate=1),  # lần 3 (lần 2 rate=2 không tồn queue)
    'HTTP5-EVENT': dict(kind='hook', service='event-service', action='http.error', target=EVENT_ID, value=0),
    'HTTP5-EVENT-FLASH': dict(kind='hook', service='event-service', action='http.error', target=EVENT_ID, value=0),
    'POOL-EVENT': dict(kind='hook', service='event-service', action='pool.hold', target=None, value=4),
    'CPU-BOOK-1': dict(kind='cpu', workers=1),
    'CPU-BOOK-2': dict(kind='cpu', workers=2),
    'PAUSE-PAYMENT': dict(kind='pause', container=PAY),
    'FLASH-HEALTHY': dict(kind='none'),
    'BINH-THUONG': dict(kind='none'),
}


def now(): return dt.datetime.now(dt.timezone.utc).isoformat()
def out(**k): print(json.dumps({'t': now(), **k}, ensure_ascii=False)); sys.stdout.flush()
def sh(*c, check=True): return subprocess.run(c, capture_output=True, text=True, check=check).stdout


def http(method, path, body=None):
    req = urllib.request.Request(TOXI + path, method=method, data=None if body is None else json.dumps(body).encode(),
                                 headers={'Content-Type': 'application/json'})
    with urllib.request.urlopen(req, timeout=5) as r:
        t = r.read(); return json.loads(t) if t else None


def write_lease(service, action, target, value, seconds=300):
    d = A / 'rca-faults' / service / 'control'
    c = {'leaseId': str(uuid.uuid4()), 'action': action, 'value': value, 'subject': '',
         'expiresAt': (dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=seconds)).isoformat()}
    if target: c['targetId'] = target
    tmp = f'/tmp/ctl-{uuid.uuid4().hex}.json'
    pathlib.Path(tmp).write_text(json.dumps(c) + '\n')
    sh('sudo', 'install', '-o', '10001', '-g', '10001', '-m', '0640', tmp, str(d / 'control.tmp'))
    sh('sudo', 'mv', '-f', str(d / 'control.tmp'), str(d / 'control.json'))
    os.unlink(tmp)
    return c['leaseId']


def renewer(cell, seconds):
    c = CELLS[cell]; end = time.monotonic() + seconds
    while time.monotonic() < end:
        lid = write_lease(c['service'], c['action'], c['target'], c['value'], seconds=min(180, int(end - time.monotonic()) + 5))
        with open(STATE / f'{cell}.leases', 'a') as f: f.write(json.dumps({'t': now(), 'leaseId': lid}) + '\n')
        time.sleep(min(120, max(1, end - time.monotonic())))
    write_lease(c['service'], 'off', None, 0, seconds=30)


def ensure():
    """Proxy AMQP của Booking phải tồn tại (Booking kết nối qua nó). Idempotent."""
    px = http('GET', '/proxies')
    if AMQP_PROXY['name'] not in px:
        http('POST', '/proxies', AMQP_PROXY)
    out(op='ensure', proxies=sorted(http('GET', '/proxies')))


def start(cell, seconds):
    c = CELLS[cell]
    if c['kind'] == 'toxic':
        if c.get('toxic') == 'bandwidth':
            body = {'name': 't063', 'type': 'bandwidth', 'stream': 'downstream', 'toxicity': 1.0, 'attributes': {'rate': c['rate']}}
        else:
            body = {'name': 't063', 'type': 'latency', 'stream': 'downstream', 'toxicity': 1.0,
                    'attributes': {'latency': c['latency'], 'jitter': 0}}
        http('POST', f"/proxies/{c['proxy']}/toxics", body)
    elif c['kind'] == 'hook':
        p = subprocess.Popen([sys.executable, __file__, '_renew', cell, str(seconds)], stdout=open(STATE / f'{cell}.renew.log', 'a'),
                             stderr=subprocess.STDOUT, start_new_session=True)
        (STATE / f'{cell}.pid').write_text(str(p.pid))
    elif c['kind'] == 'cpu':
        for _ in range(c['workers']):
            sh('docker', 'exec', '-d', BOOK, 'timeout', str(seconds), 'sh', '-c', ': rcaburn; while :; do :; done')
    elif c['kind'] == 'pause':
        sh('docker', 'pause', c['container'])
        (STATE / f'{cell}.pause-deadline').write_text(str(time.time() + seconds))
    if c['kind'] in ('toxic', 'pause'):
        # Tự gỡ đúng hạn trên exp-app, độc lập laptop (mất mạng laptop 13/11 04:19–05:00Z): tiến trình tách phiên,
        # ngủ tới hạn + 5 s rồi gọi stop (idempotent). Hook có lease tự hết; CPU có `timeout`.
        p = subprocess.Popen([sys.executable, __file__, '_het_han', cell, str(time.time() + seconds + 5)],
                             stdout=open(STATE / f'{cell}.het-han.log', 'a'), stderr=subprocess.STDOUT, start_new_session=True)
        (STATE / f'{cell}.het-han.pid').write_text(str(p.pid))
    out(op='start', cell=cell, seconds=seconds, params=c)


def het_han(cell, deadline):
    time.sleep(max(0, float(deadline) - time.time()))
    try:
        stop(cell); out(op='het-han-stop', cell=cell)
    except Exception as e:
        out(op='het-han-loi', cell=cell, err=str(e)[:200])
    finally:
        for pf in STATE.glob(f'{cell}.het-han.pid'): pf.unlink()


def stop(cell):
    c = CELLS[cell]
    hp = STATE / f'{cell}.het-han.pid'
    if hp.exists() and sys.argv[1:2] != ['_het_han']:  # dừng sớm bình thường: hủy tiến trình hẹn giờ
        try: os.killpg(int(hp.read_text()), signal.SIGTERM)
        except (ProcessLookupError, ValueError): pass
        hp.unlink(missing_ok=True)
    if c['kind'] == 'toxic':
        try: http('DELETE', f"/proxies/{c['proxy']}/toxics/t063")
        except urllib.error.HTTPError as e:
            if e.code != 404: raise  # 404 = không còn toxic (đã sạch); lỗi khác phải báo lên bộ chạy
        except Exception:
            raise
    elif c['kind'] == 'hook':
        pf = STATE / f'{cell}.pid'
        if pf.exists():
            try: os.killpg(int(pf.read_text()), signal.SIGTERM)
            except ProcessLookupError: pass
            pf.unlink()
        write_lease(c['service'], 'off', None, 0, seconds=30)
    elif c['kind'] == 'cpu':
        sh('docker', 'exec', BOOK, 'pkill', '-f', 'rcaburn', check=False)
    elif c['kind'] == 'pause':
        r = subprocess.run(['docker', 'unpause', c['container']], capture_output=True, text=True)
        if r.returncode != 0 and 'is not paused' not in r.stderr: raise RuntimeError('unpause lỗi: ' + r.stderr[-200:])
        for pf in STATE.glob(f'{cell}.pause-deadline'): pf.unlink()
    out(op='stop', cell=cell)


def cgroup(name):
    cid = sh('docker', 'inspect', name, '--format', '{{.Id}}').strip()
    b = pathlib.Path(f'/sys/fs/cgroup/system.slice/docker-{cid}.scope')
    st = dict(l.split() for l in (b / 'cpu.stat').read_text().splitlines())
    pr = (b / 'cpu.pressure').read_text().splitlines()[0] if (b / 'cpu.pressure').exists() else ''
    return {'usage_usec': int(st['usage_usec']), 'nr_throttled': int(st.get('nr_throttled', 0)),
            'throttled_usec': int(st.get('throttled_usec', 0)), 'pressure': pr}


def probe(cell):
    """Đầu dò độc lập, không gọi HTTP của app (không sinh span ứng dụng)."""
    r = {'cell': cell}
    try: r['toxics'] = {k: [t['name'] + ':' + str(t['attributes']) for t in v.get('toxics', [])] for k, v in http('GET', '/proxies').items()}
    except Exception as e: r['toxics_error'] = str(e)[:200]
    for svc in ('booking-service', 'event-service'):
        f = A / 'rca-faults' / svc / 'audit' / 'executions.jsonl'
        lines = sh('sudo', 'tail', '-n', '2000', str(f), check=False).splitlines()
        ops = {}
        for l in lines:
            try: o = json.loads(l); k = o.get('operation') or o.get('event')
            except Exception: continue
            ops[k] = ops.get(k, 0) + 1
        r[f'audit_{svc}'] = {'lines_tail2000': len(lines), 'ops': ops}
    try: r['cgroup_booking'] = cgroup(BOOK)
    except Exception as e: r['cgroup_booking'] = str(e)[:120]
    r['burn_procs'] = sh('docker', 'exec', BOOK, 'sh', '-c', "ps -o args | grep -c '^sh -c : rcaburn'", check=False).strip()
    r['payment_state'] = sh('docker', 'inspect', PAY, '--format', '{{.State.Status}} {{.State.Paused}}', check=False).strip()
    try:  # áp lực CPU toàn máy (REVIEW T-063 R4): dòng some/full, avg10/60/300 và total (µs)
        r['psi_cpu_may'] = pathlib.Path('/proc/pressure/cpu').read_text().strip().splitlines()
    except Exception as e: r['psi_cpu_may'] = str(e)[:80]
    def rtt(port):
        t = time.perf_counter(); s = socket.create_connection(('127.0.0.1', port), timeout=3); s.close()
        return round((time.perf_counter() - t) * 1000, 2)
    r['tcp_connect_ms'] = {}
    for p in (5432, 15433, 6379, 16379, 5672, 15673, 8082, 18082):
        try: r['tcp_connect_ms'][str(p)] = rtt(p)
        except Exception as e: r['tcp_connect_ms'][str(p)] = str(e)[:40]
    def redis_ping(port):
        s = socket.create_connection(('127.0.0.1', port), timeout=3); t = time.perf_counter()
        s.sendall(b'PING\r\n'); s.recv(64); s.close(); return round((time.perf_counter() - t) * 1000, 2)
    try: r['redis_ping_ms'] = {'direct': redis_ping(6379), 'proxy': redis_ping(16379)}
    except Exception as e: r['redis_ping_ms'] = str(e)[:120]
    def pg_rtt(port):
        s = socket.create_connection(('127.0.0.1', port), timeout=3); t = time.perf_counter()
        s.sendall(b'\x00\x00\x00\x08\x04\xd2\x16\x2f'); s.recv(1); s.close(); return round((time.perf_counter() - t) * 1000, 2)
    try: r['pg_sslrequest_ms'] = {'direct': pg_rtt(5432), 'proxy_event': pg_rtt(15433)}
    except Exception as e: r['pg_sslrequest_ms'] = str(e)[:120]
    out(op='probe', **r)


def trang_thai_sach():
    """Kiểm môi trường không còn can thiệp (REVIEW T-063 R1): toxic t063, pause, luồng đốt, lease hook đang hiệu lực."""
    con = []
    for name, v in http('GET', '/proxies').items():
        if any(t.get('name') == 't063' for t in v.get('toxics', [])): con.append(f'toxic:{name}')
    if 'true' in sh('docker', 'inspect', PAY, '--format', '{{.State.Paused}}', check=False).lower(): con.append('pause:payment')
    n = sh('docker', 'exec', BOOK, 'sh', '-c', "ps -o args | grep -c '^sh -c : rcaburn' || true", check=False).strip() or '0'
    if n != '0': con.append(f'burn:{n}')
    for svc in ('booking-service', 'event-service'):
        f = A / 'rca-faults' / svc / 'control' / 'control.json'
        try:
            c = json.loads(sh('sudo', 'cat', str(f)))
            if c.get('action') != 'off' and dt.datetime.fromisoformat(c['expiresAt']) > dt.datetime.now(dt.timezone.utc):
                con.append(f'lease:{svc}:{c.get("action")}')
        except Exception:
            pass
    for pf in STATE.glob('*.pid'): con.append(f'renewer:{pf.stem}')
    return con


def cleanup():
    loi = []
    for k, c in CELLS.items():
        if c['kind'] != 'none':
            try: stop(k)
            except Exception as e: loi.append({'cell': k, 'err': str(e)[:200]}); out(op='cleanup-error', cell=k, err=str(e)[:200])
    con = trang_thai_sach()
    out(op='cleanup', sach=not con, con_lai=con, loi=loi)


def verify():
    """Gỡ pause/toxic quá hạn (deadline ghi lúc start) rồi báo trạng thái sạch. Không tự gỡ can thiệp còn hạn."""
    for pf in STATE.glob('*.pause-deadline'):
        try:
            if time.time() > float(pf.read_text()):
                sh('docker', 'unpause', PAY, check=False); pf.unlink()
        except ValueError:
            pass
    con = trang_thai_sach()
    out(op='verify', sach=not con, con_lai=con)


if __name__ == '__main__':
    a = sys.argv[1:]
    if a[0] == '_renew': renewer(a[1], int(a[2]))
    elif a[0] == 'start': start(a[1], int(a[3]) if len(a) > 3 and a[2] == '--seconds' else 600)
    elif a[0] == 'stop': stop(a[1])
    elif a[0] == 'probe': probe(a[1] if len(a) > 1 else '-')
    elif a[0] == 'cleanup': cleanup()
    elif a[0] == 'ensure': ensure()
    elif a[0] == 'verify': verify()
    elif a[0] == '_het_han': het_han(a[1], a[2])
    else: raise SystemExit(__doc__)
# Prompt đánh giá độc lập và bàn giao

Dùng sau mọi lượt trình SPEC, báo cáo kết quả, phản biện, người làm đáp phản biện hoặc kiểm sửa (Q-88). Người phản biện chính thức phải khác người làm. Các lượt không tự đổi vai trò.

## Cách dùng

1. Chép nguyên văn **Prompt chung** + đúng một **Khối công đoạn** + **Khối trọng tâm cổng** hiện có. Không bỏ câu mạnh hoặc thay bằng danh sách kiểm riêng.
2. Chỉ điền chỗ <...> bằng thông tin trung tính: task/đề xuất, công đoạn, vai trò, đường dẫn, revision, manifest, môi trường/lệnh chạy và quyền ghi đã được Minh duyệt. Không thêm kết luận, số của người làm, gợi ý chỗ có lỗi/an toàn, mã quyết định/bài học cụ thể hoặc giới hạn khoa học riêng (Q-44).
3. Người làm ghi prompt vào mục LOG mới khi có quyền; người phản biện ghi trong bản phản biện lượt của mình, trước bảng phản hồi; chưa có quyền ghi thì đưa trong chat. Không thay prompt cũ.
4. Minh copy sang phiên của agent đối phương. Agent không tự mở phiên hay gửi sang agent khác. SPEC chưa được duyệt tạo file được trình và soát trong chat.
5. Sau mỗi lượt vẫn soạn prompt, kể cả đề xuất dừng. Bất kỳ bên nào có thể đề xuất dừng; Minh quyết. Không che bất đồng bên kia còn giữ. Đồng thuận không thay bằng chứng; dừng phản biện không tự duyệt SPEC, đóng task hoặc mở test.

Người phản biện chỉ ghi đúng một bản lượt được Minh cho phép. Liệt kê thư mục trước khi chọn tên bản mới; REVIEW.md nếu chưa có, REVIEW-2.md… cho lượt sau, không ghi đè lịch sử. Người làm chỉ điền bảng phản hồi của bản liên quan và LOG trong quyền được duyệt; không sửa nhận xét hay prompt của người phản biện.

## Cách chạy

**Codex phản biện:** mở phiên tương tác trong D:\RCA-flashticket rồi dán prompt; hoặc dùng CLI chỉ đọc và lưu câu trả lời vào đúng file đã được Minh cho phép:

```
codex exec -s read-only -C D:\RCA-flashticket -o tasks\T-xxx-<tên>\<bản-phản-biện-đã-duyệt>.md "<dán prompt>"
```

Nếu chỉ được trả lời trong chat, không dùng tùy chọn lưu file. Với người làm đáp phản biện, dùng phiên tương tác và quyền ghi bảng phản hồi/LOG đã duyệt.

**Claude:** mở phiên mới trong D:\RCA-flashticket rồi dán prompt. Quyền ghi do prompt đã được Minh duyệt xác định, không mặc nhiên cấp quyền sửa.

## Prompt chung

```text
Bạn thực hiện một lượt đánh giá độc lập trong repo D:\RCA-flashticket.
Đọc AGENTS.md trước. Giữ đúng vai trò và phạm vi đã được Minh duyệt.

Thông tin lượt này:
- Task hoặc đề xuất: <mã và đường dẫn; nếu đề xuất đang trong chat, dán nguyên văn>.
- Công đoạn: <soát SPEC / soát kết quả / người làm đáp phản biện / kiểm lại phản hồi và sửa>.
- Gói/cổng: <gói, cổng hiện tại; ngoài task thì ghi loại đề xuất>.
- Người làm và người phản biện chính thức: <tên theo SPEC; ngoài task thì ghi vai trò dự kiến>.
- Tài liệu gốc: <danh sách đường dẫn và git diff từ commit gốc nếu có>.
- Phản biện và phản hồi trước: <đường dẫn theo thứ tự thời gian; không có thì ghi không có>.
- Code và kết quả liên quan: <đường dẫn, revision, manifest, hướng dẫn môi trường/lệnh chạy; không áp dụng thì ghi không áp dụng>.
- Phạm vi ghi được Minh cho phép trong lượt này: <chỉ trả lời trong chat, hoặc file và phần được phép ghi chính xác>.

Không sửa ngoài phạm vi trên, không commit. Chưa có quyền ghi rõ ràng thì chỉ đọc và trả lời trong chat. Giữ các bản lượt cũ. Không đọc dữ liệu khóa hoặc chạy thực nghiệm ngoài quyền được duyệt.

Đọc nguồn và đầu ra gốc trước khi đọc kết luận các lượt phản biện/phản hồi. Lập nhận xét độc lập trước, không lấy tóm tắt trong LOG thay bằng chứng trên file thật.
Nguồn đối chiếu: docs/STATE.md, SPEC và LOG nếu có; phần trực tiếp chi phối trong docs/MRP.md, docs/WHY.md, docs/DECISIONS.md, docs/LESSONS.md.
Nguồn đề tài: docs/reference/sources/DT18-de-tai-va-nhiem-vu.md và docs/reference/sources/advisor-2026-09-23.md.

Nhiệm vụ: tìm lỗi ảnh hưởng tới (1) tính đúng của lập luận, phương pháp hoặc kết quả,
hoặc (2) độ khớp với DT18 và hướng dẫn của cô.
Kiểm cụ thể: đầu ra có đạt "Tiêu chí xong" trong SPEC không; có ghi ra ngoài "Phạm vi ghi" không;
số trong văn bản có khớp file kết quả không (chạy lại nếu rẻ và được phép); có nhãn nào lọt vào phương pháp không;
có lựa chọn nào thiếu lý do trong docs/WHY.md không; có lặp sai lầm nào trong docs/LESSONS.md không.

Bổ sung yêu cầu phản biện:
1. Phân biệt yêu cầu của DT18/cô, quyết định của Minh, đề xuất và ứng viên. Đối chiếu các câu “chọn”, “sẽ”, “dùng để” với thời điểm bằng chứng phải có. Tìm trường hợp kế hoạch nói chọn sau thực nghiệm nhưng đã cam kết cơ chế trước đó.
2. Kiểm lập luận trong WHY, không chỉ kiểm có mục “tại sao”. Tìm phương án đối lập giả và kết luận mạnh hơn bằng chứng. Khi nêu lỗi, xét cả đoạn có thể phản bác finding đó.
3. Khi tính đúng phụ thuộc vào phương pháp hoặc benchmark được dẫn, đọc bài/code chính thức ở revision liên quan. Lần theo phần chọn đầu vào, tiền xử lý, dùng nhãn, xử lý ngoại lệ và lưu kết quả. Không mặc định code chính thức hoặc bản mới nhất cho kết quả hợp lệ.
4. Lần theo thông tin đồ thị và nhãn từ đầu vào → đặc trưng → điểm bất thường → tập ứng viên → xếp hạng. Với đối chứng “không đồ thị”, xác định thông tin cấu trúc còn lại và phạm vi kết luận phép so sánh thực sự hỗ trợ.
5. Phân biệt lỗi đã xảy ra, mâu thuẫn thiết kế và nguy cơ chưa kiểm. Không biến OPEN thành lỗi chỉ vì chưa hoàn thành công việc thuộc gói sau. Không yêu cầu làm xong P4 ngay tại G0.
6. Mỗi finding ghi rõ bước chịu ảnh hưởng, bằng chứng, hậu quả và sửa tối thiểu. Không tìm cho đủ số lượng. Không đề xuất thêm quy trình, cổng hoặc phép kiểm “cho chắc”. Không chạy thực nghiệm mới hay mở dữ liệu khóa ngoài phạm vi được phép.
7. Kiểm cả đạt SPEC và đạt phần mục tiêu nguồn. Nếu chỉ đạt một phần, nêu phần thiếu và quyết định phụ thuộc. Không dùng “chưa kiểm” làm căn cứ đã xác nhận hoặc “ngoài SPEC” để bỏ nghĩa vụ nghiên cứu. Không ép một nguyên nhân vào chỗ chưa biết.
8. Với nhận định quan trọng, hỏi còn nguyên nhân khả thi nào khác giải thích kết quả và bằng chứng có phân xử được không. Trước khi dùng đầu ra cũ, kiểm hash theo manifest phù hợp; lệch thì dừng phần phụ thuộc và báo Minh. Số làm bằng chứng phải có đường dẫn và con trỏ JSON hoặc lệnh đã chạy kèm kết quả.
9. Kiểm tuân thủ quy trình bằng việc thực tế: vai trò, quyền ghi và duyệt phạm vi; nguồn quyết định; tự kiểm; LOG/STATE/bàn giao theo nghĩa vụ của vai trò; tự đổi mục tiêu/tiêu chí/thiết kế; đề nghị chuyển bước khi thiếu căn cứ. Áp dụng luật và quyền có hiệu lực ở thời điểm việc được làm, không tự mở lại task đã đóng. Chỉ báo vi phạm có bằng chứng và ảnh hưởng cụ thể, không chỉ xác nhận đã đọc AGENTS.
10. Sau tự soát, kiểm từng điểm và phản hồi các lượt trước: đúng / đúng một phần / sai / chưa kiểm được, với bằng chứng riêng. Không mặc nhiên đồng ý với bên nào. Nêu phạm vi lỗi rộng/hẹp hơn hoặc mặt trái của đề xuất sửa.
11. Rà cả phần không được nêu trong LOG, báo cáo hay phản biện trước. Với mỗi bước dữ liệu đi qua (đọc → chuyển đổi → tính → chấm), hỏi quy ước của dữ liệu nguồn (giá trị đặc biệt, đơn vị, gốc, alias, rỗng) có được xử lý đúng không. Không coi phần không ai nêu là đã đúng.
12. Một trạng thái xảy ra đồng loạt (100% lỗi, 100% không hỗ trợ, toàn hòa, toàn rỗng) là dấu hiệu cần lần tới đầu vào, không phải kết quả để diễn giải. Không dùng nó làm căn cứ thiết kế trước khi lần.
13. Điểm cuối khớp số công bố, hay "chạy không lỗi", chưa chứng minh thành phần chạy đúng. Kiểm trung gian và phép kiểm không cần nhãn.
14. Câu có "mọi", "đều", "không đổi", "trùng" phải nói rõ đại lượng và có lệnh đếm trên đủ đối tượng.
15. Trước khi đề xuất sửa hoặc ghi vào một file dùng chung (code, script, tài liệu), kiểm file đó có bị ghim trong manifest, plan hoặc vân tay job nào không. Nêu rõ thao tác nào làm đổi hash và ảnh hưởng tới đâu.
16. Kiểm tiêu chí so sánh hoặc chấp nhận được khai trước khi xem kết quả. Đổi tiêu chí sau khi xem phải khai là sửa sau.
17. Với lượt chạy, tách lỗi hạ tầng và điều phối (tiến trình, nguồn điện, kết nối, giới hạn thời gian) khỏi lỗi phương pháp; lỗi hạ tầng không được ghi thành kết quả khoa học.
18. Phản biện một kế hoạch thì kiểm cả đường thực thi thật: code có cho phép làm đúng như kế hoạch nói không (guard, thư mục, trạng thái đã khóa). Không chỉ kiểm lập luận trên giấy.
19. Mỗi phần ghi "chưa xác định", "chưa phân xử", "chưa biết" hoặc OPEN phải kèm giải thích: vì sao chưa xác định được (thiếu dữ kiện gì, hay dữ liệu đã lưu không tách được các giải thích); các giải thích khả thi còn lại; bằng chứng hoặc phép phân tích nào phân xử được, trên dữ liệu nào, chi phí; kết luận nào phụ thuộc. Không dừng ở một câu "chưa xác định".
20. Mỗi phần chờ Minh quyết phải kèm đề xuất của agent trong chính lượt đó: chọn gì, vì sao, mặt trái, phương án khác đã xét. Prompt bàn giao yêu cầu agent đối phương phản biện các đề xuất ấy. Đề xuất không thay quyết định của Minh.

Không báo: chính tả, văn phong, đề xuất thêm quy trình, thêm phép kiểm "cho chắc".
Nếu không có lỗi đáng kể, nói thẳng là không có. Không cần tìm cho đủ số lượng.

Mỗi điểm: CHẶN hoặc KHÔNG CHẶN; chặn kết luận/quyết định nào; ở đâu; sai gì;
bằng chứng (trích dẫn, số, phản ví dụ, lệnh đã chạy); hậu quả; đề xuất sửa tối thiểu hoặc bằng chứng còn thiếu.
Tiếng Việt, câu ngắn.

Cuối lượt báo:
1. Đã làm gì.
2. File đã thay đổi, hoặc không sửa file nào.
3. Kiểm đã chạy và kết quả.
4. Bất đồng có bằng chứng, câu hỏi mở, phần thiếu và quyết định bị ảnh hưởng; điều cần Minh quyết.

Đề xuất tiếp tục hoặc dừng phản biện, kèm lý do. Nếu không còn phản đối chưa xử lý ảnh hưởng tính đúng, phạm vi kết luận hoặc quyết định đang xin duyệt, đề xuất dừng; không che bất đồng bên kia còn giữ. Có thể thống nhất giới hạn khi thiếu bằng chứng; kết luận phụ thuộc vẫn OPEN. Minh quyết cuối. Hai agent đồng ý không thay bằng chứng khoa học; dừng phản biện không tự duyệt SPEC, đóng task hoặc mở test.

Sau đó soạn prompt bàn giao cho agent đối phương: chép nguyên văn Prompt chung + đúng Khối công đoạn + Khối cổng hiện có trong docs/review-prompt.md, chỉ điền thông tin trung tính. Giữ vai trò; người làm nhận prompt đáp phản biện, người phản biện nhận prompt kiểm độc lập. Vẫn soạn khi đề xuất dừng để Minh chọn gửi hay dừng; không tự gửi.
```

## Khối công đoạn

Chép đúng một khối; không tự sửa các câu kiểm.

### Soát SPEC

```text
Công đoạn: soát SPEC.
Kiểm câu hỏi nguồn, phần mục tiêu được bao phủ, giả thuyết khác, khả năng phân xử của dữ liệu, phép kiểm dự kiến, phụ thuộc bước, chi phí, phạm vi và tiêu chí xong. Phần không làm phải có lý do, hệ quả và quyết định phụ thuộc.
Đánh giá kế hoạch và bằng chứng đã có; không đòi có kết quả của thực nghiệm chưa được duyệt. Phân biệt ứng viên để thử với lựa chọn đã chốt.
Chỉ ghi bản phản biện được Minh cho phép theo tasks/_MAU/REVIEW.md, hoặc trả lời trong chat nếu chưa có quyền ghi. Không tự sửa SPEC.
```

### Soát kết quả

```text
Công đoạn: soát kết quả.
Kiểm trên đầu ra thật, code và dữ liệu được phép; không tin tóm tắt LOG. Đối chiếu tiêu chí xong với phần mục tiêu nguồn và mức căn cứ cho bước tiếp theo; chạy lại phần rẻ khi trong quyền được duyệt.
Phân biệt hoàn thành task mô tả, xác nhận cơ chế và đủ căn cứ chọn/đánh giá thiết kế. Giới hạn đã khai không tự miễn phép kiểm cần thiết còn làm được.
Chỉ ghi bản phản biện lượt được Minh cho phép theo tasks/_MAU/REVIEW.md, hoặc trả lời trong chat. Giữ bản cũ; không sửa kết quả thay người làm.
```

### Người làm đáp phản biện

```text
Công đoạn: người làm đáp phản biện. Giữ vai trò người làm, không là người phản biện chính thức của chính task.
Tự soát yêu cầu và mọi file đầu ra gốc cần để trả lời các câu hỏi như một người chưa từng làm task, TRƯỚC khi mở kết luận các bản phản biện. Ghi danh sách điểm tự tìm được vào LOG trước khi mở các kết luận ấy nếu được phép ghi; phiên chỉ đọc ghi nhận xét trong chat.
Sau đó kiểm từng điểm phản biện trên file/code/dữ liệu thật; chạy lại khi rẻ và được phép. Kết luận đúng / đúng một phần / sai / chưa kiểm được với bằng chứng riêng. Reviewer có thể sai, nói quá hoặc đề xuất sửa có mặt trái.
Nếu được Minh cho phép: điền bảng Phản hồi của người làm ở cuối đúng bản phản biện; thêm N1, N2… cho điểm tự tìm được với CHẶN/KHÔNG CHẶN; để trống cột Minh quyết; nối LOG đủ mục 7 của AGENTS, gồm đề xuất sửa gom theo file; chỉ cập nhật dòng task trong STATE khi được phép. Không sửa nội dung hay prompt của reviewer hoặc tự sửa báo cáo/code.
Nếu chưa có quyền ghi các phần này, trình phản hồi và đề xuất trong chat. Soạn prompt bàn giao cho người phản biện kiểm độc lập.
```

### Phân tích sâu

```text
Công đoạn: phân tích sâu kết quả đã có.
Đọc trung gian và từng ca, cả ca sai lẫn ca đúng có điều kiện tương ứng. Tìm mẫu hình còn khai thác được cho câu hỏi nghiên cứu.
Tách ba mức: quan sát (số, ca, đường dẫn); ứng viên chưa kiểm (giả định, khi nào sai, kết luận phụ thuộc); phép phân tích đề xuất (trên đầu ra đã lưu, chi phí, câu hỏi MRP nó trả lời).
Không chạy phương pháp mới trên test, không chọn hay đổi thiết kế từ test. Một ô không phải mẫu hình; đặc tính chung của thuật toán không phải nguyên nhân riêng của ca sai.
Chỉ ghi phần được Minh cho phép; đề xuất sửa SPEC ghi rõ mục, đoạn thêm và lý do.
```

### Kiểm lại phản hồi và sửa

```text
Công đoạn: người phản biện kiểm lại phản hồi và sửa.
Tự soát yêu cầu và đầu ra gốc trước; sau đó đọc phản biện, phản hồi và các thay đổi được duyệt. Kiểm cả ý kiến phản bác reviewer; không mặc định phản hồi hoặc bản sửa đúng.
Đối chiếu từng điểm với bằng chứng hiện tại, quyền sửa và hậu quả. Có điểm đúng nhưng chưa được Minh duyệt sửa thì ghi đúng trạng thái; không tự coi đã xử lý hoặc ép người làm sửa.
Chỉ ghi bản phản biện lượt mới được Minh cho phép theo tasks/_MAU/REVIEW.md, hoặc trả lời trong chat. Giữ lịch sử, không ghi LOG/STATE hay sửa thay người làm. Nêu bất đồng còn lại và soạn prompt để người làm đáp.
```

## Khối trọng tâm cổng

### G0 — MRP

```text
Đọc thêm docs/MRP.md, docs/WHY.md, docs/DECISIONS.md, docs/LESSONS.md.
1. Chuỗi gói việc P1–P10 có đi đúng chuỗi cô yêu cầu không
   (hiểu sâu phương pháp → nhiều dataset → hạn chế → 5 bước đồ thị → tích hợp sản phẩm)?
2. Có bước nào cô yêu cầu mà MRP bỏ sót hoặc hiểu sai không?
3. Cách hiểu "graph-based anomaly detection" ở MRP §2.3 có hợp lý không? Có cách hiểu nào tốt hơn không?
4. Câu hỏi nghiên cứu nào không trả lời được bằng dữ liệu dự kiến?
5. Có lựa chọn nào lặp lại một sai lầm trong LESSONS không? Có lựa chọn nào thiếu câu trả lời "tại sao" không?
```

### G1 — Phương pháp, dataset, cách chia

```text
Danh sách phương pháp có phủ đủ các họ không; hồ sơ kỹ thuật có đúng với bài và code gốc không
(kiểm ngẫu nhiên ít nhất 2 phương pháp); dataset đã chọn có phân xử được RQ1, RQ3 không;
cách chia dev/test có lộ đáp án không; có đường nào để nhãn lọt vào phương pháp không.
```

### G2 — Baseline và phân tích hạn chế

```text
Kiểm chuỗi đầu vào → xử lý → trung gian → đầu ra ở các nhóm quan trọng. Đọc code và trung gian đã lưu trước, đối chiếu ca sai với ca đúng có điều kiện tương ứng. Thiếu trung gian thì nêu đúng phần cần chạy/thu thêm, chi phí và quyết định phụ thuộc; không tự chạy ngoài quyền hoặc bỏ câu hỏi bằng “ngoài SPEC”.
Kết luận cơ chế phải chỉ được: trong điều kiện X, bước Y làm mất hoặc đánh giá sai thông tin Z. Nếu chưa xác định Y, giữ đúng quan sát, giải thích khác và bằng chứng thiếu.
Phân biệt dữ liệu/thiếu đầu vào, giao thức, adapter/cài đặt và giả định/cách tính; không cộng cờ chồng lấn thành tỷ lệ nguyên nhân. Hạn chế dữ liệu xác nhận có hệ quả đánh giá và yêu cầu quan sát FlashTicket có thể rút ra không?
Đầu ra có nêu: hạn chế đã xác nhận và điều kiện; lỗi cài đặt/thiếu đầu vào; hạn chế giả định/phép tính; quan hệ có thể bổ sung thông tin gì; câu chưa trả lời và bằng chứng còn thiếu? Căn cứ nào đủ đề xuất ứng viên, căn cứ nào đủ lựa chọn thiết kế?
Không bắt mọi task P4 làm xong đối chứng của phương pháp mới. Đối chứng bỏ quan hệ và quy tắc đơn giản trên cùng đồ thị dùng khi đánh giá tác dụng của việc dùng quan hệ; không là điều kiện trì hoãn mọi phân tích hạn chế baseline.
