# -*- coding: utf-8 -*-
"""T-063 — bộ xuất gói metric bổ sung cho M1-FT (H1–H5, H7). Chạy trên exp-obs: `python3 - --t <t> < xuat_bo_sung.py`
hoặc `python3 xuat_bo_sung.py --t <t> --ra <file>`. Chỉ ĐỌC Prometheus (localhost:9090). Không đọc nhãn/sổ tiêm.

Định dạng giống `cases/<id>/prometheus.json` của bộ đóng gói ghim T-058 (danh sách bundle {channel, native, query,
step_seconds, result, native_timestamps}), để `m1.adapter_flashticket.normalize_metrics` đọc được khi M1-FT khai thêm
kênh. Cửa sổ [t−300, t+300] (đủ cửa sổ phương pháp), bước 15 s như kênh không native của bộ ghim. Truy vấn theo khúc
≤ 10 phút (bài học sự cố 12/11 19:16Z), nghỉ 0,3 s giữa khúc; lỗi khúc được ghi, không dừng cả lượt.
"""
import argparse, json, sys, time, urllib.parse, urllib.request

B = 'http://localhost:9090/api/v1/'
R1 = '[1m]'
KENH = [
    # H2 — JVM/cgroup
    ('throttle', 'sum by(service_name) (rate(container_cpu_throttling_data_throttled_time_nanoseconds_total' + R1 + ')) / 1e9'),
    ('throttle-ratio', 'sum by(service_name) (rate(container_cpu_throttling_data_throttled_periods_total' + R1 + ')) / '
                       'sum by(service_name) (rate(container_cpu_throttling_data_periods_total' + R1 + '))'),
    ('gc', 'sum by(service_name) (rate(jvm_gc_duration_seconds_sum' + R1 + '))'),
    ('heap', 'sum by(service_name) (jvm_memory_used_bytes{jvm_memory_type="heap"})'),
    ('threads-blocked', 'sum by(service_name) (jvm_thread_count{jvm_thread_state="blocked"})'),
    ('jvm-cpu', 'sum by(service_name) (jvm_cpu_recent_utilization_ratio)'),
    # H3 — pool kết nối
    ('pool-pending', 'sum by(service_name) (db_client_connections_pending_requests)'),
    ('pool-used', 'sum by(service_name) (db_client_connections_usage{state="used"})'),
    ('pool-wait', 'sum by(service_name) (rate(db_client_connections_wait_time_milliseconds_sum' + R1 + ')) / '
                  'clamp_min(sum by(service_name) (rate(db_client_connections_wait_time_milliseconds_count' + R1 + ')), 1e-9)'),
    # H4 — queue (theo queue; gán thành phần do M1-FT quyết)
    ('queue-ready', 'sum by(rabbitmq_queue_name) (rabbitmq_message_current{state="ready"})'),
    ('queue-unacked', 'sum by(rabbitmq_queue_name) (rabbitmq_message_current{state="unacknowledged"})'),
    ('queue-consumers', 'sum by(rabbitmq_queue_name) (rabbitmq_consumer_count)'),
    ('queue-publish', 'sum by(rabbitmq_queue_name) (rate(rabbitmq_message_published_total' + R1 + '))'),
    ('queue-ack', 'sum by(rabbitmq_queue_name) (rate(rabbitmq_message_acknowledged_total' + R1 + '))'),
    # H5 — sống/chết (khe tín hiệu; uptime/restarts)
    ('restarts', 'sum by(service_name) (container_restarts_total)'),
    ('samples', 'count by(service_name) (count_over_time(jvm_cpu_recent_utilization_ratio' + R1 + '))'),
    # H5 — đầu dò hộp đen liveness (TD-04, từ 12/11 23:27Z): 1 = không phản hồi trong bước; ms phản hồi
    # live-down: httpcheck_status giữ trạng thái cũ khi request treo (D2 bản 2, PAUSE-PAYMENT) → dùng httpcheck_error
    ('live-down', 'max by(http_url) (httpcheck_error) or (0 * max by(http_url) (httpcheck_duration_milliseconds))'),
    ('live-ms', 'max by(http_url) (httpcheck_duration_milliseconds)'),
    # H7 — theo route
    ('route-rate', 'sum by(service_name, http_route) (rate(http_server_request_duration_seconds_count' + R1 + '))'),
    ('route-5xx', 'sum by(service_name, http_route) (rate(http_server_request_duration_seconds_count{http_response_status_code=~"5.."}' + R1 + '))'),
    # H1 — DB/cache theo thực thể
    ('pg-backends', 'sum by(postgresql_database_name) (postgresql_backends)'),
    ('pg-ops', 'sum by(postgresql_database_name) (rate(postgresql_operations_total' + R1 + '))'),
    ('redis-cmd', 'sum (rate(redis_commands_processed_total' + R1 + '))'),
    ('redis-clients', 'sum (redis_clients_connected)'),
]


def q_range(q, s, e, step):
    u = B + 'query_range?' + urllib.parse.urlencode({'query': q, 'start': s, 'end': e, 'step': step})
    r = json.load(urllib.request.urlopen(u, timeout=60))
    if r.get('status') != 'success':
        raise RuntimeError(str(r)[:200])
    return r['data']['result']


def main():
    ap = argparse.ArgumentParser(); ap.add_argument('--t', type=int, required=True); ap.add_argument('--ra')
    ap.add_argument('--step', type=int, default=15); ap.add_argument('--khuc', type=int, default=600)
    a = ap.parse_args()
    S, E = a.t - 300, a.t + 300
    out, loi = [], []
    for ch, q in KENH:
        gop = {}
        s = S
        while s <= E:
            e = min(E, s + a.khuc - a.step)
            try:
                for x in q_range(q, s, e, a.step):
                    k = json.dumps(x['metric'], sort_keys=True)
                    g = gop.setdefault(k, {'metric': x['metric'], 'values': []})
                    g['values'] += x['values']
            except Exception as ex:
                loi.append({'channel': ch, 'start': s, 'error': repr(ex)[:200]}); time.sleep(5)
            s = e + a.step
            time.sleep(0.3)
        res = []
        for g in gop.values():
            seen, vals = set(), []
            for t0, v in sorted(g['values'], key=lambda z: float(z[0])):
                if t0 not in seen:
                    seen.add(t0); vals.append([t0, v])
            res.append({'metric': g['metric'], 'values': vals})
        out.append({'channel': ch, 'native': False, 'query': q, 'step_seconds': a.step, 'result': res, 'native_timestamps': None})
    doc = {'phien_ban': 'T063-bo-sung-3', 't': a.t, 'cua_so': [S, E], 'loi_khuc': loi, 'bundles': out}
    txt = json.dumps(doc, ensure_ascii=False, separators=(',', ':')) + '\n'
    if a.ra:
        open(a.ra, 'w', encoding='utf-8').write(txt)
    else:
        sys.stdout.write(txt)
    sys.stderr.write(json.dumps({'kenh': len(out), 'chuoi': sum(len(b['result']) for b in out), 'loi_khuc': len(loi)}) + '\n')


main()
"""FlashTicket OTLP files + Prometheus API -> the unchanged seven-argument M1 API.

No ledger, scenario name, injected service, directory, or case ID is passed to M1.
This is an initial adapter, not an approved FlashTicket method or an evaluation.
Native gauge times come from timestamp(metric), not PromQL evaluation-grid times.
Derived RED series explicitly use their evaluation times as their source clock.
"""
from collections import Counter, defaultdict
from decimal import Decimal
import json
import math
from pathlib import Path
import re
import urllib.parse
import urllib.request

NS = 10**9
ALIASES = {'discovery-server': 'config-discovery'}
INFRA = {'postgres': 'postgresql-shared-instance', 'user-db': 'mongodb-instance',
         'redis': 'cache', 'rabbitmq': 'broker'}
CHANNELS = {'cpu': 'tài nguyên', 'mem': 'tài nguyên', 'db-size': 'tài nguyên',
            'workload': 'lưu lượng', 'error': 'lỗi',
            'latency-50': 'độ trễ', 'latency-90': 'độ trễ'}
TOTAL_RATE = 'sum by(service_name) (rate(http_server_request_duration_seconds_count[1m]))'
QUERIES = [
    {'channel': 'cpu', 'query': 'container_cpu_utilization_ratio', 'native': True},
    {'channel': 'mem', 'query': 'container_memory_usage_total_bytes', 'native': True},
    {'channel': 'db-size', 'query': 'postgresql_db_size_bytes', 'native': True},
    {'channel': 'workload', 'query': TOTAL_RATE, 'native': False},
    {'channel': 'error', 'query':
     'sum by(service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~"5.."}[1m])) '
     'or on(service_name) (0 * (' + TOTAL_RATE + '))', 'native': False},
    {'channel': 'latency-50', 'query':
     'histogram_quantile(0.5, sum by(le,service_name) (rate(http_server_request_duration_seconds_bucket[1m])))', 'native': False},
    {'channel': 'latency-90', 'query':
     'histogram_quantile(0.9, sum by(le,service_name) (rate(http_server_request_duration_seconds_bucket[1m])))', 'native': False},
]


def otlp_value(v):
    for name in ('stringValue', 'intValue', 'doubleValue', 'boolValue', 'bytesValue'):
        if name in v:
            return v[name]
    if 'kvlistValue' in v:
        return attributes(v['kvlistValue'].get('values', []))
    if 'arrayValue' in v:
        return [otlp_value(x) for x in v['arrayValue'].get('values', [])]
    return None


def attributes(items):
    return {x['key']: otlp_value(x['value']) for x in items}


def jsonl(paths):
    """Ignore only an unfinished final line of an actively appended JSONL file."""
    for path in sorted(map(Path, paths)):
        with path.open(encoding='utf-8') as stream:
            for line in stream:
                if not line.endswith('\n'):
                    continue
                yield json.loads(line)


def hex_id(value, width, root=False):
    if root and (value is None or value == '' or value == '0' * width):
        return ''
    if not isinstance(value, str) or not re.fullmatch('[0-9a-fA-F]{' + str(width) + '}', value):
        raise ValueError('Invalid OTLP hexadecimal ID')
    if value == '0' * width:
        raise ValueError('Invalid all-zero OTLP ID')
    return value.lower()


def _finite(value):
    try:
        number = float(value)
    except (ValueError, TypeError):
        return None
    return number if math.isfinite(number) else None


def _ns(seconds):
    return int(Decimal(str(seconds)) * NS)


def _owner(labels, inventory):
    db = labels.get('postgresql_database_name')
    if db:
        return db if db in inventory else None
    service = labels.get('service_name')
    service = ALIASES.get(service, INFRA.get(service, service))
    return service if service in inventory else None


def query_range(url, query, start, end, step=15):
    params = {'query': query, 'start': start, 'end': end, 'step': step}
    with urllib.request.urlopen(url.rstrip('/') + '/api/v1/query_range?' + urllib.parse.urlencode(params), timeout=45) as response:
        result = json.load(response)
    if result.get('status') != 'success' or result['data'].get('resultType') != 'matrix':
        raise ValueError('Prometheus range query did not return a successful matrix')
    return result['data']['result']


def collect_metrics(url, start, end, step=15):
    """Collector/runner calls this outside the M1 method; keep full API responses."""
    bundles = []
    for item in QUERIES:
        result = query_range(url, item['query'], start, end, step)
        clock = query_range(url, 'timestamp(' + item['query'] + ')', start, end, step) if item['native'] else None
        bundles.append(dict(item, step_seconds=step, result=result, native_timestamps=clock))
    return bundles


def _labels_key(labels):
    return tuple(sorted((k, v) for k, v in labels.items() if k != '__name__'))


def normalize_metrics(bundles, inventory):
    """Sparse rows, explicit native clock per channel/entity; no forward filling."""
    series = defaultdict(dict)
    identities = defaultdict(set)
    diagnostics = {'unmapped_series': [], 'empty_queries': [], 'nonfinite_points': 0,
                   'repeated_native_points': 0}
    steps = {}
    aliases = {}
    prefixes = {entity: entity.replace('_', '-') for entity in inventory}
    if len(set(prefixes.values())) != len(prefixes):
        raise ValueError('Inventory cannot be represented by collision-free metric prefixes')
    for entity, prefix in prefixes.items():
        if entity != prefix:
            if prefix in inventory and prefix != entity:
                raise ValueError('Metric prefix collides with another inventory entity')
            aliases[prefix] = entity
    for bundle in bundles:
        channel = bundle['channel']
        if channel not in CHANNELS:
            raise ValueError('Undeclared metric channel')
        result = bundle['result']
        if not result:
            diagnostics['empty_queries'].append(channel)
        clocks = {_labels_key(x['metric']): {str(t): v for t, v in x['values']}
                  for x in (bundle.get('native_timestamps') or [])}
        for item in result:
            labels = item['metric']
            owner = _owner(labels, inventory)
            if owner is None:
                diagnostics['unmapped_series'].append({'channel': channel, 'labels': labels})
                continue
            source = 'metric:' + channel + ':' + prefixes[owner]

