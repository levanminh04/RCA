+    def resolve(ident, level):
+        row = mapping_index.get((level, ident))
+        if row is None:
+            return None, 'unmapped'
+        candidates = sorted(set(row['candidates']))
+        if len(candidates) != 1:
+            return None, 'ambiguous_mapping' if candidates else 'unmapped'
+        if not row['verified']:
+            return None, 'unverified_mapping'
