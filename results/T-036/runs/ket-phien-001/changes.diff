+
+    def normalized(side, edge, position):
+        typ = edge['type']
+        if typ not in relation_types:
+            return None, 'outside_relation_domain'
+        if context['level'] == 'entity' and (typ == 'span-parent' or edge['source'] == edge['target']):
+            return None, 'not_entity_dependency'
