{
  "extensions": {
    "file_storage": {
      "directory": "/data/queue",
      "create_directory": true
    },
    "health_check": {
      "endpoint": "127.0.0.1:13133"
    }
  },
  "receivers": {
    "otlp": {
      "protocols": {
        "grpc": {
          "endpoint": "10.0.0.215:4317"
        },
        "http": {
          "endpoint": "10.0.0.215:4318"
        }
      }
    },
    "prometheus/self": {
      "config": {
        "scrape_configs": [
          {
            "job_name": "central-collector",
            "scrape_interval": "10s",
            "static_configs": [
              {
                "targets": [
                  "127.0.0.1:8888"
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "processors": {
    "memory_limiter": {
      "check_interval": "1s",
      "limit_mib": 640,
      "spike_limit_mib": 128
    },
    "batch": {
      "timeout": "1s",
      "send_batch_size": 1024
    },
    "resource/obs": {
      "attributes": [
        {
          "key": "host.id",
          "value": "exp-obs",
          "action": "upsert"
        },
        {
          "key": "service.name",
          "value": "central-collector",
          "action": "upsert"
        }
      ]
    }
  },
  "connectors": {
    "span_metrics": {
      "histogram": {
        "unit": "s"
      },
      "dimensions": [
        {
          "name": "http.route"
        },
        {
          "name": "http.request.method"
        }
      ],
      "metrics_flush_interval": "10s",
      "add_resource_attributes": true
    },
    "service_graph": {
      "dimensions": [
        "db.system.name",
        "messaging.system"
      ],
      "metrics_flush_interval": "10s",
      "store": {
        "ttl": "10s",
        "max_items": 50000
      }
    }
  },
  "exporters": {
    "otlp/tempo": {
      "endpoint": "127.0.0.1:14317",
      "tls": {
        "insecure": true
      },
      "retry_on_failure": {
        "enabled": true,
        "max_elapsed_time": "0s"
      },
      "sending_queue": {
        "enabled": true,
        "queue_size": 1000,
        "storage": "file_storage"
      }
    },
    "otlp_http/prometheus": {
      "endpoint": "http://127.0.0.1:9090/api/v1/otlp",
      "retry_on_failure": {
        "enabled": true,
        "max_elapsed_time": "0s"
      },
      "sending_queue": {
        "enabled": true,
        "queue_size": 1000,
        "storage": "file_storage"
      }
    },
    "otlp_http/loki": {
      "endpoint": "http://127.0.0.1:3100/otlp",
      "retry_on_failure": {
        "enabled": true,
        "max_elapsed_time": "0s"
      },
      "sending_queue": {
        "enabled": true,
        "queue_size": 1000,
        "storage": "file_storage"
      }
    },
    "file/traces": {
      "path": "/data/capture/traces.jsonl",
      "rotation": {
        "max_megabytes": 100,
        "max_backups": 20
      }
    },
    "file/logs": {
      "path": "/data/capture/logs.jsonl",
      "rotation": {
        "max_megabytes": 100,
        "max_backups": 10
      }
    },
    "file/metrics": {
      "path": "/data/capture/metrics.jsonl",
      "rotation": {
        "max_megabytes": 100,
        "max_backups": 20
      }
    }
  },
  "service": {
    "extensions": [
      "file_storage",
      "health_check"
    ],
    "telemetry": {
      "metrics": {
        "readers": [
          {
            "pull": {
              "exporter": {
                "prometheus": {
                  "host": "127.0.0.1",
                  "port": 8888
                }
              }
            }
          }
        ]
      }
    },
    "pipelines": {
      "traces": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "batch"
        ],
        "exporters": [
          "otlp/tempo",
          "span_metrics",
          "service_graph",
          "file/traces"
        ]
      },
      "metrics": {
        "receivers": [
          "otlp",
          "span_metrics",
          "service_graph"
        ],
        "processors": [
          "memory_limiter",
          "batch"
        ],
        "exporters": [
          "otlp_http/prometheus",
          "file/metrics"
        ]
      },
      "metrics/self": {
        "receivers": [
          "prometheus/self"
        ],
        "processors": [
          "resource/obs",
          "batch"
        ],
        "exporters": [
          "otlp_http/prometheus"
        ]
      },
      "logs": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "batch"
        ],
        "exporters": [
          "otlp_http/loki",
          "file/logs"
        ]
      }
    }
  }
}
