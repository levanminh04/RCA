"""Existing Keycloak client flows; credentials and tokens stay in memory."""
import base64
import hashlib
from html.parser import HTMLParser
import http.cookiejar
import json
from pathlib import Path
import secrets
import urllib.error
import urllib.parse
import urllib.request

ROOT=Path('/opt/flash-ticket-app')
def env(name='booking-service.env'):
    return dict(x.split('=',1) for x in (ROOT/'env'/name).read_text().splitlines() if x and not x.startswith('#'))

def internal_token():
    e=env()
    data=urllib.parse.urlencode({'grant_type':'client_credentials','client_id':'internal-service','client_secret':e['IN
TERNAL_SERVICE_CLIENT_SECRET']}).encode()
    with urllib.request.urlopen(e['KEYCLOAK_TOKEN_URI'],data=data,timeout=15) as response:
        return json.load(response)['access_token']

class Form(HTMLParser):
    def __init__(self):
        super().__init__(); self.action=None; self.fields={}; self.active=False
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if tag=='form' and a.get('id')=='kc-form-login':
            self.action=a.get('action'); self.active=True
        if tag=='input' and self.active and a.get('name'):
            self.fields[a['name']]=a.get('value','')
    def handle_endtag(self,tag):
        if tag=='form': self.active=False

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,req,fp,code,msg,headers,newurl):
        return None

def role_token(role='BUYER'):
    e=env(); issuer=e['KEYCLOAK_ISSUER_URI']
    users=json.loads((ROOT/'env/test-users.json').read_text())
    user=next(x for x in users if role in x.get('realmRoles',[]))
    verifier=secrets.token_urlsafe(48)
    challenge=base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip('=')
    state=secrets.token_urlsafe(24)
    # Use the realm's registered callback identifier, but intercept the 302
    # locally. No request is ever sent to this external callback host.
    redirect='https://oauth.pstmn.io/v1/callback'
    params={'response_type':'code','client_id':'frontend','redirect_uri':redirect,'scope':'openid profile email',
            'state':state,'code_challenge':challenge,'code_challenge_method':'S256'}
    cookies=http.cookiejar.CookieJar()
    opener=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cookies),NoRedirect())
    with opener.open(issuer+'/protocol/openid-connect/auth?'+urllib.parse.urlencode(params),timeout=15) as r:
        form=Form(); form.feed(r.read().decode())
    if not form.action or not form.action.startswith(issuer+'/'):
        raise RuntimeError('Expected same-realm login form')
    fields=form.fields|{'username':user['username'],'password':user['password'],'credentialId':''}
    try:
        with opener.open(form.action,data=urllib.parse.urlencode(fields).encode(),timeout=15) as response:
            raise RuntimeError('Login did not return authorization-code redirect')
    except urllib.error.HTTPError as response:
        if response.code not in [302,303]:
            raise RuntimeError('Login HTTP '+str(response.code)) from None
        location=response.headers['Location']
    if not location.startswith(redirect):
        raise RuntimeError('Unexpected login redirect origin')
    result=urllib.parse.parse_qs(urllib.parse.urlparse(location).query)
    if result.get('state') != [state] or 'code' not in result:
        raise RuntimeError('Authorization state/code missing')
    data=urllib.parse.urlencode({'grant_type':'authorization_code','client_id':'frontend','redirect_uri':redirect,
                                'code':result['code'][0],'code_verifier':verifier}).encode()
    with urllib.request.urlopen(issuer+'/protocol/openid-connect/token',data=data,timeout=15) as response:
        return json.load(response)['access_token']

def buyer_token():
    return role_token('BUYER')

if __name__=='__main__':
    for name,fn in [('internal-service',internal_token),('buyer via frontend PKCE',buyer_token)]:
        token=fn()
        claims=json.loads(base64.urlsafe_b64decode(token.split('.')[1]+'=='))
        print(json.dumps({'flow':name,'iss':claims['iss'],'aud':claims.get('aud'),'roles':claims.get('realm_access',{})
.get('roles',[])}))

import http from 'k6/http';
import exec from 'k6/execution';
import { check } from 'k6';
import { Counter } from 'k6/metrics';

if (__ENV.FT_TEST_ENVIRONMENT !== 'true') throw new Error('Isolated test environment required');
const fixtures = JSON.parse(open(__ENV.FT_FIXTURES_FILE));
const token = open(__ENV.FT_BUYER_TOKEN_FILE).trim();
const base = __ENV.FT_GATEWAY_URL;
const rate = Number(__ENV.FT_LOAD_RATE || 2);
const seconds = Number(__ENV.FT_LOAD_SECONDS || 60);
if (!Number.isInteger(rate) || rate < 1 || rate > 100 || seconds < 1 || seconds > 3600) {
  throw new Error('Declare a rate in 1..100 and duration in 1..3600 seconds');
}
if (!fixtures.events.length || !fixtures.orders.length) throw new Error('Prepared event/order fixtures required');
const accepted = new Counter('gateway_accepted');
const throttled = new Counter('gateway_throttled');
export const options = {
  scenarios: {
    common_routes: {
      executor: 'constant-arrival-rate', rate, timeUnit: '1s',
      duration: String(seconds) + 's', preAllocatedVUs: 4, maxVUs: 16,
      exec: 'readMix',
    },
  },
  summaryTrendStats: ['avg', 'p(95)', 'p(99)', 'max'],
};
export function readMix() {
  const iteration = exec.scenario.iterationInTest;
  const event = fixtures.events[iteration % fixtures.events.length];
  const order = fixtures.orders[iteration % fixtures.orders.length];
  const slot = iteration % 100;
  let path, route;
  if (slot < 50) {
    path = '/api/v1/events/' + event.eventId; route = 'GET /api/v1/events/{id}';
  } else if (slot < 75) {
    path = '/api/v1/orders/' + order.orderId; route = 'GET /api/v1/orders/{id}';
  } else if (slot < 90) {
    path = '/api/v1/orders/' + order.orderId + '/payment'; route = 'GET /api/v1/orders/{id}/payment';
  } else {
    path = '/api/v1/orders/' + order.orderId + '/tickets'; route = 'GET /api/v1/orders/{id}/tickets';
  }
  const response = http.get(base + path, {
    headers: { Authorization: 'Bearer ' + token },
    tags: { name: route, route },
    timeout: '35s',
  });
  if (response.status === 429) throttled.add(1, { route });
  else if (response.status >= 200 && response.status < 400) accepted.add(1, { route });
  check(response, { 'successful baseline response': value => value.status === 200 }, { route });
}
// No case name, injection state or answer label is sent to the application.
// Run the same fixture/route mix in all phases. Use fixtures.py separately on a declared,
// identical per-phase schedule for real payment/issuance/refund transactions.


exec
