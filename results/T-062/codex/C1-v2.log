+. "$PSScriptRoot/c1.ps1"
+
+function Start-Tai {
+ param([ValidateRange(1,3600)][int]$Seconds=300,[ValidateRange(1,100)][int]$Rate=5,
+       [Parameter(Mandatory=$true)][ValidatePattern('^[a-f0-9]{8,32}$')][string]$Tag,
+       [ValidateSet('obs','tai')][string]$May='obs')
+ Assert-C1Running
+ if(!(Test-Path "$script:C1Repo/results/T-062/ha-tang/A2-XONG")){throw 'A2-XONG is required'}
+ $config=Get-Content -Encoding UTF8 -Raw "$PSScriptRoot/k6/cau-hinh.json" | ConvertFrom-Json
+ $preflight=@'
+set -eu
+test -d /opt/rca-tai/secret
+test ! -e /opt/rca-tai/out/__TAG__
+test -z "$(sudo -n docker ps -q --filter name=rca-tai-)"
+'@
+ Invoke-C1 -May $May -Command $preflight.Replace('__TAG__',$Tag)
+ foreach($filename in @('workload-t062.js','fixtures.json','cau-hinh.json')){
+  Send-C1File -May $May -Source "$PSScriptRoot/k6/$filename" -Destination "/opt/rca-tai/k6/$filename"
+ }
+ $auth=Initialize-C1Token -May $May
+ $metadata=@{tag=$Tag;machine=$May;seconds=$Seconds;rate=$Rate;started_command_utc=[DateTime]::UtcNow.ToString('o');im
age=$config.image;
+   fixtures_sha256=(Get-FileHash -Algorithm SHA256 "$PSScriptRoot/k6/fixtures.json").Hash.ToLower();
+   workload_sha256=(Get-FileHash -Algorithm SHA256 "$PSScriptRoot/k6/workload-t062.js").Hash.ToLower();auth=$auth}
+ $encoded=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes(($metadata | ConvertTo-Json -Depth 5)))
+ $command=@'
+set -eu
+test ! -e /opt/rca-tai/out/__TAG__
+install -d -m 0755 /opt/rca-tai/out/__TAG__
+printf %s __METADATA__ | base64 -d > /opt/rca-tai/out/__TAG__/metadata.json
+sudo -n docker run -d --name rca-tai-__TAG__ --label rca.owner=T-062-C1 --network host --user "$(id -u):$(id -g)" \
+  --mount type=bind,src=/opt/rca-tai/k6,dst=/work/k6,readonly \
+  --mount type=bind,src=/opt/rca-tai/secret,dst=/work/secret,readonly \
+  --mount type=bind,src=/opt/rca-tai/out/__TAG__,dst=/out \
+  -e FT_TEST_ENVIRONMENT=true -e FT_MACHINE=__MAY__ -e FT_LOAD_SECONDS=__SECONDS__ -e FT_LOAD_RATE=__RATE__ \
+  __IMAGE__ run --quiet --out json=/out/raw.json /work/k6/workload-t062.js
+'@
+ $command=$command.Replace('__TAG__',$Tag).Replace('__METADATA__',$encoded).Replace('__MAY__',$May).Replace('__SECONDS
__',"$Seconds").Replace('__RATE__',"$Rate").Replace('__IMAGE__',$config.image)
+ Invoke-C1 -May $May -Command $command -Mutation
+}
+
+function Stop-Tai {
+ param([ValidateSet('obs','tai')][string]$May='obs')
+ $command=@'
+set -eu
+for id in $(sudo -n docker ps -q --filter name=rca-tai- --filter label=rca.owner=T-062-C1); do
+ sudo -n docker stop --time 45 "$id"
+done
+'@
+ Invoke-C1 -May $May -Command $command -Mutation -IgnoreStop
+}
+
+function Receive-Tai {
+ param([Parameter(Mandatory=$true)][ValidatePattern('^[a-f0-9]{8,32}$')][string]$Tag,
+       [ValidateSet('obs','tai')][string]$May='obs')
+ $command=@'
+set -eu
+test "$(sudo -n docker inspect rca-tai-__TAG__ --format '{{.State.Running}}')" = false
+sudo -n docker logs rca-tai-__TAG__ > /opt/rca-tai/out/__TAG__/console.txt 2>&1
+sudo -n docker inspect rca-tai-__TAG__ --format '{{json .State}}' > /opt/rca-tai/out/__TAG__/state.json
+cd /opt/rca-tai/out/__TAG__
+sha256sum raw.json summary.json metadata.json console.txt state.json > SHA256SUMS
+'@
+ Invoke-C1 -May $May -Command $command.Replace('__TAG__',$Tag) -Mutation -IgnoreStop
+ $target=Get-C1Target $May
+ $destination="$PSScriptRoot/out/$Tag"
+ if(Test-Path $destination){throw "Output exists: $destination (retain it)"}
+ New-Item -ItemType Directory -Path $destination -Force | Out-Null
+ & 'C:/Program Files/Git/usr/bin/scp.exe' -r -i $target.Key -o BatchMode=yes -o ConnectTimeout=15 -o 
StrictHostKeyChecking=yes "-oUserKnownHostsFile=$($target.Known)" "ubuntu@$($target.HostName):/opt/rca-tai/out/$Tag/." 
$destination
+ if($LASTEXITCODE -ne 0){throw 'Receive failed; partial output retained'}
+ foreach($line in Get-Content "$destination/SHA256SUMS"){
+  $parts=$line -split '\s+',2
+  if((Get-FileHash -Algorithm SHA256 -LiteralPath "$destination/$($parts[1])").Hash.ToLower() -ne $parts[0]){throw 
'Received hash mismatch'}
+ }
+ Get-Item $destination
+}
diff --git a/results/T-062/tai/doc-fixture.py b/results/T-062/tai/doc-fixture.py
new file mode 100644
index 0000000000000000000000000000000000000000..af2862166190ff284b07f37708eb7083ce4d0177
--- /dev/null
+++ b/results/T-062/tai/doc-fixture.py
@@ -0,0 +1,50 @@
+"""Read-only fixture discovery on exp-obs; stdout contains no credentials."""
+import datetime
+import json
+from pathlib import Path
+from urllib.request import Request, urlopen
+from urllib.error import HTTPError
+
+base = 'http://10.0.0.158:8081'
+tokens = json.loads(Path('/opt/rca-tai/secret/tokens.json').read_text())
+evidence = []
+
+def get(route, authenticated=False):
+    headers = {'Authorization': 'Bearer '+tokens['access_token']} if authenticated else {}
+    try:
+        with urlopen(Request(base+route, headers=headers), timeout=20) as r:
+            body = json.load(r)
+            evidence.append({'path': route, 'status': r.status})
+            return body.get('data', body) if isinstance(body, dict) else body
+    except HTTPError as e:
+        evidence.append({'path': route, 'status': e.code})
+        return None
+
+try:
+    listing = get('/api/v1/events')
+    rows = listing.get('items', []) if isinstance(listing, dict) else listing
+    events = []
+    for event in (rows or [])[:3]:
+        eid = event.get('eventId') or event.get('id')
+        if not eid:
+            continue
+        details = get('/api/v1/events/'+eid)
+        if details:
+            events.append({'eventId': eid, 'ticketTypes': [
+                {'ticketTypeId': x.get('ticketTypeId'), 'unitPrice': x.get('unitPrice')}
+                for x in details.get('ticketTypes', [])]})
+    # Candidate ID is a lookup key from a prior smoke receipt, not assumed valid.
+    # OrderController has no buyer listing endpoint. Verify ownership through the API.
+    orders = []
+    for oid in ['b16ae2e8-3893-466d-94eb-08ace3a9ace2',
+                '7106a688-f746-4f16-910b-d138dbdfbea7',
+                'efdf1e2b-a04f-4197-81bb-3cba86eaba27']:
+        order = get('/api/v1/orders/'+oid, True)
+        if order:
+            orders.append({'orderId': oid, 'state': order.get('state')})
+            get('/api/v1/orders/'+oid+'/payment', True)
+            get('/api/v1/orders/'+oid+'/tickets', True)
+    print(json.dumps({'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                      'events': events, 'orders': orders, 'checks': evidence}))
+except Exception:
+    raise SystemExit('Fixture discovery failed; no response bodies or credentials logged')
