diff --git a/results/T-062/tai/k6/workload-t062.js b/results/T-062/tai/k6/workload-t062.js
new file mode 100644
index 0000000000000000000000000000000000000000..a42ebb9bfdb3844ea74d84d557725223ca6b2ea3
--- /dev/null
+++ b/results/T-062/tai/k6/workload-t062.js
@@ -0,0 +1,97 @@
+import http from 'k6/http';
+import exec from 'k6/execution';
+import { check } from 'k6';
+import { Counter, Trend } from 'k6/metrics';
+
+if (__ENV.FT_TEST_ENVIRONMENT !== 'true') throw new Error('Isolated environment required');
+const machine = __ENV.FT_MACHINE || 'obs';
+if (!['obs', 'tai'].includes(machine)) throw new Error('FT_MACHINE must be obs or tai');
+const host = machine === 'obs' ? '10.0.0.158' : '129.221.208.47';
+const base = __ENV.FT_GATEWAY_URL || `http://${host}:8081`;
+const issuer = __ENV.FT_KEYCLOAK_URL || `http://${host}:8080/realms/flash-ticket`;
+if (base !== `http://${host}:8081` || issuer !== `http://${host}:8080/realms/flash-ticket`) {
+  throw new Error('Only approved isolated endpoints allowed');
+}
+const fixtures = JSON.parse(open(__ENV.FT_FIXTURES_FILE || '/work/k6/fixtures.json'));
+const seed = JSON.parse(open('/work/secret/tokens.json'));
+const rate = Number(__ENV.FT_LOAD_RATE || 5);
+const seconds = Number(__ENV.FT_LOAD_SECONDS || 300);
+if (!Number.isInteger(rate) || rate < 1 || rate > 100 || !Number.isInteger(seconds) || seconds < 1 || seconds > 3600) 
{
+  throw new Error('Rate must be 1..100 and duration 1..3600 seconds');
+}
+if (!fixtures.events.length || !fixtures.orders.length) throw new Error('Prepared fixtures required');
+
+const refreshCount = new Counter('token_refresh_success');
+const refreshFail = new Counter('token_refresh_failure');
+const responses = new Counter('route_responses');
+const latency = new Trend('route_duration_ms', true);
+const unauthorized = new Counter('gateway_401');
+const accepted = new Counter('gateway_accepted');
+const throttled = new Counter('gateway_throttled');
+let credentials;
+
+export const options = {
+  scenarios: { common_routes: {
+    executor: 'constant-arrival-rate', rate, timeUnit: '1s', duration: `${seconds}s`,
+    preAllocatedVUs: 4, maxVUs: 16, exec: 'readMix', gracefulStop: '40s',
+  } },
+  summaryTrendStats: ['avg', 'p(95)', 'p(99)', 'max'],
+  // Raw data still includes status=0 network failures, auth requests, and dropped iterations.
+  thresholds: { token_refresh_failure: ['count==0'], gateway_401: ['count==0'] },
+};
+
+function refresh(token) {
+  const response = http.post(`${issuer}/protocol/openid-connect/token`, {
+    grant_type: 'refresh_token', client_id: 'frontend', refresh_token: token,
+  }, { tags: { name: 'Keycloak refresh', operation: 'token_refresh' },
+    redirects: 0, timeout: '15s', responseCallback: http.expectedStatuses(200) });
+  let body;
+  try { body = response.json(); } catch (_) { body = {}; }
+  if (response.status !== 200 || !body.access_token || !body.refresh_token) {
+    refreshFail.add(1);
+    // Do not log the body or include token values in exceptions.
+    exec.test.abort(`Token refresh failed (HTTP ${response.status}); renew PKCE session before next run`);
+  }
+  refreshCount.add(1);
+  return { access: body.access_token, refresh: body.refresh_token,
+    at: Date.now(), expires: Number(body.expires_in || 300) };
+}
+
+export function setup() {
+  refreshFail.add(0);
+  unauthorized.add(0);
+  return refresh(seed.refresh_token);
+}
+
+export function readMix(initial) {
+  if (!credentials) credentials = { ...initial };
+  if ((Date.now() - credentials.at) / 1000 >= Math.min(200, credentials.expires - 60)) {
+    credentials = refresh(credentials.refresh);
+  }
+  const iteration = exec.scenario.iterationInTest;
+  const event = fixtures.events[iteration % fixtures.events.length];
+  const order = fixtures.orders[iteration % fixtures.orders.length];
+  const slot = iteration % 100;
+  let path, route;
+  if (slot < 50) { path = `/api/v1/events/${event.eventId}`; route = 'GET /api/v1/events/{id}'; }
+  else if (slot < 75) { path = `/api/v1/orders/${order.orderId}`; route = 'GET /api/v1/orders/{id}'; }
+  else if (slot < 90) { path = `/api/v1/orders/${order.orderId}/payment`; route = 'GET /api/v1/orders/{id}/payment'; }
+  else { path = `/api/v1/orders/${order.orderId}/tickets`; route = 'GET /api/v1/orders/{id}/tickets'; }
+  const response = http.get(base + path, {
+    headers: { Authorization: 'Bearer ' + credentials.access },
+    tags: { name: route, route, operation: 'workload' }, redirects: 0, timeout: '35s',
+  });
+  const status = response.status;
+  const statusClass = status === 0 ? 'network' : `${Math.floor(status / 100)}xx`;
+  responses.add(1, { route, status: String(status), status_class: statusClass });
+  latency.add(response.timings.duration, { route });
+  if (status === 401) unauthorized.add(1, { route });
+  if (status === 429) throttled.add(1, { route });
+  else if (status >= 200 && status < 400) accepted.add(1, { route });
+  check(response, { 'successful baseline response': r => r.status === 200 }, { route });
+}
+
+export function handleSummary(data) {
+  return { '/out/summary.json': JSON.stringify(data, null, 2) + '\n' };
