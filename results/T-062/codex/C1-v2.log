+ if(!$IgnoreStop){Assert-C1Running}
+ if($May -eq 'app' -and $Mutation){throw 'exp-app is read-only'}
+ $target=Get-C1Target $May
+ if($Mutation){Add-Content -Encoding UTF8 "$script:C1Root/thay-doi-may-tai.md" ("`n## 
"+[DateTime]::UtcNow.ToString('o')+" — $May`n`n"+'```sh'+"`n$Command`n"+'```')}
+ $encoded=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($Command))
+ & $script:C1Ssh -i $target.Key -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=yes 
"-oUserKnownHostsFile=$($target.Known)" "ubuntu@$($target.HostName)" ('printf %s '+$encoded+' | base64 -d | bash')
+ $exit=$LASTEXITCODE
+ if($Mutation){Add-Content -Encoding UTF8 "$script:C1Root/thay-doi-may-tai.md" "`nExit: $exit"}
+ if($exit -ne 0){throw "SSH $May exit $exit"}
+}
+function Send-C1File {
