+// C1 SSH orchestration. Tokens only cross captured process pipes.
+import fs from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {spawnSync} from 'node:child_process';
+import crypto from 'node:crypto';
+export const root=path.dirname(fileURLToPath(import.meta.url));
+export const repo=path.resolve(root,'../../..');
+const ssh='C:/Program Files/Git/usr/bin/ssh.exe';
+const hosts={
+ tai:['3.24.8.49','D:/RCA-ext/keys/Hahaa123.pem','D:/RCA-ext/keys/known_hosts'],
+ obs:['213.35.116.128','D:/RCA-ext/keys/exp-obs/ssh-key-2026-11-10.key','D:/RCA-ext/overnight-T058/out/known_hosts'],
+ app:['129.221.208.47','D:/RCA-ext/keys/exp-app/ssh-key-2026-11-10 
(1).key','D:/RCA-ext/overnight-T058/out/known_hosts']
+};
+export const utc=()=>new Date().toISOString();
+export function checkStop(){if(fs.existsSync('D:/RCA-overnight/STOP'))throw Error('STOP exists');}
+export function quote(s){return "'"+s.replaceAll("'","'\"'\"'")+"'";}
+export function remote(may,command,{input,secret=false,mutation=false,ignoreStop=false}={}){
+ if(!ignoreStop)checkStop();
+ if(may==='app'&&mutation)throw Error('exp-app is read-only');
+ const log=path.join(root,'thay-doi-may-tai.md');
+ if(mutation)fs.appendFileSync(log,`\n## ${utc()} — ${may}\n\n\`\`\`sh\n${command}\n\`\`\`\n`);
+ const [host,key,known]=hosts[may];
+ const wrapped='bash -c "$(printf %s '+Buffer.from(command).toString('base64')+' | base64 -d)"';
+ const p=spawnSync(ssh,['-i',key,'-o','BatchMode=yes','-o','ConnectTimeout=15','-o','StrictHostKeyChecking=yes','-o','
UserKnownHostsFile='+known,'ubuntu@'+host,wrapped],{input,maxBuffer:100*1024*1024});
+ if(mutation)fs.appendFileSync(log,`\nExit: ${p.status}\n`);
+ if(p.status!==0){if(!secret)process.stderr.write(p.stderr||'');throw Error('SSH '+may+' exit '+p.status);}
+ return p.stdout;
+}
+export function auth(may){
+ let source=fs.readFileSync(path.join(repo,'results/T-058/dem-2026-11-10/auth.py'),'utf8');
+ source=source.slice(0,source.indexOf("if __name__=='__main__':"));
+ source=source.replaceAll("return json.load(response)['access_token']",'return json.load(response)');
+ source+='\ntry:\n    print(json.dumps(role_token()))\nexcept Exception:\n    raise SystemExit(1)\n';
+ const value=remote('app','python3 -c '+quote(source),{secret:true});
+ const tokens=JSON.parse(value);
+ if(!tokens.access_token||!tokens.refresh_token)throw Error('PKCE response incomplete');
+ remote(may,'umask 077; cat > /opt/rca-tai/secret/tokens.json',{input:value,secret:true,mutation:true});
+ return {utc:utc(),machine:may,flow:'PKCE',expires_in:tokens.expires_in,refresh_expires_in:tokens.refresh_expires_in};
+}
+export function upload(may){
+ for(const filename of ['k6/workload-t062.js','k6/fixtures.json','k6/cau-hinh.json']){
+  remote(may,'cat > /opt/rca-tai/'+filename,{input:fs.readFileSync(path.join(root,filename)),mutation:true});
+ }
+}
+const args=process.argv.slice(2);
+if(args.length&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+ const get=(flag,def)=>args.includes(flag)?args[args.indexOf(flag)+1]:def;
+ const may=get('--may','obs');
+ try{
+  if(args[0]==='auth')console.log(JSON.stringify(auth(may)));
+  else if(args[0]==='upload')upload(may);
+  else if(args[0]==='command'){
+   const 
output=remote(may,fs.readFileSync(get('--file'),'utf8').replace(/^\uFEFF/,''),{mutation:args.includes('--mutation')});
+   if(get('--out'))fs.writeFileSync(get('--out'),output);else process.stdout.write(output);
+  }else throw Error('Unknown action');
+ }catch(e){console.error(e.message);process.exitCode=1;}
+}
