package com.flashticket.booking_service.order.controller;

import com.flashticket.booking_service.dto.request.ApplyPromotionRequest;
import com.flashticket.booking_service.dto.request.CreateOrderRequest;
import com.flashticket.booking_service.dto.response.OrderView;
import com.flashticket.booking_service.exception.BusinessException;
import com.flashticket.booking_service.exception.ErrorCode;
import com.flashticket.booking_service.order.service.OrderService;
import com.flashticket.booking_service.promotion.service.PromotionService;
import jakarta.validation.Valid;
import java.net.URI;
import java.util.Map;
import java.util.UUID;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/v1/orders")
@RequiredArgsConstructor
public class OrderController {
  private final OrderService orderService;
  private final PromotionService promotionService;

  @GetMapping("/{orderId}")
  public ResponseEntity<OrderView> getOrder(
      @AuthenticationPrincipal Jwt jwt, @PathVariable UUID orderId) {
    return ResponseEntity.ok(orderService.getOrder(jwt.getSubject(), orderId));
  }

  @PostMapping("/{orderId}/cancel")
  public ResponseEntity<OrderView> cancelOrder(
      @AuthenticationPrincipal Jwt jwt,
      @PathVariable UUID orderId,
      @RequestBody Map<String, Object> request) {
    if (!request.isEmpty()) throw new BusinessException(ErrorCode.INVALID_REQUEST);
    return ResponseEntity.ok(orderService.cancelOrder(jwt.getSubject(), orderId));
  }

  @PostMapping("/{orderId}/promotion")
  public ResponseEntity<OrderView> applyPromotionToOrder(
      @AuthenticationPrincipal Jwt jwt,
      @PathVariable UUID orderId,
      @Valid @RequestBody ApplyPromotionRequest request) {
    return ResponseEntity.ok(
        promotionService.applyPromotionToOrder(jwt.getSubject(), orderId, request));
  }

  @PostMapping
  public ResponseEntity<OrderView> createOrder(
      @AuthenticationPrincipal Jwt jwt,
      @RequestHeader("Idempotency-Key") UUID idempotencyKey,
      @Valid @RequestBody CreateOrderRequest request) {
    OrderView order = orderService.createOrder(jwt.getSubject(), idempotencyKey, request);
    return ResponseEntity.created(URI.create("/api/v1/orders/" + order.getOrderId())).body(order);
  }
}

# Chương trình nghiên cứu RCA (MRP v3)

- Trạng thái: **đã duyệt G0 ngày 02/10/2026 (Q-36)**. Soạn ngày 02/10/2026.
- Thay thế hoàn toàn MRP v1 và MRP-v2. Hai bản cũ chỉ còn giá trị lịch sử; không dùng khung của chúng.
- Người quyết: Minh. Claude và Codex ngang hàng; vai trò người làm và người phản biện gắn theo từng task (Q-13).
- Bổ sung cách phân tích hạn chế, căn cứ thiết kế và bàn giao phản biện ngày 09/10/2026 (Q-88). Giữ lịch sử duyệt G0 
và các task đã đóng; không tự mở lại hoặc đổi kết quả của chúng.

## 0. Tóm tắt một đoạn

Phần RCA đi đúng chuỗi cô yêu cầu, không nhảy cóc. Trước hết hiểu sâu kỹ thuật các phương pháp RCA đã có. Sau đó chạy 
chúng trên nhiều bộ dữ liệu công khai và chỉ ra chúng hỏng ở đâu, vì sao. Sau phân tích hạn chế, thiết kế phương pháp 
đồ thị theo năm bước của cô; thành phần sửa hạn chế nối với bằng chứng P4, các thành phần khác ghi đúng căn cứ DT18 
hoặc nhu cầu kỹ thuật (WHY-01, Q-89). Cuối cùng đưa phương pháp vào FlashTicket, vừa để demo vừa làm một bộ dữ liệu 
thực nghiệm có tiêm lỗi. Kết quả báo trung thực, kể cả khi đồ thị không thắng; cô sẽ định hướng tiếp qua các lần báo 
cáo tiến độ.

## 1. Căn cứ

| Nguồn | Nội dung dùng | File |
|---|---|---|
| Đề tài DT18 | Tên đề tài; NV2: nút là dịch vụ hoặc thành phần, cạnh là gọi hàm, thông điệp, phụ thuộc dữ liệu; log, 
trace, metrics ánh xạ lên đồ thị để xác định vùng ảnh hưởng, phát hiện bất thường, xếp hạng nguyên nhân gốc; NV3: thực 
nghiệm trên dữ liệu công khai trước, rồi trên hệ bán vé | `reference/sources/DT18-de-tai-va-nhiem-vu.md` |
| Hướng dẫn của cô | Nhận xét báo cáo, chuỗi 4 việc, 5 bước phương pháp, phần tích hợp sản phẩm | 
`reference/sources/advisor-2026-09-23.md` |
| Quyết định của Minh ngày 02/10 | Mốc, dataset, tiêu chí thành công, repo, vai trò agent, kho quan sát | 
`DECISIONS.md` |
| Bài học v1/v2 | Các sai lầm không được lặp lại | `LESSONS.md` (rút gọn), `reference/LESSONS-v1.md` (đầy đủ) |
| Kiến thức nền (đã lọc, chưa kiểm lại) | Phương pháp (K1), dữ liệu RE2-TT và checklist kiểm dataset (K2), dataset ứng 
viên (K3), ba họ thuật toán (K4) | `knowledge/` |

Bối cảnh hệ thống: FlashTicket có 5 service nghiệp vụ (event, booking, payment, ticket, user), API Gateway, broker, 
cache, Keycloak, cấu hình và khám phá dịch vụ; payment-service điều phối Saga. Ba bạn dựng hệ thống song song với phần 
RCA. RCA là đơn vị triển khai riêng, chỉ đọc kho quan sát. Kho quan sát đã duyệt làm baseline nhưng chưa chạy: OTel 
Java Agent → OTel Collector → Tempo (trace), Loki (log), Prometheus (metric), Grafana để xem. Stack có thể đổi nếu RCA 
cần.

## 2. Đọc hướng dẫn của cô thành việc cụ thể

### 2.1 Chuỗi bốn việc cô yêu cầu

| Câu của cô | Cách hiểu | Gói việc |
|---|---|---|
| "mới khảo sát sơ qua..., chưa sâu kỹ thuật của từng phương pháp" | Với mỗi phương pháp đã chọn: viết lại cơ chế bằng 
công thức, đọc code gốc, chạy tay trên một ca, nêu giả định và điều kiện thất bại | P1 |
| "thực nghiệm với 1 dataset → mở rộng ra các dataset public khác" | Chọn thêm dataset theo tiêu chí, chạy cùng các 
phương pháp trên cùng giao thức | P2, P3 |
| "chỉ ra vấn đề còn tồn đọng, hạn chế" | Hạn chế phải có bằng chứng: ca nào hỏng, phương pháp nào, cơ chế nào gây ra 
| P4 |
| "tiếp cận phương pháp đồ thị theo 5 bước" | Sau P4, thiết kế phương pháp đồ thị theo năm bước; thành phần sửa hạn 
chế nối với bằng chứng P4, các thành phần khác ghi đúng căn cứ DT18 hoặc nhu cầu kỹ thuật (WHY-01) | P5–P8 |
| Phần 2: tích hợp vào hệ thống đặt vé | RCA chạy thật trên FlashTicket; demo tập trung vào phát hiện và chẩn đoán sự 
cố | P9, P10 |

**Vì sao giữ đúng thứ tự này** (WHY-01): cô phê bản trước "chưa thể hiện rõ liên kết logic". Liên kết logic ở đây là: 
hiểu cơ chế → thấy cơ chế hỏng ở đâu trên dữ liệu → thành phần đề xuất để xử lý hạn chế phải có lý do kỹ thuật nối với 
chỗ hỏng ấy. Thành phần đáp ứng DT18 hoặc nhu cầu kỹ thuật phải ghi đúng lý do đó, không dựng một hạn chế để hợp thức 
hóa. v1 và v2 thiết kế phương pháp trước rồi mới tìm chỗ nó có ích (LESSONS SL1, SL22). Làm ngược lại thì không có câu 
trả lời cho "tại sao phương pháp có thành phần này".

### 2.2 Năm bước phương pháp

| Bước của cô | Gói | Đầu ra |
|---|---|---|
| 1. Mô hình đồ thị phụ thuộc giữa các dịch vụ | P5 | Đặc tả đồ thị có kiểu nút, kiểu cạnh; bộ dựng đồ thị từ trace và 
từ kiến trúc |
| 2. Graph-based anomaly detection, ánh xạ log/trace lên đồ thị; ví dụ PageRank anomaly, subgraph anomaly detection, 
GNN-based | P6 | Phương pháp phát hiện, khoanh vùng, xếp hạng chạy trên đồ thị |
| 3. Thử nghiệm trên dataset công khai | P7 (dùng dataset của P2) | Kết quả trên tập test và dataset giữ ngoài |
| 4. So với RCA cơ sở; Precision, Recall, F1, MRR, NDCG | P7 (dùng baseline của P3) | Bảng so sánh có khoảng tin cậy, 
tách theo điều kiện |
| 5. LLM diễn giải nguyên nhân và gợi ý xử lý | P8 | Lớp giải thích và đánh giá của nó |

### 2.3 Cách hiểu "graph-based anomaly detection" (WHY-02)

Minh quyết không hỏi cô lúc này, tự chọn cách hiểu tốt nhất rồi báo cáo. Cụm từ này có hai nghĩa:

- **Nghĩa hẹp:** đồ thị tham gia trực tiếp vào việc tính điểm bất thường.
- **Nghĩa rộng:** cả chuỗi phát hiện → khoanh vùng → xếp hạng chạy trên đồ thị, dù bước phát hiện có thể cục bộ.

K1 §D.3 ghi một phản ví dụ quan trọng: MicroRCA và MicroRank chỉ dùng PageRank **sau khi** đã phát hiện bất thường cục 
bộ, nên đồ thị không tham gia việc phát hiện. Nếu chỉ làm theo nghĩa rộng, cô hỏi "đồ thị phát hiện bất thường ở đâu?" 
sẽ không trả lời được.

**Chọn:** thiết kế thỏa cả hai nghĩa. Đồ thị tham gia vào điểm bất thường (tầng 2 ở P6). Cả chuỗi khoanh vùng và xếp 
hạng cũng chạy trên đồ thị (tầng 3, 4). Khung bốn tầng là ứng viên để tổ chức thiết kế, không phải yêu cầu của DT18; 
thành phần cụ thể chọn sau P4 (WHY-02). Ba ví dụ của cô được đặt vào đúng tầng mà tài liệu dùng chúng:

**Hai mức phát hiện** (Minh duyệt hướng ngày 22/10/2026, M-38 trong `docs/KE-HOACH-GIAI-DOAN-TOI.md`):
- **Mức hệ thống, tức có sự cố hay không:** luật cảnh báo của Grafana mở sự cố. Ngưỡng chọn trên đoạn bình thường, 
không dùng nhãn.
- **Mức thành phần, tức thành phần nào bất thường:** lúc chẩn đoán, đồ thị tham gia tính điểm bất thường của từng 
thành phần và tách bất thường tự sinh khỏi bất thường kế thừa (tầng 2 ở P6). Nghĩa hẹp ở trên được đáp ứng ở mức này.
- **Đồ thị tham gia quyết định báo động** (điểm toàn hệ tính trên đồ thị, hoặc đồ thị gom các cảnh báo cùng một nguyên 
nhân): hoãn. Chỉ làm nếu cô yêu cầu, hoặc Minh quyết sau khi phương pháp RCA đã chạy trên dev (M-20).

| Ví dụ của cô | Tầng | Lý do |
|---|---|---|
| Subgraph anomaly detection | Tầng 3: đồ thị con bất thường → vùng nghi ngờ | DT18 yêu cầu "xác định vùng ảnh hưởng". 
Các phần tử bất thường liên thông chỉ là vùng triệu chứng quan sát được, chưa chắc là vùng ảnh hưởng thật: thành phần 
gốc không có cạnh hoặc không có tín hiệu có thể nằm ngoài; hai bất thường độc lập có thể nằm liền nhau. Vì vậy gọi là 
"vùng nghi ngờ" cho tới khi có nhãn vùng để kiểm. Chỉ gọi bước này là subgraph anomaly detection khi có định nghĩa 
điểm bất thường và quy tắc quyết định cho đồ thị con |
| PageRank anomaly | Tầng 4: xếp hạng nguyên nhân | Trong MicroRCA và MicroRank, PageRank là thuật toán xếp hạng, 
không phải bộ phát hiện bất thường (K1 §E). MicroRCA chạy PageRank cá nhân hóa trên đồ thị con bất thường. MicroRank 
chạy PageRank trên đồ thị của trace bình thường và của trace bất thường, dùng kết quả làm trọng số cho spectrum 
analysis (phân tích phổ: so mức xuất hiện của từng thành phần trong trace bình thường và bất thường), rồi mới tính 
điểm nghi ngờ (K1 §C.3). Chỉ gọi là "PageRank anomaly" khi có điểm lệch so với PageRank lúc bình thường và ngưỡng rõ. 
Chọn biến thể sau P1 và P4 |
| GNN-based anomaly detection | Một biến thể của tầng 2 | Chỉ làm nếu thỏa tiêu chí ở WHY-10; nếu không, báo cáo nêu 
lý do bằng bằng chứng |

Ba thuật toán là ví dụ, không phải danh sách bắt buộc phải cài hết (Q-24). Mỗi thuật toán được làm khi có câu hỏi cần 
nó trả lời.

## 3. Câu hỏi nghiên cứu

Không câu nào giả định đồ thị sẽ thắng (Minh quyết 02/10: báo kết quả trung thực).

- **RQ1 — Phương pháp đã có.** Các phương pháp phát hiện bất thường và các phương pháp RCA tiêu biểu hoạt động theo cơ 
chế nào, và kết quả của chúng thay đổi thế nào giữa các dataset, loại lỗi và vị trí của service gốc trong đồ thị? → 
P1, P2, P3.
- **RQ2 — Hạn chế.** Các phương pháp đó (cả phát hiện lẫn RCA) thất bại ở những ca nào và vì cơ chế nào? → P4.
- **RQ3 — Phương pháp đồ thị.** Một phương pháp ánh xạ log, trace, metric lên đồ thị phụ thuộc để phát hiện, khoanh 
vùng và xếp hạng có khắc phục được các hạn chế ở RQ2 không, khi so với baseline mạnh nhất trên dữ liệu không dùng lúc 
thiết kế? → P5, P6, P7.
  - RQ3a: phát hiện sự cố (Precision, Recall, F1).
  - RQ3b: xếp hạng nguyên nhân gốc (MRR, NDCG, Hit@k).
  - RQ3c: vùng ảnh hưởng (Precision, Recall, F1), ở nơi có nhãn.
  - RQ3d: phần thay đổi có đến từ việc dùng quan hệ không, so với nhánh cùng tín hiệu bỏ quan hệ; và có hơn quy tắc 
đơn giản trên cùng đồ thị không (ví dụ chọn thành phần bất thường sâu nhất hoặc sớm nhất)? Không có đối chứng đồ thị 
ngẫu nhiên, nên RQ3d không trả lời việc lợi ích có đến từ cấu trúc phụ thuộc thật hay không (đối chứng ở §6).
- **RQ4 — Giải thích.** LLM nhận bằng chứng có cấu trúc đồ thị có cho giải thích đúng, trung thành với bằng chứng và 
gợi ý xử lý dùng được hơn khi chỉ nhận bằng chứng dạng danh sách không? → P8.
- **RQ5 — Áp dụng trên FlashTicket.** Kết quả có giữ được trên một hệ khác các hệ trong dataset, với lỗi tự tiêm và 
tải thay đổi không? → P10.
  - Câu phụ (đề xuất **chưa kiểm**, chờ dữ liệu FlashTicket): flash sale làm tải tăng đột biến từ cổng vào; sự cố 
thường bắt đầu ở một thành phần rồi lan ngược lên phía gọi. Nếu giả định này đúng, hướng lan trên đồ thị có thể giúp 
phân biệt "tải tăng" với "sự cố". Giả định sai khi tải làm cạn tài nguyên ở một service (lúc đó tải gây ra sự cố 
thật). Dataset công khai thường giữ tải đều nên không kiểm được câu này; chỉ FlashTicket kiểm được.

Phát hiện bất thường không phải phần phụ của RCA: nó có hồ sơ phương pháp, baseline, độ đo và phân tích hạn chế riêng 
ở mọi gói (Q-30).

**Hoàn thành nghĩa là gì:** mỗi RQ có câu trả lời dựa trên phép thử hợp lệ, kèm điều kiện nó đúng và không đúng, và lý 
do (cơ chế) của kết quả, dù tốt hay xấu (Q-35). "Đồ thị không giúp ở X, vì Y" là một câu trả lời hợp lệ.

Đóng một task có đầu ra mô tả không tự trả lời xong RQ2 hoặc cho đủ căn cứ chọn thiết kế. Khi dữ liệu chưa phân xử 
được cơ chế, nêu câu còn mở, phần bằng chứng đã có, phần thiếu, phép kiểm cần thiết hoặc giới hạn không thể khắc phục 
với dữ liệu hiện tại, cùng quyết định bị ảnh hưởng. Không buộc mọi ca sai phải có chứng minh nhân quả tuyệt đối; cần 
phân biệt các giải thích dẫn tới lựa chọn nghiên cứu khác nhau ở những nhóm quan trọng.

| Mục đích dùng bằng chứng | Mức căn cứ cần có |
|---|---|
| Đề xuất một ứng viên để thử | Hiện tượng trên file thật, lý do kỹ thuật khả thi, giải thích khác và dự đoán có thể 
bác bỏ. Giả thuyết vẫn là ứng viên, chưa là nguyên nhân đã xác nhận. |
| Chọn một thành phần thiết kế trước G3 | Căn cứ phù hợp với mục đích thành phần: bằng chứng hạn chế và đường xử lý ở 
P4 nếu nhằm sửa hạn chế, hoặc yêu cầu DT18/nhu cầu kỹ thuật được ghi đúng; so phương án và kiểm đầu vào, trung gian, 
hành vi trên dev. Không chọn chỉ vì dẫn một mã hạn chế hoặc hợp khung có sẵn. |
| Khẳng định hiệu quả hoặc lợi ích do quan hệ thật | Đánh giá hợp lệ sau khóa thiết kế trên dữ liệu không dùng để 
thiết kế; đối chứng tương ứng với khẳng định, cùng giới hạn theo điều kiện. Chọn thiết kế hoặc hai agent đồng ý không 
thay bằng chứng này. |

## 4. Dataset: chọn theo tiêu chí, không theo tên

# Tài liệu tham khảo

Chép nguyên văn ngày 02/10/2026. **Chỉ tham khảo, không neo theo** (Q-01). Khẳng định nào ở đây cần dùng làm căn cứ 
thì phải kiểm lại trên bài, code hoặc file dữ liệu gốc. Link tương đối bên trong các file có thể không mở được.

Kiến thức nền đã lọc (K1 phương pháp, K2 dữ liệu RE2-TT, K3 dataset ứng viên, K4 ba họ thuật toán) nằm ở 
`docs/knowledge/`, không ở đây.

| File | Là gì | Lưu ý |
|---|---|---|
| `sources/DT18-de-tai-va-nhiem-vu.md` | Tên đề tài và nhiệm vụ hiện hành | Nguồn chính |
| `sources/advisor-2026-09-23.md` | Hướng dẫn của cô: chuỗi 4 việc và 5 bước | Nguồn chính |
| `sources/advisor-2026-08-22-lich-su.md` | Thư định hướng cũ | Chỉ là lịch sử |
| `sources/advisor-thu-dang-ky-de-tai.md` | Chuỗi thư về định hướng, quy mô nhóm và tên đề tài (lưu 20/10/2026) | Tên 
hiện hành nằm ở DT18, không ở chuỗi thư |
| `sources/roles.md` | Phân công nhóm | |
| `LESSONS-v1.md` | Bài học v1 và v2, bản đầy đủ | Bản rút gọn ở `docs/LESSONS.md` |
# Bài học phải áp dụng

Bản rút gọn để đọc nhanh. Câu chuyện đầy đủ, số liệu và nguồn ở `reference/LESSONS-v1.md`; mã ST, SL, QT, CB dưới đây 
trỏ về file đó.

## Sự thật đã đo về RE2-TT (dùng nếu P2 chọn RE2-TT; không đo lại trừ khi spec yêu cầu)

- 90 ca = 5 service gốc × 6 loại lỗi × 3 lần lặp. Nhãn chỉ có: service gốc, loại lỗi, thời điểm tiêm lỗi (ST1).
- Trace: 98,45% span cha resolve được. `statusCode` rỗng toàn bộ. Log có ở 89/90 ca (ST2).
- Đồ thị gần như hằng số: 30 ca dev chỉ có 2 đồ thị khác nhau. auth không có cạnh nào (ST3).
- 60 ca chưa ai nhìn từng ca. Bài FSE 2026 báo baseline không dùng đồ thị SimpleRCA đạt top-1 0,80 trên RE2-TT (ST9, 
ST10).

## Sai lầm không được lặp lại

| Mã | Sai lầm | Điều cần làm thay |
|---|---|---|
| SL1, SL22 | Câu hỏi lệch đề tài; bám khung cũ khi làm bản mới | Bắt đầu từ DT18 và chuỗi của cô (MRP §2) |
| SL2, SL3 | Một lựa chọn riêng (sàn 1e-12) quyết định dấu của kết luận; giá trị vô lý bị ghi là "giới hạn" | Kiểm 
chịu lực; soi giá trị trung gian |
| SL5, SL12 | Hạ tầng và quy trình lớn hơn khoa học; ngữ cảnh mỗi phiên quá nặng | Quy trình vừa đủ; STATE một trang |
| SL7, SL10 | Đơn giản hóa prior work đúng chỗ tạo giá trị; so với một baseline yếu | Dùng code chính thức; baseline 
mạnh |
| SL8, SL15 | Đo "giá trị đồ thị" trên dữ liệu không phân xử được | Đếm khả năng phân xử trước khi đặt giả thuyết |
| SL13 | Dùng công cụ nặng cho câu hỏi nhanh | Báo chi phí trước |
| SL14, SL21 | Nêu mẫu hình từ trung bình nhóm (thực ra chỉ một ô); rồi kết luận quá tay theo chiều ngược lại | Tách 
theo ô; phân biệt "chưa biết" với "không được" |
| SL16, SL18 | Chỉ nhận sai khi người khác chỉ ra; đưa góp ý của reviewer vào tài liệu mà chưa tự kiểm | Tự kiểm; góp 
ý là đầu vào, không phải lệnh |
| SL17 | Viết số từ trí nhớ | Lấy số từ file kết quả |
| SL20 | Gắn "hoàn thành" với "đồ thị phải thắng" | Kết quả trung thực (Q-04) |
| SL23 | Đề xuất chưa kiểm nhưng nói như sự thật | Ghi "chưa kiểm", giả định, khi nào sai |
| SL24 | Cài và đo thời gian phương pháp mà không kiểm nó chạy đúng; báo "chạy được" khi chỉ biết "không lỗi" (T-005) 
| Trước khi dùng số của một phương pháp: tái lập số công bố nếu có; luôn chạy phép kiểm không cần nhãn (đầu ra rỗng, 
trùng thứ tự cột hoặc nhánh dự phòng, chạy lại ra cùng kết quả) |
| SL25 | Chạy lượt có thể dài mà không ghi tiến độ hay thời gian từng bước; bị dừng ở giới hạn thì không biết gì 
(CIRCA-PC tốn 2 giờ máy cho câu "quá 1 giờ") (T-005) | Ghi tiến độ và thời gian từng bước ngay từ lượt đầu, nhất là 
khi SPEC đã nêu rủi ro chạy lâu |
| SL26 | Người soạn SPEC loại một phép kiểm cần thiết ("không đọc thứ hạng") mà không nêu hệ quả (T-005) | Khi SPEC bỏ 
một phép kiểm, ghi rõ kết luận nào yếu đi vì thiếu nó, để Minh quyết |
| SL27 | Đánh giá chi phí theo từng ca, không theo tổng (BOCPD 24 phút/ca tưởng chấp nhận được, thực ra khoảng 36 giờ 
cho 90 ca) (T-005) | Quy mọi chi phí về tổng ngân sách (Q-40) |
| SL28 | Tra số công bố sau khi đo (Bảng 8 bài TORAI đã có thời gian chạy) (T-005) | Tra số công bố trước khi thiết kế 
phép đo, dùng làm mốc so |
| SL29 | Dựng môi trường không ghim phiên bản (pandas 3.0.6, causal-learn 0.1.4.8), lệch với lúc tác giả chạy (T-005) 
| Ghim phiên bản theo lock file hoặc thời điểm công bố; lệch thì ghi và kiểm ảnh hưởng |
| SL30 | Chạy việc khác trong lúc đo (`du` song song); đặt giới hạn chạy nền quá ngắn làm lượt cài bị dừng (T-005) | 
Không chạy việc nặng khác khi đang đo; đặt giới hạn theo ước lượng có dư |
| SL31 | Người làm thay mục "Bổ sung yêu cầu phản biện" của mẫu bằng danh sách kiểm riêng, kèm kết luận sẵn và câu thu 
hẹp phạm vi; neo người phản biện (prompt T-001 bản 4, T-005 bản 2) | Chép nguyên văn mẫu; chỉ điền thông tin trung 
tính (Q-44) |
| SL32 | SPEC xếp các bước theo thứ tự đọc, không theo phụ thuộc thật: SPEC T-006 bắt mọi luồng chờ hết bước 0, làm X1 
trễ và EC2 của T-007 ngồi rảnh (T-006, T-007) | Trong SPEC, ghi rõ mỗi bước cần đầu ra nào của bước nào; việc không 
phụ thuộc thì chạy ngay (Q-43) |
| SL33 | SPEC kiểm đúng đắn (T-006, T-007) chỉ dùng dữ liệu cỡ nhỏ (Online Boutique, Sock Shop), bỏ dữ liệu cỡ Train 
Ticket công khai (`fse-tt`) dù RE2-TT là ứng viên dataset chính; người soạn SPEC không nêu hệ quả. Minh tưởng Train 
Ticket đã được kiểm vì T-005 có đo thời gian trên một ca RE2-TT (T-006, T-007) | Phạm vi dữ liệu của task kiểm phải 
phủ mọi quy mô và dataset ứng viên mà kết quả sẽ dùng; bỏ phần nào thì ghi lý do và hệ quả để Minh quyết. Báo cáo phân 
biệt rõ "đã đo thời gian" với "đã kiểm đúng sai" |
| SL34 | T017: regex suy pod từ tên làm gộp nhầm database hợp lệ (ts-assurance-mongo→ts) | Kiểm tên bằng dữ 
liệu/schema, dùng alias tường minh; soi điểm trung gian và giữ/rerun lượt bị ảnh hưởng. Bằng chứng: 
results/T-017/kiem-dung-dan.md; run-dev-004 |
| SL35 | Viết câu phổ quát ("30 ca đều có `inject_time.txt`") sau khi chỉ nhìn một thư mục (T-018, đã đính chính) | 
Câu "mọi/đều" phải có lệnh đếm trên đủ đối tượng |
| SL36 | Kết luận "TORAI khớp" chỉ dựa vào điểm cuối khớp số công bố (T-006). Ở đúng cấu hình đó, bước nhân quả không 
nhận cột metric nào do lỗi giảm mẫu hai lần, và 176/184 cụm rơi nhánh dự phòng về thứ tự mức nghiêm trọng; số vẫn khớp 
dù bản cài đang kiểm có lỗi; chưa xác minh code hay lượt chạy nào tạo số công bố (T-016) | Trước khi gọi một phương 
pháp là "kiểm đúng đắn": soi đầu vào thật của từng thành phần (số cột, số dòng), đếm số lần rơi nhánh dự phòng bên 
trong, và so điểm với một bản bỏ thành phần đó (ví dụ chỉ SeverityScorer) |
| SL37 | Kiểm đúng số, đúng phạm vi SPEC và viết giới hạn cẩn thận nhưng chưa chỉ rõ phần mục tiêu nghiên cứu còn 
thiếu và căn cứ để chuyển sang thiết kế; dùng "chưa kiểm"/"ngoài SPEC" như điểm kết thúc phân tích (thảo luận sau 
