@@ -0,0 +1,100 @@
+"""C1 SSH orchestration. Secrets only cross process pipes, never console/repo."""
+import argparse
+import base64
+import datetime as dt
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent
+REPO = ROOT.parents[2]
+SSH = 'C:/Program Files/Git/usr/bin/ssh.exe'
+SCP = 'C:/Program Files/Git/usr/bin/scp.exe'
+HOSTS = {
+    'tai': ('3.24.8.49', 'D:/RCA-ext/keys/Hahaa123.pem', 'D:/RCA-ext/keys/known_hosts'),
+    'obs': ('213.35.116.128', 'D:/RCA-ext/keys/exp-obs/ssh-key-2026-11-10.key', 
'D:/RCA-ext/overnight-T058/out/known_hosts'),
+    'app': ('129.221.208.47', 'D:/RCA-ext/keys/exp-app/ssh-key-2026-11-10 (1).key', 
'D:/RCA-ext/overnight-T058/out/known_hosts'),
+}
+
+def now():
+    return dt.datetime.now(dt.timezone.utc).isoformat()
+
+def stop():
+    if Path('D:/RCA-overnight/STOP').exists():
+        raise RuntimeError('STOP exists; no further work authorized')
+
+def ssh_args(machine):
+    host, key, known = HOSTS[machine]
+    return ['-i', key, '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15',
+            '-o', 'StrictHostKeyChecking=yes', '-o', 'UserKnownHostsFile='+known, 'ubuntu@'+host]
+
+def remote(machine, command, *, data=None, secret=False, mutation=False):
+    stop()
+    if machine == 'app' and mutation:
+        raise RuntimeError('exp-app is read-only')
+    if mutation:
+        with (ROOT/'thay-doi-may-tai.md').open('a', encoding='utf-8') as f:
+            f.write('\n## '+now()+' — '+machine+'\n\n```sh\n'+command+'\n```\n')
+    encoded = base64.b64encode(command.encode()).decode()
+    # Execute command text as a bash argument, leaving stdin available for secret pipes.
+    wrapped = "bash -c \"$(printf %s "+encoded+" | base64 -d)\""
+    p = subprocess.run([SSH, *ssh_args(machine), wrapped], input=data, capture_output=True)
+    if mutation:
+        with (ROOT/'thay-doi-may-tai.md').open('a', encoding='utf-8') as f:
+            f.write('\nExit: '+str(p.returncode)+'\n')
+    if p.returncode:
+        if not secret:
+            sys.stderr.write(p.stderr.decode(errors='replace'))
+        raise RuntimeError('SSH '+machine+' failed, exit '+str(p.returncode))
+    return p.stdout
+
+def auth(machine):
+    source = (REPO/'results/T-058/dem-2026-11-10/auth.py').read_text(encoding='utf-8')
+    source = source[:source.index("if __name__=='__main__':")]
+    source = source.replace("return json.load(response)['access_token']", 'return json.load(response)')
+    source += '\ntry:\n    print(json.dumps(role_token()))\nexcept Exception:\n    raise SystemExit(1)\n'
+    command = 'python3 -c '+"'"+source.replace("'", "'\"'\"'")+"'"
+    value = remote('app', command, secret=True)
+    tokens = json.loads(value)
+    if not tokens.get('access_token') or not tokens.get('refresh_token'):
+        raise RuntimeError('PKCE response missing token fields')
+    # Never log token values. The only persistent secret is on the selected load host.
+    remote(machine, 'umask 077; cat > /opt/rca-tai/secret/tokens.json', data=value,
+           secret=True, mutation=True)
+    print(json.dumps({'utc': now(), 'machine': machine, 'flow': 'PKCE',
+                      'expires_in': tokens.get('expires_in'),
+                      'refresh_expires_in': tokens.get('refresh_expires_in')}))
+
+def upload(machine):
+    for filename in ['k6/workload-t062.js', 'k6/fixtures.json', 'k6/cau-hinh.json']:
+        remote(machine, 'cat > /opt/rca-tai/'+filename,
+               data=(ROOT/filename).read_bytes(), mutation=True)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('action', choices=['command', 'auth', 'upload'])
+    p.add_argument('--may', choices=['tai', 'obs', 'app'], default='obs')
+    p.add_argument('--file', type=Path)
+    p.add_argument('--out', type=Path)
+    p.add_argument('--mutation', action='store_true')
+    a = p.parse_args()
+    if a.action == 'auth':
+        auth(a.may)
+    elif a.action == 'upload':
+        upload(a.may)
+    else:
+        value = remote(a.may, a.file.read_text(encoding='utf-8-sig'), mutation=a.mutation)
+        if a.out:
+            a.out.parent.mkdir(parents=True, exist_ok=True)
+            a.out.write_bytes(value)
+        else:
+            sys.stdout.buffer.write(value)
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as e:
+        print(type(e).__name__+': '+str(e), file=sys.stderr)
+        raise SystemExit(1)
