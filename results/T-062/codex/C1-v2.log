+$script:C1Root=$PSScriptRoot
+$script:C1Repo=(Resolve-Path "$PSScriptRoot/../../..").Path
+$script:C1Ssh='C:/Program Files/Git/usr/bin/ssh.exe'
+function Assert-C1Running {
