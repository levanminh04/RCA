+ $begin="$script:L1Root/EXP-APP-BAO-TRI-1-BAT-DAU"
+ $end="$script:L1Root/EXP-APP-BAO-TRI-1-XONG"
+ if(Test-Path $begin){
+  if(!(Test-Path $end)){throw 'exp-app maintenance: completion marker missing; no load/login/recovery'}
+  $began=[DateTimeOffset]::Parse((Get-Content -Encoding UTF8 $begin -TotalCount 1))
+  $ended=[DateTimeOffset]::Parse((Get-Content -Encoding UTF8 $end -TotalCount 1))
+  if($ended -lt $began){throw 'exp-app maintenance: completion marker is older than start'}
+ }
+}
+function Write-L1Event {
