+        if not re.fullmatch('[0-9a-f]{64}', source['sha256']):
+            raise ValueError('source_sha256')
+        if source['id'] in result:
+            raise ValueError('duplicate_source')
+        result[source['id']] = source
+    return result
+
+
+def provenance(rows, sources):
