+RELATION_TYPES = {'gọi-đồng-bộ', 'gọi-chưa-phân-kiểu', 'dữ-liệu', 'thông-điệp',
+                  'triển-khai', 'span-parent'}
+CHANNELS = {'http', 'rpc', 'data', 'publish', 'consume', 'logical-message',
+            'deployment', 'internal', 'smtp', 'span-parent'}
