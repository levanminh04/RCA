+def select_case_rows(payload, case_field, aliases):
+    table = pq.read_table(io.BytesIO(payload), filters=[(case_field, "in", aliases)])
+    if not all(name in aliases for name in table[case_field].to_pylist()):
+        raise RuntimeError("artifact predicate returned forbidden case")
+    return table
+
