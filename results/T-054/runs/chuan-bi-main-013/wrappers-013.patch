+def ob_group_description(table, decision_ref):
+    """Bảng nhóm đã khai trước điểm; không điều khiển A4 hoặc mức kiểm định."""
+    import a4_v2
+    decision = read_pin(decision_ref)
+    left, right, labels = table
+    group = set(decision['affected_opaque_ids'])
+    if (decision.get('status') != 'USER_CONFIRMED' or len(group) != 4
+            or len(left) != 34 or not group <= set(left) or set(left) != set(right)):
+        raise Blocked('nhóm độ nhạy OB khác cohort/nhóm bốn ca đã khai')
+    rows = []
+    for world in ('P', 'S_lo', 'S_hi'):
+        delta = {oid: a4_v2._score(left[oid], labels[oid]['root'], world)['Hit5_Q']
+                 - a4_v2._mean_scores([a4_v2._score(r, labels[oid]['root']) for r in right[oid]])['Hit5_Q']
+                 for oid in left}
+        for name, members in [('all34', set(left)), ('remaining30', set(left) - group), ('affected4', group)]:
+            rows.append({'group': name, 'world': world, 'n': len(members),
+                         'paired_mean_delta_Hit5': sum(delta[o] for o in members) / len(members)})
+    return {'decision': decision_ref, 'rows': rows, 'role': 'DESCRIPTIVE_ONLY',
+            'limit': 'Đổi tập đích theo nhóm; chưa tách tác động adapter khỏi độ khó ca.'}
 
 
