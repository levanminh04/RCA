+        if (s['dataset'] != 'RE2-TT' or s['arm'] != 'M1' or s['seed'] is not None or oid in covered
+                or row is None or row.get('ce_history') != 'verified'
+                or s['source_sha256'] != fingerprint(row)
+                or s['window'] != {'t': row['t']-300, 'half_width_s': 300}):
