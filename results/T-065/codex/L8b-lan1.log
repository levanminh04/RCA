+                assert_equal(subset('4_rank', ('entity', 'hang', 'tie_group', 'lop', 'so_kenh_co')),
+                             [[r.get(k) for k in ('entity', 'hang', 'tie_group', 'lop', 'so_kenh_co')] for r in d['ranking_rows']], ('API ranks', b['ban'], ca))
