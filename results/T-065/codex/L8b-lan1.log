+                meta = {x['a_truong']: x.get('b_gia_tri') for x in rows['3_meta']}
+                for label, expected in [('Bản', b['ban']), ('Trạng thái bản', b['trang_thai']), ('Trạng thái chạy', d['trang_thai_chay']),
