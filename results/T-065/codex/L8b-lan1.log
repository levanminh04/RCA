+                assert_equal(projected, m['entity_ranking'], 'display order')
+                assert all(r['hang'] == r['tie_group'] + 1 for r in d['ranking_rows'])
+                units = {u['ma']: u for u in m['extra']['don_vi_phan_vi']}
+                op_flags = 0
+                for o in d['thao_tac']:
+                    key = 'op|' + o['chu'] + '|' + o['ten']
+                    unit = units.get(key)
