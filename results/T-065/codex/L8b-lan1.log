+  "required": ["phien_ban_dinh_dang", "ban", "ca", "cua_so_ms", "trang_thai_chay", "loi_chay", "entity_ranking", "ranking_rows", "co_m1", "don_vi_m1", "canh_xep_hang", "trang_thai_canh", "thao_tac", "services"],
