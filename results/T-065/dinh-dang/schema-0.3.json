      "type": "array",
      "items": {
       "type": "number"
      }
     }
    }
   }
  },
  "vung": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ap_dung",
    "ly_do",
    "goc",
    "hop_cach_1",
    "hop_cach_2",
    "cach_1",
    "cach_2",
    "T_m1"
   ],
   "properties": {
    "ap_dung": {
     "type": "boolean"
    },
    "ly_do": {
     "type": [
      "string",
      "null"
     ]
    },
    "goc": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hop_cach_1": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hop_cach_2": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cach_1": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "cach_2": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "T_m1": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     }
    }
   },
   "if": {
    "properties": {
     "ap_dung": {
      "const": false
     }
    }
   },
   "then": {
    "properties": {
     "goc": {
      "maxItems": 0
     },
     "hop_cach_1": {
      "maxItems": 0
     },
     "hop_cach_2": {
      "maxItems": 0
     },
     "ly_do": {
      "type": "string"
     }
    }
   }
  },
  "bang_chung": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/bang_chung"
   }
  },
  "giai_thich_ke_thua": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "thuc_the",
     "kenh_ma",
     "duong",
     "giai_thich_boi",
     "quy_tac",
     "trang_thai"
    ],
    "properties": {
     "thuc_the": {
      "type": "string"
     },
     "kenh_ma": {
      "type": "string"
     },
     "duong": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "giai_thich_boi": {
      "type": "string"
     },
     "quy_tac": {
      "type": "string"
     },
     "trang_thai": {
      "type": "string"
     }
    }
   }
  },
  "giai_thich": {
   "type": [
    "string",
    "null"
   ],
   "description": "Lời giải thích LLM (G4); null tới khi có"
  },
  "phat_lai": {
   "$ref": "#/$defs/phat_lai"
  },
  "ban": {
   "type": "object",
   "additionalProperties": false,
   "required": [
