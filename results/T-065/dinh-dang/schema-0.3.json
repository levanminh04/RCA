      "type": "boolean"
     },
     "so_kenh_co": {
      "type": "integer",
      "minimum": 0
     },
     "kenh_co": {
      "type": "array"
     },
     "don_vi_m1": {
      "type": [
       "object",
       "null"
      ]
     },
     "mau": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     },
     "ban_kinh": {
      "const": 32
     },
