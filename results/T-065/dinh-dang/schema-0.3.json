     "type": "integer",
     "minimum": 0
    },
    "so_tra_hang": {
     "type": "integer",
     "minimum": 0
    },
    "do_phu_cham": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 1
    },
    "thieu_kenh_hop_le": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "so_canh_quan_sat": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "so_canh_tinh": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "thuc_the_khong_co_canh": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hang_doi_giua_the_gioi": {
     "type": [
      "boolean",
      "null"
     ],
     "description": "/RANK_CHANGED: thứ tự đổi giữa ba thế giới P, S_lo, S_hi"
    },
    "don_vi_phu_thuoc_quan_sat": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "/OBS_DEPENDENT"
    },
    "ghi_chu": {
     "type": "string"
    }
   }
  },
  "nut": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/nut"
   }
  },
  "canh": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/canh"
   }
  },
  "xep_hang": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "hang",
     "nhom_dong_hang",
     "thuc_the",
     "so_thuc_the",
     "tang",
     "khoa_m1"
    ],
    "properties": {
     "hang": {
      "type": "integer",
      "minimum": 1
     },
     "nhom_dong_hang": {
      "type": "integer",
      "minimum": 0
     },
     "thuc_the": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "so_thuc_the": {
      "type": "integer",
      "minimum": 1
     },
