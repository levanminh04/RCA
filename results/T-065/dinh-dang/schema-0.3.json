{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:flashticket:rca:result:0.3",
 "title": "FlashTicket RCA 0.3 — bản và thao tác",
 "description": "Ý nghĩa từng trường và nguồn (trực tiếp từ M1 hay dẫn xuất) ở dinh-dang-ket-qua-rca.md. Trạng thái ERROR/UNSUPPORTED: cửa sổ, verdict rỗng, không nút/cạnh/hạng; mốc lấy từ request.json của bộ điều phối. Trường `phat_lai` chỉ có ở bản phát lại, do phat-lai.py thêm sau khi đầu ra đã băm.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "dinh_dang",
  "phien_ban_dinh_dang",
  "su_co",
  "nguon",
  "do_phu",
  "nut",
  "canh",
  "xep_hang",
  "vung",
  "bang_chung",
  "giai_thich_ke_thua",
  "giai_thich",
  "ban"
 ],
 "properties": {
  "dinh_dang": {
   "const": "flashticket-rca-ket-qua"
  },
  "phien_ban_dinh_dang": {
   "const": "0.3"
  },
  "su_co": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ma",
    "che_do",
    "moc",
    "cua_so_nen",
    "cua_so_su_co",
    "ket_luan",
    "ket_luan_hien_thi",
    "trang_thai",
    "loi"
   ],
   "properties": {
    "ma": {
     "type": "string",
     "minLength": 1,
     "description": "Mã mờ của ca do bộ điều phối cấp; không mang nghĩa nhãn"
    },
    "che_do": {
     "const": "a",
     "description": "Bản 0.2 chỉ hỗ trợ chế độ a"
    },
    "moc": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "t_ns",
      "t_utc",
      "nguon",
      "mo_ta"
     ],
     "properties": {
      "t_ns": {
       "type": "integer"
      },
      "t_utc": {
       "type": "string"
      },
      "nguon": {
       "const": "bo_dieu_phoi"
      },
      "mo_ta": {
       "type": "string"
      }
     }
    },
    "cua_so_nen": {
     "oneOf": [
      {
       "$ref": "#/$defs/khoang"
      },
      {
       "type": "null"
      }
     ]
    },
    "cua_so_su_co": {
     "oneOf": [
      {
       "$ref": "#/$defs/khoang"
      },
      {
       "type": "null"
      }
     ]
    },
    "ket_luan": {
     "enum": [
      "CAUSE_FOUND",
      "NO_INTRINSIC_ANOMALY",
      "INSUFFICIENT_EVIDENCE",
      null
     ]
    },
    "ket_luan_hien_thi": {
     "type": "string"
    },
    "trang_thai": {
     "enum": [
      "OK",
      "NO_EVIDENCE",
      "ERROR",
      "UNSUPPORTED"
     ]
    },
    "loi": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "trang_thai": {
        "enum": [
         "OK",
         "NO_EVIDENCE"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "cua_so_nen": {
        "$ref": "#/$defs/khoang"
       },
       "cua_so_su_co": {
        "$ref": "#/$defs/khoang"
       },
       "ket_luan": {
        "enum": [
         "CAUSE_FOUND",
         "NO_INTRINSIC_ANOMALY",
         "INSUFFICIENT_EVIDENCE"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "trang_thai": {
        "enum": [
         "ERROR",
         "UNSUPPORTED"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "cua_so_nen": {
        "type": "null"
       },
       "cua_so_su_co": {
        "type": "null"
       },
       "ket_luan": {
        "type": "null"
       },
       "loi": {
        "type": "string"
       }
      }
     }
    }
   ]
  },
  "nguon": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "file_m1",
    "sha256_m1",
    "bytes_m1",
    "adapter",
    "sha256_adapter",
    "manifest",
    "bo_chuyen_doi",
    "sha256_bo_chuyen_doi",
    "method",
    "method_version",
    "config_id",
    "variant",
    "why_ids",
    "che_do_m1",
    "request",
    "sha256_request"
   ],
   "properties": {
    "file_m1": {
     "type": "string"
    },
    "sha256_m1": {
     "$ref": "#/$defs/sha256"
    },
    "bytes_m1": {
     "type": "integer",
     "minimum": 1
    },
    "adapter": {
     "type": "string"
    },
    "sha256_adapter": {
     "$ref": "#/$defs/sha256"
    },
    "manifest": {
     "type": "string"
    },
    "bo_chuyen_doi": {
     "type": "string"
    },
    "sha256_bo_chuyen_doi": {
     "$ref": "#/$defs/sha256"
    },
    "method": {
     "type": [
      "string",
      "null"
     ]
    },
    "method_version": {
     "type": [
      "string",
      "null"
     ]
    },
    "config_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "variant": {
     "type": [
      "string",
      "null"
     ]
    },
    "why_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "che_do_m1": {
     "type": [
      "object",
      "null"
     ]
    },
    "request": {
     "type": "string"
    },
    "sha256_request": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "do_phu": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "so_quan_sat",
    "so_tra_hang",
    "do_phu_cham",
    "thieu_kenh_hop_le",
    "so_canh_quan_sat",
