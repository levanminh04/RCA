   "type": "object"
  }
 },
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "khoang": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tu_ns",
    "den_ns",
    "tu_ms",
    "den_ms",
    "tu_utc",
    "den_utc"
   ],
   "properties": {
    "tu_ns": {
     "type": "integer"
    },
    "den_ns": {
     "type": "integer"
    },
    "tu_ms": {
     "type": "integer"
    },
    "den_ms": {
     "type": "integer"
    },
    "tu_utc": {
     "type": "string"
    },
    "den_utc": {
     "type": "string"
    }
   }
  },
  "hien_thi_nut": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "mau",
    "nhan_trong",
    "nhan_phu"
   ],
   "properties": {
    "mau": {
     "type": "string",
     "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "nhan_trong": {
     "type": "string"
    },
    "nhan_phu": {
     "type": "string"
    }
   }
  },
  "nut": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "ten",
    "lop_m1",
    "vai_tro",
    "tang_m1",
    "hang",
    "nhom_dong_hang",
    "so_dong_hang",
    "khoa_m1",
    "noi_bat",
    "goc_vung",
    "trong_vung_cach_1",
    "trong_vung_cach_2",
    "co_canh",
    "bang_chung",
    "hien_thi"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "ten": {
     "type": "string"
    },
    "lop_m1": {
     "enum": [
      "tu_sinh",
      "ke_thua",
      "binh_thuong",
      "thieu_du_lieu",
      null
     ]
    },
    "vai_tro": {
     "enum": [
      "nghi_nguon",
      "bi_keo_theo",
      "binh_thuong",
      "thieu_du_lieu",
      "khong_ro"
     ]
    },
    "tang_m1": {
     "enum": [
      1,
      2,
      3,
      null
     ]
    },
    "hang": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1
    },
    "nhom_dong_hang": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "so_dong_hang": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1
    },
    "khoa_m1": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "number"
     }
    },
    "noi_bat": {
     "type": "boolean"
    },
    "goc_vung": {
     "type": "boolean"
    },
    "trong_vung_cach_1": {
     "type": "boolean"
    },
    "trong_vung_cach_2": {
     "type": "boolean"
    },
    "co_canh": {
     "type": "boolean"
    },
    "bang_chung": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hien_thi": {
     "$ref": "#/$defs/hien_thi_nut"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "vai_tro": {
        "const": "thieu_du_lieu"
       }
      }
     },
     "then": {
      "properties": {
       "hang": {
        "type": "null"
       },
       "nhom_dong_hang": {
        "type": "null"
       },
       "noi_bat": {
        "const": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "noi_bat": {
        "const": true
       }
      }
     },
     "then": {
      "properties": {
       "vai_tro": {
        "const": "nghi_nguon"
       },
       "hang": {
        "const": 1
       }
      }
     }
    }
   ]
  },
  "canh": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "nguon",
    "dich",
    "chieu",
    "nguon_goc",
    "bang_chung",
    "hien_thi"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "nguon": {
     "type": "string",
