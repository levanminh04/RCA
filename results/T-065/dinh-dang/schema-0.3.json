     "type": "string"
    },
    "nguon_output": {
     "type": "string"
    },
    "sha256_output": {
     "$ref": "#/$defs/sha256"
    },
    "nguon_input": {
     "type": "string"
    },
    "sha256_input": {
     "$ref": "#/$defs/sha256"
    },
    "hop_dong": {
     "type": "string"
    }
   }
  },
  "thao_tac": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "chu",
     "ten",
     "loai",
     "n_N",
     "n_A",
     "mau_N",
     "mau_A",
     "span_boc",
     "goc",
     "mo_coi",
     "dich_quan_sat",
     "trang_thai_m1",
     "co_len",
     "co_xuong",
     "co_m1",
     "so_kenh_co",
     "kenh_co",
     "don_vi_m1",
     "mau",
     "ban_kinh",
     "lien_ket",
     "ly_do_khong_prometheus",
     "vi_du"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "chu": {
      "type": "string"
     },
     "ten": {
      "type": "string"
     },
     "loai": {
      "type": "string"
     },
     "n_N": {
      "type": "integer",
      "minimum": 0
     },
     "n_A": {
      "type": "integer",
      "minimum": 0
     },
     "mau_N": {
      "type": "integer",
      "minimum": 0
     },
     "mau_A": {
      "type": "integer",
      "minimum": 0
     },
     "span_boc": {
      "type": "integer",
      "minimum": 0
     },
     "goc": {
      "type": "integer",
      "minimum": 0
     },
     "mo_coi": {
      "type": "integer",
      "minimum": 0
     },
     "dich_quan_sat": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "trang_thai_m1": {
