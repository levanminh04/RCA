{"analysis_source": "\ndef trace_T4(reference_controllers, controllers, device, labels, run_id):\n    import sys,time,json,collections\n    from pathlib import Path\n    sys.path.insert(0,'results/T-048/scripts')\n    from chay import OUT,read,dump,sha\n    from kiem import read_run,doi_chieu_khoa\n    from cham import WORLDS\n    folder=OUT/'runs'/run_id;folder.mkdir();started=time.monotonic()\n    allocation=read(OUT/'ma-tran.json')['allocation']; refs={};hashes={}\n    # Verify all original raw hashes again before using scoring roots.\n    for parents in (reference_controllers,controllers):\n      for name in parents:\n       status=read(OUT/'runs'/name/'kiem.json')\n       for child in status['finished']:\n        cmd,meta,pairs=read_run(OUT/'runs'/child);hashes[child]=meta\n    (folder/'command.json').write_text(dump(dict(reference_controllers=reference_controllers,controllers=controllers,device=device,phase1=hashes,labels_sha256=__import__('hashlib').sha256(dump(labels).encode()).hexdigest(),analysis_source=ANALYSIS_SOURCE))+'\\n',encoding='utf-8')\n    for name in reference_controllers:\n      for child in read(OUT/'runs'/name/'kiem.json')['finished']:\n       cmd,meta,pairs=read_run(OUT/'runs'/child)\n       for j in cmd['plan']['jobs']:\n        if allocation[j['opaque_id']]==device:refs[(j['opaque_id'],j['window'])]=child\n    stats={};records=0\n    with (folder/'trung-gian.jsonl').open('x',encoding='utf-8') as output,(folder/'progress.jsonl').open('x',encoding='utf-8') as progress:\n      for name in controllers:\n       for child in read(OUT/'runs'/name/'kiem.json')['finished']:\n        _,_,pairgen=read_run(OUT/'runs'/child); first=None\n        for r,d in pairgen():\n         oid=r['opaque_id'];window=d['window'];cid=r['config_id']\n         if allocation[oid]!=device:continue\n         if first is None:\n          refchild=refs[(oid,window)];_,_,rp=read_run(OUT/'runs'/refchild);r0,d0=next(rp());first=(r0,d0)\n         r0,d0=first;t0=d0['trace'];t=d['trace']\n         assert t['normalized_input_sha256']==t0['normalized_input_sha256'] and t['cong_G3']==t0['cong_G3']\n         assert t['phan_vi'].keys()==t0['phan_vi'].keys()\n         assert all(t['phan_vi'][u]['mau_sha256']==t0['phan_vi'][u]['mau_sha256'] for u in t['phan_vi'])\n         entry=dict(opaque_id=oid,window=window,dataset=d['dataset'],config_id=cid,reference_child=refchild,child=child,input_equal=True,worlds={})\n         for i,w in enumerate(WORLDS):\n          a,b=t0['world_state'][w],t['world_state'][w]\n          ua,ub=({x['don_vi']['ma']:x for x in q['units']} for q in (a,b));assert ua.keys()==ub.keys()\n          flags=[];values=collections.Counter();max_p=0\n          for u in ua:\n           x,y=ua[u]['cham'],ub[u]['cham'];fs=('trang_thai','hop_le','F_raw_len','F_raw_xuong')\n           if any(x.get(k)!=y.get(k) for k in fs):\n            keep=(*fs,'e_len','e_xuong','e_len_tho','e_xuong_tho','p_len','p_xuong','h','l','r_len_A','r_xuong_A')\n            flags.append(dict(unit=u,kind=ua[u]['don_vi']['loai'],before={k:x.get(k) for k in keep},after={k:y.get(k) for k in keep}))\n           for k in ('p_len','p_xuong','h','l','r_len_A','r_xuong_A','e_len','e_xuong'):\n            if x.get(k)!=y.get(k):values[k]+=1\n           for k in ('p_len','p_xuong'):\n            if isinstance(x.get(k),(int,float)) and isinstance(y.get(k),(int,float)):max_p=max(max_p,abs(x[k]-y[k]))\n          ar,br=t0['xep'][i],t['xep'][i]; root=labels[oid]['root']; keya=doi_chieu_khoa(ar,root);keyb=doi_chieu_khoa(br,root)\n          flips=[]\n          def pos(rank):return {e:n for n,block in enumerate(rank['ket_qua']['blocks']) for group in block['groups'] for e in group}\n          pa,pb=pos(ar),pos(br)\n          if root in pa and root in pb:\n           for rival in sorted(pa.keys()&pb.keys()-{root}):\n            old=(pa[root]>pa[rival])-(pa[root]<pa[rival]);new=(pb[root]>pb[rival])-(pb[root]<pb[rival])\n            if old!=new:flips.append(dict(rival=rival,before_relation=old,after_relation=new,before=doi_chieu_khoa(ar,rival),after=doi_chieu_khoa(br,rival)))\n          row=dict(changed_flags=flags,value_changes=dict(values),max_abs_delta_p=max_p,tier_changes={e:[ar['ket_qua']['tang'][e],br['ket_qua']['tang'][e]] for e in ar['ket_qua']['tang'] if ar['ket_qua']['tang'][e]!=br['ket_qua']['tang'][e]},root_keys=[keya,keyb],root_pair_flips=flips,N1=[a['N1'],b['N1']],V0=[a['V0'],b['V0']],valid_units=[a['valid_units'],b['valid_units']])\n          entry['worlds'][w]=row\n          st=stats.setdefault(cid,{}).setdefault(w,collections.Counter());st.update(windows=1,windows_with_flag_changes=bool(flags),changed_units=len(flags),windows_with_tier_changes=bool(row['tier_changes']),root_pair_flips=len(flips))\n         output.write(dump(entry)+'\\n');output.flush();records+=1\n        progress.write(dump(dict(child=child,records=records,elapsed=time.monotonic()-started))+'\\n');progress.flush()\n    (folder/'kiem.json').write_text(dump(dict(closed=True,records=records,stats=stats,phase1=hashes,trace_sha256=sha(folder/'trung-gian.jsonl'),wall_seconds=time.monotonic()-started))+'\\n',encoding='utf-8')\n    return dict(records=records,wall_seconds=time.monotonic()-started)\n", "controllers": ["t4-laptop-nz-001", "t4-laptop-re-001", "t4-laptop-re-002"], "device": "laptop", "labels_sha256": "85e1f70888c8e6e84398f55c8709f8f266bc5b4e1a022a9ec5812731fb5ce3e8", "phase1": {"r0-laptop-nz-001-000": {"cpu_seconds": 15.703125, "intermediate_sha256": "193f00d4fdfa612b99b466dd069961c75db39afb9938a3fde607e1acefbf6389", "phase1_sha256": "91bfc3b59997af100f2ff78e6e32ad37db33f2f4736a7b24f472eae43404f771", "records": 1, "rss": 338128896, "wall_seconds": 14.485000000044238}, "r0-laptop-nz-001-001": {"cpu_seconds": 14.65625, "intermediate_sha256": "a0d21d5f0118d80855404fe25c5ea384fb555bc49b42e043c37a556942253a6f", "phase1_sha256": "927fa7d444bb071f132af790ba40448ab67666789c581fa84c6a9bc74786ca33", "records": 1, "rss": 332689408, "wall_seconds": 13.125}, "r0-laptop-nz