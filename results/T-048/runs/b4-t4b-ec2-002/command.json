nl')==pm['context_sha256']\n  assert read(previous_dir/'command.json')['phase1']==hashes\n  previous_context={(v['opaque_id'],v['base']):v for v in (json.loads(x) for x in (previous_dir/'trung-gian.jsonl').read_text(encoding='utf-8').splitlines())}\n  previous={(v['opaque_id'],v['base']):v for v in (json.loads(x) for x in (previous_dir/'ban-ghi.jsonl').read_text(encoding='utf-8').splitlines()) if (v['opaque_id'],v['base']) in previous_context}\n\n with (folder/'ban-ghi.jsonl').open('x',encoding='utf-8') as output,(folder/'trung-gian.jsonl').open('x',encoding='utf-8') as context_out,(folder/'progress.jsonl').open('x',encoding='utf-8') as progress:\n  for child in read(OUT/'runs'/controller/'kiem.json')['finished']:\n   cmd,meta,pairs=read_run(OUT/'runs'/child);job=cmd['plan']['jobs'][0]\n   if job['window']!='that':continue\n   oid=job['opaque_id'];refchild=refs[(oid,'that')];_,_,rpairs=read_run(OUT/'runs'/refchild);r0,d0=next(rpairs());batch={r['config_id']:(r,d) for r,d in pairs()};batch[r0['config_id']]=(r0,d0)\n   # Root is joined here, after every native/intermediate hash was checked.\n   root=labels[oid]['root']\n   for base,eid in (('R0','R0-E4-S1-e0.05-a0.01'),('E1+E2','E1+E2-E4-S1')):\n    if (oid,base) in previous:\n     result=previous[(oid,base)];ctx=previous_context[(oid,base)]\n     output.write(dump(result)+'\\n');output.flush();context_out.write(dump(ctx)+'\\n');context_out.flush();totals.update(cases=1,worlds=3,flips=sum(len(v['flips']) for v in result['mechanism']['worlds'].values()));continue\n    er,ed=batch[eid];zr,zd=batch[base+'-z-S1'];z0r,z0d=batch[base+'-z-S0']\n    oldpv,newpv=ed['trace']['phan_vi'],zd['trace']['phan_vi'];assert oldpv.keys()==newpv.keys()\n    assert all(oldpv[u]['mau_sha256']==newpv[u]['mau_sha256'] and oldpv[u]['e4']==newpv[u]['e4'] for u in oldpv)\n    mechanism=mechanism_case(er,ed,zr,zd,z0r,z0d,root)\n    assert 'OPEN' not in mechanism\n    result=dict(opaque_id=oid,dataset=job['dataset'],cell=labels[oid]['o'],base=base,source_child=child,reference_child=refchild,root=root,mechanism=mechanism)\n    output.write(dump(result)+'\\n');output.flush()\n    context={}\n    for i,w in enumerate(WORLDS):\n     rank=ed['trace']['xep'][i];zrank=zd['trace']['xep'][i];pv=zd['trace']['phan_vi'];channels=[k for k in rank['kenh'] if k['F_raw'] and k['hop_le'] and k['trang_thai']=='OK'];intrinsic=[k for k in channels if rank['F_I'].get(k['ma'])==1]\n     context[w]=dict(root_ranked=root in rank['ket_qua']['tang'],root_tier=rank['ket_qua']['tang'].get(root),PV_flagged=sum(k['don_vi'] in pv for k in intrinsic),count_flagged=sum(k['don_vi'] not in pv for k in intrinsic),PV_rA1=sum(pv[k['don_vi']]['oracle'][k['huong']]['r_A_one'] for k in intrinsic if k['don_vi'] in pv),PV_e1=sum(pv[k['don_vi']]['oracle'][k['huong']]['e_one'] for k in intrinsic if k['don_vi'] in pv),root_E4=doi_chieu_khoa(rank,root,ed['trace']['don_vi_the_gioi'][i]['m']),root_z=doi_chieu_khoa(zrank,root,zd['trace']['don_vi_the_gioi'][i]['m']))\n    context_out.write(dump(dict(opaque_id=oid,base=base,worlds=context))+'\\n');context_out.flush();totals.update(cases=1,worlds=3,flips=sum(len(v['flips']) for v in mechanism['worlds'].values()))\n   progress.write(dump(dict(child=child,cases=totals['cases'],elapsed=time.monotonic()-start))+'\\n');progress.flush()\n (folder/'kiem.json').write_text(dump(dict(closed=True,totals=totals,phase1=hashes,phase2_sha256=sha(folder/'ban-ghi.jsonl'),context_sha256=sha(folder/'trung-gian.jsonl'),wall_seconds_including_wait=time.monotonic()-start))+'\\n',encoding='utf-8')\n return dict(totals)\n", "controller": "t4b-ec2-001", "labels_held_separately": true, "labels_sha256": "85e1f70888c8e6e84398f55c8709f8f266bc5b4e1a022a9ec5812731fb5ce3e8", "no_method_calls": true, "phase1": {"r0-ec2-001-000": {"cpu_seconds": 101.165255238, "intermediate_sha256": "8bf79b7d01d3f59e50360a036c18a9e77e89342d96767ef3d95f3308185c2191", "phase1_sha256": "b313e3df8c422ffe4dc51a527b623b6862cf5613082e6de4a359266894ca8678", "records":