{"analysis_source": "\ndef check_B2(controller, reference_controllers, device, run_id):\n import sys,time,json,math,collections\n from pathlib import Path\n sys.path.insert(0,'results/T-048/scripts')\n from chay import OUT,read,dump,sha\n from kiem import read_run,doi_co_va_tang\n from cham import WORLDS\n folder=OUT/'runs'/run_id;folder.mkdir();start=time.monotonic();parent=OUT/'runs'/controller;command=read(parent/'command.json');allocation=read(OUT/'ma-tran.json')['allocation'];refs={};refhash={}\n for name in reference_controllers:\n  for child in read(OUT/'runs'/name/'kiem.json')['finished']:\n   cmd,meta,pairs=read_run(OUT/'runs'/child);refhash[child]=meta\n   for j in cmd['plan']['jobs']:\n    if allocation[j['opaque_id']]==device:refs[(j['opaque_id'],j['window'])]=child\n (folder/'command.json').write_text(dump(dict(controller=controller,references=reference_controllers,reference_hashes=refhash,analysis_source=ANALYSIS_SOURCE,no_labels=True,order='hash -> finite fields -> flags/validity/tiers -> N1/V0'))+'\\n',encoding='utf-8')\n done=set();totals=collections.Counter();exceptions=[];deadline=start+10800\n with (folder/'trung-gian.jsonl').open('x',encoding='utf-8') as output,(folder/'progress.jsonl').open('x',encoding='utf-8') as progress:\n  while len(done)<len(command['plan']['jobs']):\n   if time.monotonic()>deadline:raise TimeoutError('B2 tới trần theo controller')\n   for n,job in enumerate(command['plan']['jobs']):\n    child=f'{controller}-{n:03d}';where=OUT/'runs'/child\n    if child in done or not (where/'kiem.json').exists():continue\n    _,meta,pairs=read_run(where);batch={r['config_id']:(r,d) for r,d in pairs()}\n    refchild=refs[(job['opaque_id'],job['window'])];_,rmeta,rpairs=read_run(OUT/'runs'/refchild)\n    r0,d0=next(rpairs());batch[r0['config_id']]=(r0,d0)\n    result=dict(opaque_id=job['opaque_id'],window=job['window'],dataset=job['dataset'],child=child,reference_child=refchild,phase1=meta,reference_hashes=rmeta,bases={})\n    for base,e4id in (('R0','R0-E4-S1-e0.05-a0.01'),('E1+E2','E1+E2-E4-S1')):\n     er,ed=batch[e4id];row=dict(status=er['status'],variants={},z_distribution=[])\n     # Full finite-domain check before reading the verdict/count summaries.\n     for cid in (e4id,base+'-z-S1',base+'-z-S0'):\n      r,d=batch[cid];t=d['trace'];invalid=[]; pv=0;oracle=0;fallback=0;maxz=None; key_count=0\n      for unit,v in t['phan_vi'].items():\n       if 'z' not in v:continue\n       pv+=1;z=v['z'];fields=('med_N','IQR','c','z_len','z_xuong')\n       if not all(isinstance(z.get(k),(int,float)) and math.isfinite(z[k]) for k in fields) or z['IQR']<0 or z['c']<=0:invalid.append(unit)\n       else:\n        oracle+=v.get('oracle',{}).get('z')=='finite_formula_match';fallback+=z['c']==1.0 and z['IQR']<10*sys.float_info.epsilon\n        current=max(z['z_len'],z['z_xuong']);maxz=current if maxz is None else max(current,maxz)\n        if cid==e4id:row['z_distribution'].append(dict(unit=unit,IQR=z['IQR'],c=z['c'],fallback=z['IQR']<10*sys.float_info.epsilon,z_len=z['z_len'],z_xuong=z['z_xuong'],A_extrema=v.get('A_extrema'),n_A=v['n_A'],n_N=v['n_N']))\n       for direction in ('len','xuong'):\n        score=v['e4']['e_'+direction];assert isinstance(score,(int,float)) and math.isfinite(score) and 0<=score<=1\n      for rank in t['xep']:\n       for block in rank['ket_qua']['blocks']:\n        key_count+=1\n        if not all(isinstance(x,(int,float)) and math.isfinite(x) for x in block['key']):invalid.append('ranking_key')\n      check=doi_co_va_tang((er,ed['trace']),(r,t))\n      assert t['normalized_input_sha256']==ed['trace']['normalized_input_sha256']\n      row['variants'][cid]=dict(status=r['status'],PV_units=pv,oracle_finite=oracle,fallback_c1=fallback,max_z=maxz,invalid=invalid,gate_check=check,key_blocks=key_count)\n      totals.update(records=1,PV_units=pv,invalid=len(invalid),gate_exceptions=not check['comparable'])\n      if invalid or not check['comparable'] or r['status'] not in ('OK','NO_EVIDENCE'):exceptions.append(dict(child=child,config=cid,invalid=invalid,gate=check,status=r['status']))\n     # N1/V0 only after the preceding native checks, including no-flag units.\n     row['ce_interpretation']='không phân xử được do cấu tạo phép thử' if all(not v['invalid'] and v['gate_check']['comparable'] for v in row['variants'].values()) else 'Ngoại lệ B2: phần thuần đổi điểm chờ Minh'\n     for cid in row['variants']:\n      r,d=batch[cid];states=d['trace']['world_state'];row['variants'][cid]['worlds']={w:{k:states[w][k] for k in ('N1','V0','valid_units')} for w in WORLDS}\n      if row['ce_interpretation'].startswith('không phân xử'):\n       assert all({k:states[w][k] for k in ('N1','V0','valid_units')}=={k:ed['trace']['world_state'][w][k] for k in ('N1','V0','valid_units')} for w in WORLDS)\n     result['bases'][base]=row\n    output.write(dump(result)+'\\n');output.flush();done.add(child)\n    progress.write(dump(dict(child=child,completed=len(done),total=len(command['plan']['jobs']),elapsed=time.monotonic()-start))+'\\n');progress.flush()\n   if (parent/'kiem.json').exists():\n    closed=read(parent/'kiem.json')\n    if not closed['success']:raise RuntimeError('Nguồn T4b lỗi, giữ B2 đã kiểm')\n   if len(done)<len(command['plan']['jobs']):time.sleep(10)\n (folder/'kiem.json').write_text(dump(dict(closed=True,jobs=len(done),totals=totals,exceptions=exceptions,trace_sha256=sha(folder/'trung-gian.jsonl'),wall_seconds=time.monotonic()-start))+'\\n',encoding='utf-8')\n return dict(jobs=len(done),exceptions=len(exceptions))\n", "controller": "t4b-laptop-001", "no_labels": true, "order": "hash -> finite fields -> flags/validity/tiers -> N1/V0", "reference_hashes": {"r0-laptop-nz-001-000": {"cpu_seconds": 15.703125, "intermediate_sha256": "193f00d4fdfa612b99b466dd069961c75db39afb9938a3fde607e1acefbf6389", "phase1_sha256": "91bfc3b59997af100f2ff78e6e32ad37db33f2f4736a7b24f472eae43404f771", "records": 1, "rss": 338128896, "wall_seconds": 14.485000000044238}, "r0-laptop-n